---
import type { ToolDefinition } from '../registry';

export interface Props {
  currentTool: ToolDefinition;
  relatedTools: ToolDefinition[];
}

const { currentTool, relatedTools } = Astro.props;
---

<section class="my-12 border-t border-gray-200 pt-8" aria-labelledby="related-tools-heading">
  <h2 id="related-tools-heading" class="text-xl sm:text-2xl font-bold text-gray-900 mb-6">
    Related File Converters & Tools
  </h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
    {relatedTools.map((tool) => (
      <a
        href={`/${tool.slug}/`}
        class="block p-4 rounded-lg border border-gray-200 bg-white hover:border-green-500 hover:shadow-sm transition-all group"
      >
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold px-2 py-0.5 rounded bg-gray-100 text-gray-700 uppercase">
            {tool.kind}
          </span>
          <span class="text-green-600 opacity-0 group-hover:opacity-100 transition-opacity text-sm font-semibold">
            &rarr;
          </span>
        </div>
        <h3 class="font-semibold text-gray-900 group-hover:text-green-600 transition-colors text-base mb-1">
          {tool.name}
        </h3>
        <p class="text-xs text-gray-500 line-clamp-2">
          {tool.description}
        </p>
      </a>
    ))}

    {currentTool.from && (
      <a
        href={`/formats/${currentTool.from}/`}
        class="block p-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 hover:border-green-500 transition-all group"
      >
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold px-2 py-0.5 rounded bg-green-100 text-green-800 uppercase">
            Format Guide
          </span>
        </div>
        <h3 class="font-semibold text-gray-900 group-hover:text-green-600 text-base mb-1">
          {currentTool.from.toUpperCase()} Format Guide & Specs
        </h3>
        <p class="text-xs text-gray-500">
          Learn about {currentTool.from.toUpperCase()} file compatibility, compression, and technical specs.
        </p>
      </a>
    )}
  </div>
</section>
