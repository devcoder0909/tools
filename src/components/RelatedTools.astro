---
import { getFormatById, type ToolDefinition } from '../registry';
import { getGuidesForTool } from '../content/guides';

export interface Props {
  currentTool: ToolDefinition;
  relatedTools: ToolDefinition[];
}

const { currentTool, relatedTools } = Astro.props;
const guides = getGuidesForTool(currentTool.slug);
const fromFormat = currentTool.from && currentTool.from !== 'image' && currentTool.from !== 'all'
  ? getFormatById(currentTool.from)
  : undefined;
---

<section class="my-12 border-t border-slate-200/80 pt-8" aria-labelledby="related-tools-heading">
  {guides.length > 0 && <div class="mb-8">
    <h2 class="text-xl font-bold text-slate-900 mb-3">Troubleshooting and practical guidance</h2>
    <ul class="space-y-3">{guides.map(guide => <li><a class="text-emerald-800 underline underline-offset-4" href={`/guides/${guide.slug}/`}>{guide.title}</a></li>)}</ul>
  </div>}
  <div class="mb-5">
    <h2 id="related-tools-heading" class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
      Related File Converters &amp; Tools
    </h2>
    <p class="text-xs sm:text-sm text-slate-500 mt-1">Explore companion client-side tools with identical zero-upload privacy.</p>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
    {relatedTools.map((tool) => (
      <a
        href={`/${tool.slug}/`}
        class="block p-4 rounded-xl border border-slate-200/90 bg-white hover:border-emerald-500/60 hover:shadow-sm transition-all duration-200 group"
      >
        <div class="flex items-center justify-between mb-2">
          <span class="text-2xs font-semibold px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 uppercase group-hover:bg-emerald-50 group-hover:text-emerald-700 transition-colors">
            {tool.kind}
          </span>
          <span class="text-emerald-600 opacity-0 group-hover:opacity-100 transition-opacity text-xs font-semibold flex items-center gap-1">
            <span>Open</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </span>
        </div>
        <h3 class="font-bold text-slate-900 group-hover:text-emerald-600 transition-colors text-sm mb-1">
          {tool.name}
        </h3>
        <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
          {tool.description}
        </p>
      </a>
    ))}

    {fromFormat && (
      <a
        href={`/formats/${fromFormat.id}/`}
        class="block p-4 rounded-xl border border-dashed border-slate-300 bg-slate-50/60 hover:border-emerald-500/60 hover:bg-emerald-50/20 transition-all duration-200 group"
      >
        <div class="flex items-center justify-between mb-2">
          <span class="text-2xs font-semibold px-2 py-0.5 rounded-md bg-emerald-100/70 text-emerald-800 uppercase">
            Format Guide
          </span>
        </div>
        <h3 class="font-bold text-slate-900 group-hover:text-emerald-600 text-sm mb-1 transition-colors">
          {fromFormat.name} Guide &amp; Specs
        </h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Learn about {fromFormat.name} compatibility, compression, and technical specs.
        </p>
      </a>
    )}
  </div>
</section>
