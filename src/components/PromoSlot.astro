---
import { promoConfig } from '../config/promo';

export interface Props {
  slotPosition?: 'postHowTo' | 'footer';
  className?: string;
}

const { slotPosition: _slotPosition = 'postHowTo', className = '' } = Astro.props;
---

{promoConfig.enabled && (
  <aside
    class={`bg-gradient-to-r from-emerald-50/70 to-teal-50/40 border border-emerald-200/80 rounded-2xl p-5 sm:p-6 my-8 shadow-card ${className}`}
    aria-label="Partner Recommendation"
  >
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div class="space-y-1">
        <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-emerald-800 bg-emerald-100 px-2.5 py-0.5 rounded-full">
          {promoConfig.badge}
        </span>
        <h4 class="text-base font-bold text-slate-900">{promoConfig.title}</h4>
        <p class="text-sm text-slate-600">{promoConfig.description}</p>
      </div>
      <a
        href={promoConfig.targetUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-4 py-2 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-xs transition-colors whitespace-nowrap self-start sm:self-auto cursor-pointer"
      >
        {promoConfig.ctaText} &rarr;
      </a>
    </div>
  </aside>
)}
