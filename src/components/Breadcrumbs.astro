---
import { siteConfig } from '../config/site';

export interface BreadcrumbItem {
  name: string;
  href: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const breadcrumbListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: item.href.startsWith('http')
      ? item.href
      : `${siteConfig.url}${item.href.startsWith('/') ? item.href : '/' + item.href}`,
  })),
};
---

<nav aria-label="Breadcrumb" class="mb-4 text-xs font-medium text-slate-500">
  <ol class="flex items-center space-x-1.5 flex-wrap">
    {items.map((item, idx) => (
      <li class="flex items-center">
        {idx > 0 && (
          <svg class="w-3.5 h-3.5 mx-1 text-slate-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        )}
        {idx === items.length - 1 ? (
          <span class="text-slate-900 font-semibold truncate max-w-[200px] sm:max-w-none" aria-current="page">
            {item.name}
          </span>
        ) : (
          <a href={item.href} class="hover:text-emerald-600 transition-colors">
            {item.name}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(breadcrumbListJsonLd)}
/>
