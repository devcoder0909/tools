---
export interface FAQItem {
  q: string;
  a: string;
}

export interface Props {
  items: FAQItem[];
  title?: string;
}

const { items, title = 'Frequently Asked Questions' } = Astro.props;
---

{items && items.length > 0 && (
  <section class="my-10" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="text-xl sm:text-2xl font-bold text-gray-900 mb-6">
      {title}
    </h2>
    <div class="space-y-4">
      {items.map((item) => (
        <details class="group border border-gray-200 rounded-lg p-4 bg-white transition duration-150 ease-in-out open:border-green-300 open:shadow-xs">
          <summary class="flex justify-between items-center font-medium text-gray-900 cursor-pointer list-none select-none">
            <span class="text-base font-semibold">{item.q}</span>
            <span class="text-gray-400 group-open:rotate-180 transition-transform duration-200 text-lg leading-none ml-2">
              ▼
            </span>
          </summary>
          <p class="mt-3 text-sm text-gray-600 leading-relaxed border-t border-gray-100 pt-3">
            {item.a}
          </p>
        </details>
      ))}
    </div>
  </section>
)}
