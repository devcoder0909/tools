---
import { siteConfig } from '../config/site';
import { footerNav } from '../config/nav';
import PromoSlot from './PromoSlot.astro';
---

<footer class="bg-gray-50 border-t border-gray-200 mt-20 pt-12 pb-16" role="contentinfo">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="mb-12">
      <PromoSlot slotPosition="footer" />
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-8 mb-12">
      {footerNav.map((column) => (
        <div>
          <p class="text-xs font-semibold text-gray-700 uppercase tracking-wider mb-4">
            {column.title}
          </p>
          <ul class="space-y-2.5 text-sm text-gray-600">
            {column.items.map((item) => (
              <li>
                <a href={item.href} class="hover:text-green-600 transition-colors">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Authoritative Web Standards & External References -->
    <div class="border-t border-gray-200 pt-8 mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs text-gray-500 gap-4">
        <div>
          <span class="font-semibold text-gray-700">Standards & Specifications:</span>
          <span class="ml-2 inline-flex flex-wrap gap-x-4 gap-y-1">
            <a
              href="https://www.w3.org/TR/html52/"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-green-600 transition-colors"
              title="W3C HTML5 Specification"
            >
              W3C HTML5
            </a>
            <a
              href="https://developer.mozilla.org/en-US/docs/Web/API/File_API"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-green-600 transition-colors"
              title="MDN Web Docs File API Reference"
            >
              MDN File API
            </a>
            <a
              href="https://webassembly.org/"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-green-600 transition-colors"
              title="WebAssembly Official Specifications"
            >
              WebAssembly.org
            </a>
            <a
              href="https://www.rfc-editor.org/rfc/rfc7932"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-green-600 transition-colors"
              title="IETF RFC 7932 Compression Standards"
            >
              IETF RFC 7932
            </a>
            <a
              href="https://www.iso.org/standard/75839.html"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-green-600 transition-colors"
              title="ISO 32000-2 Document Management - Portable Document Format"
            >
              ISO 32000-2
            </a>
          </span>
        </div>
        <div class="flex items-center space-x-4">
          <a
            href="https://github.com/devcoder0909/tools"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center space-x-1.5 hover:text-gray-900 transition-colors font-medium text-gray-600"
            title="Best Converter Open Source GitHub Repository"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            <span>GitHub</span>
          </a>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-200 pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-gray-500 space-y-4 md:space-y-0">
      <p>
        &copy; {new Date().getFullYear()} {siteConfig.company}. All tools operate entirely on your client device. No files are uploaded to any server.
      </p>
      <div class="flex items-center space-x-6">
        <a href="/privacy/" class="hover:underline">Privacy Policy</a>
        <a href="/cookies/" class="hover:underline">Cookie Policy</a>
        <a href="/terms/" class="hover:underline">Terms of Use</a>
        <a href="/contact/" class="hover:underline">Contact</a>
      </div>
    </div>
  </div>
</footer>
