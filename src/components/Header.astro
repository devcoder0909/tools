---
import { siteConfig } from '../config/site';
import { mainNav } from '../config/nav';
---

<header class="border-b border-slate-200/70 bg-white/80 backdrop-blur-xl sticky top-0 z-50 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 hover:opacity-95 transition-opacity" aria-label={`${siteConfig.brand} - Home`}>
      <img
        src="/images/brand/logo.webp"
        alt={siteConfig.brand}
        width="123"
        height="40"
        class="h-9 sm:h-10 w-auto object-contain"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-7 text-sm font-medium text-slate-600" aria-label="Main Navigation">
      {mainNav.map((item) => (
        <a
          href={item.href}
          class="hover:text-emerald-600 transition-colors py-1"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Desktop Right Action -->
    <div class="hidden md:flex items-center space-x-3">
      <a
        href="/tools/"
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-medium bg-slate-100/80 hover:bg-slate-200/60 text-slate-600 hover:text-slate-900 border border-slate-200/60 transition shadow-2xs group"
      >
        <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-emerald-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span>Search</span>
        <kbd class="px-1.5 py-0.5 rounded bg-white text-2xs font-mono font-semibold text-slate-400 border border-slate-200 shadow-2xs">⌘K</kbd>
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <div class="flex items-center md:hidden">
      <button
        id="mobile-menu-btn"
        type="button"
        class="p-2 rounded-xl text-gray-600 hover:text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg id="menu-open-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white px-4 pt-3 pb-5 space-y-1 shadow-lg">
    <div class="pb-2 mb-2 border-b border-gray-100">
      <a
        href="/tools/"
        class="flex items-center justify-between w-full px-3 py-2.5 rounded-xl text-sm font-semibold bg-gray-50 text-gray-800 hover:bg-emerald-50 hover:text-emerald-700 transition"
      >
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Browse All Tools
        </span>
        <span class="text-xs text-gray-400">&rarr;</span>
      </a>
    </div>

    {mainNav.map((item) => (
      <a
        href={item.href}
        class="block px-3 py-2 rounded-xl text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-emerald-600 transition"
      >
        {item.label}
      </a>
    ))}

    <div class="pt-3 mt-2 border-t border-gray-100">
      <a
        href="/privacy-explained/"
        class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-medium text-gray-500 hover:text-emerald-700 transition"
      >
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span>Zero-Upload In-Browser Architecture</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const openIcon = document.getElementById('menu-open-icon');
    const closeIcon = document.getElementById('menu-close-icon');

    if (btn && menu && openIcon && closeIcon) {
      btn.addEventListener('click', () => {
        const isHidden = menu.classList.contains('hidden');
        if (isHidden) {
          menu.classList.remove('hidden');
          openIcon.classList.add('hidden');
          closeIcon.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
        } else {
          menu.classList.add('hidden');
          openIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    }
  })();
</script>
