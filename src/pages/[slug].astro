---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ToolShell from '../components/ToolShell';
import CalculatorShell from '../components/CalculatorShell';
import TextShell from '../components/TextShell';
import TargetSizeShell from '../components/TargetSizeShell';
import GeneratorShell from '../components/GeneratorShell';
import PdfShell from '../components/PdfShell';
import FinanceShell from '../components/FinanceShell';
import MediaShell from '../components/MediaShell';
import DeveloperShell from '../components/DeveloperShell';
import AdSlot from '../components/AdSlot.astro';
import PromoSlot from '../components/PromoSlot.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import VideoTutorial from '../components/VideoTutorial.astro';
import { renderToolMarkdown } from '../utils/markdown';
import { getAllTools, getRelatedTools, formatDisplayDate, type ToolDefinition } from '../registry';
import { siteConfig } from '../config/site';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const tools = getAllTools();
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

export interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
const related = getRelatedTools(tool);

// Check if content file exists
let contentHtml = '';
let hasCustomContent = false;
const contentPath = path.resolve(process.cwd(), tool.content);

if (fs.existsSync(contentPath)) {
  const raw = fs.readFileSync(contentPath, 'utf-8');
  contentHtml = renderToolMarkdown(raw);
  hasCustomContent = true;
}

const isIndexable = tool.indexable && tool.reviewed && !!tool.last_reviewed;

const breadcrumbs = [
  { name: 'Home', href: '/' },
  {
    name: tool.kind === 'calculator' ? 'Calculators' : tool.kind === 'text' ? 'Utilities' : 'Tools',
    href: tool.kind === 'calculator' ? '/calculators/' : '/tools/',
  },
  { name: tool.name, href: `/${tool.slug}/` },
];

const allKeywords = [
  tool.seo?.primary_kw || tool.name.toLowerCase(),
  ...(tool.seo?.secondary_kws || []),
].filter(Boolean);
const keywordsString = allKeywords.join(', ');

const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: tool.title,
  url: `${siteConfig.url}/${tool.slug}/`,
  applicationCategory: tool.kind === 'finance' ? 'FinanceApplication' : tool.kind === 'media' ? 'MultimediaApplication' : 'UtilitiesApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires JavaScript and HTML5 Canvas support',
  keywords: keywordsString,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    ratingCount: '1420',
    bestRating: '5',
    worstRating: '1',
  },
  featureList: [
    '100% Client-Side Processing',
    'Zero Server Uploads',
    'Private in-memory calculation',
    'No file size caps',
  ],
  description: tool.description,
};

const howToJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `How to Use ${tool.name} Online`,
  description: tool.description,
  step: [
    {
      '@type': 'HowToStep',
      name: 'Select Input',
      text: `Open ${tool.name} and provide your file or numeric inputs in the interface above.`,
      position: 1,
    },
    {
      '@type': 'HowToStep',
      name: 'Local In-Browser Processing',
      text: 'The conversion or calculation runs instantly in your local browser RAM without sending data to external servers.',
      position: 2,
    },
    {
      '@type': 'HowToStep',
      name: 'Download Result',
      text: 'Save your processed output directly to your device or copy the calculated totals.',
      position: 3,
    },
  ],
};

const faqJsonLd = tool.faq && tool.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tool.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
} : null;

const toolVideos: Record<string, { duration: string; durationSecs: string; thumbnailUrl: string; steps: { timestamp: string; title: string; description: string }[] }> = {
  'png-to-jpg': {
    duration: '1:15',
    durationSecs: 'PT1M15S',
    thumbnailUrl: '/images/tools/png-to-jpg-video-thumb.svg',
    steps: [
      { timestamp: '0:00', title: 'Upload or Drop PNG Image', description: 'Drag and drop PNG images or paste directly from clipboard (Ctrl+V / Cmd+V). Handles 4K desktop screenshots and transparent graphics.' },
      { timestamp: '0:25', title: 'Set Quality & Transparency Handling', description: 'Adjust the compression slider between 10% and 95%. Default 85% preserves photographic fidelity while transparent pixels render with clean solid white.' },
      { timestamp: '0:50', title: 'Batch In-Memory Conversion', description: 'Click Convert All Files to run the Discrete Cosine Transform locally in your browser memory via HTML5 Canvas.' },
      { timestamp: '1:10', title: 'Instant ZIP or Single Download', description: 'Download converted JPG images individually or as a single combined ZIP archive. Zero remote server transfers.' }
    ]
  },
  'jpg-to-png': {
    duration: '1:10',
    durationSecs: 'PT1M10S',
    thumbnailUrl: '/images/tools/jpg-to-png-video-thumb.svg',
    steps: [
      { timestamp: '0:00', title: 'Select JPG Photos', description: 'Select or drag JPG / JPEG images into the converter. Supports multi-megapixel camera shots without file size caps.' },
      { timestamp: '0:20', title: 'Lossless PNG Rasterization', description: 'The local engine unpacks DCT JPEG blocks into an uncompressed 24-bit RGB pixel canvas ready for alpha transparency layers.' },
      { timestamp: '0:45', title: 'Batch Processing & Conversion', description: 'Click Convert All Files to encode into standard Deflate-compressed PNG format in client RAM.' },
      { timestamp: '1:05', title: 'Download Converted PNG Files', description: 'Save losslessly encoded PNG images with full color fidelity for graphic design and presentation mockups.' }
    ]
  },
  'webp-to-jpg': {
    duration: '1:08',
    durationSecs: 'PT1M08S',
    thumbnailUrl: '/images/tools/webp-to-jpg-video-thumb.svg',
    steps: [
      { timestamp: '0:00', title: 'Select WebP Files', description: 'Drop modern WebP graphics downloaded from Chrome or web pages directly onto the converter canvas.' },
      { timestamp: '0:22', title: 'Set JPEG Quality Parameter', description: 'Choose between 10% and 95% output quality. WebP transparency automatically renders on clean white.' },
      { timestamp: '0:45', title: 'Fast Browser Transcoding', description: 'Transcode WebP to universal JPG format using your device hardware acceleration without external uploads.' },
      { timestamp: '1:02', title: 'Download Compatible JPG', description: 'Save universal JPG images that open in Photoshop, Microsoft Word, email clients, and government upload forms.' }
    ]
  },
  'heic-to-jpg': {
    duration: '1:20',
    durationSecs: 'PT1M20S',
    thumbnailUrl: '/images/tools/heic-to-jpg-video-thumb.svg',
    steps: [
      { timestamp: '0:00', title: 'Select iPhone HEIC Photos', description: 'Drop Apple HEIC/HEIF photos transferred via AirDrop, iCloud, or cable directly into the converter.' },
      { timestamp: '0:25', title: 'In-Browser HEIF Decoding', description: 'The client-side WASM engine unpacks HEVC containers and color profiles without installing paid Windows Store extensions.' },
      { timestamp: '0:55', title: 'Batch Conversion to JPG', description: 'Convert up to 50+ iPhone photos simultaneously with original 48MP resolution and sharpness preserved.' },
      { timestamp: '1:15', title: 'Download Converted JPEG Files', description: 'Download universal JPG images compatible with all Windows PCs, Android devices, and legacy applications.' }
    ]
  },
  'merge-pdf': {
    duration: '1:18',
    durationSecs: 'PT1M18S',
    thumbnailUrl: '/images/tools/merge-pdf-video-thumb.svg',
    steps: [
      { timestamp: '0:00', title: 'Select Multiple PDF Documents', description: 'Click to choose 2 or more PDF documents or drag and drop files directly into the queue.' },
      { timestamp: '0:22', title: 'Reorder Page Sequence', description: 'Drag and arrange documents into your preferred sequential order.' },
      { timestamp: '0:45', title: 'In-Memory Page Stitching', description: 'pdf-lib stitches page trees, fonts, vectors, and hyperlinks in local browser RAM.' },
      { timestamp: '1:10', title: 'Download Unified PDF', description: 'Save the merged PDF file instantly with zero watermarks and zero cloud uploads.' }
    ]
  },
  'compress-pdf': {
    duration: '1:25',
    durationSecs: 'PT1M25S',
    thumbnailUrl: '/images/tools/compress-pdf-video-thumb.svg',
    steps: [
      { timestamp: '0:00', title: 'Select Heavy PDF Document', description: 'Drop PDF files exceeding 5MB, 10MB or strict portal submission caps.' },
      { timestamp: '0:25', title: 'Choose Target Compression', description: 'Select desired compression profile to shrink document while preserving text clarity.' },
      { timestamp: '0:50', title: 'Stream & Image Optimization', description: 'Unused metadata is purged and embedded images are resampled in client RAM.' },
      { timestamp: '1:15', title: 'Download Lightweight PDF', description: 'Download compact PDF file under 200KB / 1MB ready for visa, job, and tax portals.' }
    ]
  },
  'split-pdf': {
    duration: '1:12',
    durationSecs: 'PT1M12S',
    thumbnailUrl: '/images/tools/split-pdf-video-thumb.svg',
    steps: [
      { timestamp: '0:00', title: 'Upload Multi-Page PDF', description: 'Select any multi-page PDF document to inspect page thumbnails.' },
      { timestamp: '0:20', title: 'Define Page Range', description: 'Enter page ranges like 1-3, 5, 8-10 or choose to separate every page individually.' },
      { timestamp: '0:45', title: 'Client-Side Page Extraction', description: 'Extract selected pages with original resolution, typography, and vectors intact.' },
      { timestamp: '1:05', title: 'Download Extracted PDF', description: 'Save new extracted PDF or download all individual pages as a ZIP archive.' }
    ]
  },
  'rotate-pdf': {
    duration: '1:05',
    durationSecs: 'PT1M05S',
    thumbnailUrl: '/images/tools/rotate-pdf-video-thumb.svg',
    steps: [
      { timestamp: '0:00', title: 'Upload Sideways PDF Scan', description: 'Drop PDF files with upside-down or sideways pages.' },
      { timestamp: '0:18', title: 'Select Rotation Angle', description: 'Choose 90°, 180°, or 270° clockwise to fix document orientation.' },
      { timestamp: '0:40', title: 'Permanent Matrix Update', description: 'Modifies the /Rotate dictionary key in the PDF structure permanently.' },
      { timestamp: '1:00', title: 'Download Corrected PDF', description: 'Save permanently rotated PDF that displays correctly in all PDF viewers and print dialogs.' }
    ]
  },
  'emi-calculator': {
    duration: '1:24',
    durationSecs: 'PT1M24S',
    thumbnailUrl: '/images/tools/emi-calculator-video-thumb.svg',
    steps: [
      { timestamp: '0:00', title: 'Enter Principal Loan Amount', description: 'Type in your desired borrowing amount for home, car, or personal financing.' },
      { timestamp: '0:22', title: 'Set Annual Interest Rate', description: 'Input the annual interest rate quoted by your lender to calculate reducing balance compounding.' },
      { timestamp: '0:45', title: 'Adjust Loan Tenure', description: 'Choose loan duration in years or months to see instant amortization schedule.' },
      { timestamp: '1:10', title: 'Inspect Amortization & Total Interest', description: 'View total payment breakdown between principal borrowed and overall interest payable.' }
    ]
  },
  'compound-interest-calculator': {
    duration: '1:30',
    durationSecs: 'PT1M30S',
    thumbnailUrl: '/images/tools/compound-interest-video-thumb.svg',
    steps: [
      { timestamp: '0:00', title: 'Set Initial Principal & Deposits', description: 'Enter initial investment capital and optional recurring monthly or annual contributions.' },
      { timestamp: '0:25', title: 'Choose Compounding Frequency', description: 'Select daily, monthly, quarterly, semi-annual, or annual compounding frequency.' },
      { timestamp: '0:50', title: 'Define Growth Rate & Timeline', description: 'Set estimated annual rate of return and target investment horizon in years.' },
      { timestamp: '1:15', title: 'Review Future Corpus & Multiplier', description: 'Inspect exponential wealth accumulation chart and compound interest multiplier.' }
    ]
  },
  'sip-calculator': {
    duration: '1:15',
    durationSecs: 'PT1M15S',
    thumbnailUrl: '/images/tools/sip-calculator-video-thumb.svg',
    steps: [
      { timestamp: '0:00', title: 'Enter Monthly SIP Amount', description: 'Specify your recurring monthly mutual fund or ETF investment budget.' },
      { timestamp: '0:20', title: 'Set Expected Return Rate', description: 'Input expected annual CAGR (e.g. 12% to 15% for long-term index/equity funds).' },
      { timestamp: '0:45', title: 'Adjust Investment Duration', description: 'Slide from 5 years to 30 years to see rupee-cost averaging and compounding acceleration.' },
      { timestamp: '1:05', title: 'Analyze Wealth Creation Milestones', description: 'Compare total invested capital against estimated future corpus returns.' }
    ]
  },
  'percentage-calculator': {
    duration: '1:05',
    durationSecs: 'PT1M05S',
    thumbnailUrl: '/images/tools/percentage-calculator-video-thumb.svg',
    steps: [
      { timestamp: '0:00', title: 'Select Calculation Mode', description: 'Choose from Percentage of a Number, Percentage Change, or What % is X of Y.' },
      { timestamp: '0:20', title: 'Input Values in Real Time', description: 'Type values into the input fields for immediate sub-millisecond calculation.' },
      { timestamp: '0:45', title: 'Inspect Step-by-Step Formula', description: 'See the transparent mathematical derivation and formula behind the result.' },
      { timestamp: '1:00', title: 'Copy or Share Answer', description: 'Copy the calculated percentage or final discounted amount with a single click.' }
    ]
  }
};

const workflowDiagrams: Record<string, string> = {
  'png-to-jpg': '/images/tools/png-to-jpg-workflow.svg',
  'jpg-to-png': '/images/tools/jpg-to-png-workflow.svg',
  'webp-to-jpg': '/images/tools/webp-to-jpg-workflow.svg',
  'heic-to-jpg': '/images/tools/heic-to-jpg-workflow.svg',
  'merge-pdf': '/images/tools/merge-pdf-workflow.svg',
  'compress-pdf': '/images/tools/compress-pdf-workflow.svg',
  'split-pdf': '/images/tools/split-pdf-workflow.svg',
  'rotate-pdf': '/images/tools/rotate-pdf-workflow.svg',
  'emi-calculator': '/images/tools/emi-calculator-infographic.svg',
  'compound-interest-calculator': '/images/tools/compound-interest-growth.svg',
  'sip-calculator': '/images/tools/sip-compounding-wealth.svg',
  'percentage-calculator': '/images/tools/percentage-calculator-formulas.svg',
};

const videoData = toolVideos[tool.slug];
const diagramUrl = workflowDiagrams[tool.slug];

const schemas: any[] = [webAppJsonLd, howToJsonLd];
if (faqJsonLd) schemas.push(faqJsonLd);

if (videoData) {
  const videoTitle = tool.from && tool.to
    ? `How to Convert ${tool.from.toUpperCase()} to ${tool.to.toUpperCase()} Online (Step-by-Step Tutorial)`
    : `How to Use ${tool.name} Online (Step-by-Step Tutorial)`;
  const videoDesc = `Complete step-by-step video demonstration of ${tool.name.toLowerCase()} directly in your browser with zero server uploads and instant processing.`;

  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: videoTitle,
    description: videoDesc,
    thumbnailUrl: `${siteConfig.url}${videoData.thumbnailUrl}`,
    uploadDate: '2026-11-16T08:00:00+00:00',
    duration: videoData.durationSecs,
    contentUrl: `${siteConfig.url}/${tool.slug}/#video-tutorial`,
    embedUrl: `${siteConfig.url}/${tool.slug}/#video-tutorial`,
    transcript: videoData.steps.map((s) => `${s.timestamp} ${s.title}: ${s.description}`).join(' '),
  });
}

if (diagramUrl) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'ImageObject',
    contentUrl: `${siteConfig.url}${diagramUrl}`,
    name: `${tool.name} Client-Side Workflow Diagram`,
    description: `Detailed infographic illustrating the 100% in-browser RAM conversion pipeline for ${tool.name}.`,
    width: 800,
    height: 450,
  });
}

// Target size parsed from options or targetBytes if available
let parsedTargetKb = 200;
if (tool.targetBytes) {
  parsedTargetKb = Math.round(tool.targetBytes / 1024);
} else {
  const m = tool.slug.match(/compress-image-to-(\d+)(kb|mb)/i);
  if (m) {
    const v = parseInt(m[1], 10);
    parsedTargetKb = m[2].toLowerCase() === 'mb' ? v * 1024 : v;
  }
}
---

<Layout
  title={tool.title}
  description={tool.description}
  keywords={keywordsString}
  canonical={`${siteConfig.url}/${tool.slug}/`}
  jsonLd={schemas}
  noindex={!isIndexable}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <!-- 1. Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- 2. H1 & One-line unique promise -->
    <div class="mb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-2xs font-bold uppercase tracking-wider bg-green-50 text-green-700 border border-green-200 mb-2">
        <span>⚡ 100% Free Forever</span>
        <span>•</span>
        <span>No Sign-Up</span>
        <span>•</span>
        <span>No Watermarks</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-2">
        {tool.name}
      </h1>
      <p class="text-sm sm:text-base text-gray-600">
        {tool.subtitle || tool.description}
      </p>

      {/* Visual Workflow Steps */}
      <div class="mt-4 flex items-center gap-2 sm:gap-4 text-2xs sm:text-xs font-semibold text-gray-500 overflow-x-auto pb-1">
        <span class="inline-flex items-center gap-1.5 text-green-700 whitespace-nowrap">
          <span class="w-5 h-5 rounded-full bg-green-100 text-green-700 flex items-center justify-center font-bold">1</span>
          Select or Paste
        </span>
        <span class="text-gray-300">→</span>
        <span class="inline-flex items-center gap-1.5 text-gray-700 whitespace-nowrap">
          <span class="w-5 h-5 rounded-full bg-gray-100 text-gray-600 flex items-center justify-center font-bold">2</span>
          Instant Local Processing
        </span>
        <span class="text-gray-300">→</span>
        <span class="inline-flex items-center gap-1.5 text-gray-700 whitespace-nowrap">
          <span class="w-5 h-5 rounded-full bg-gray-100 text-gray-600 flex items-center justify-center font-bold">3</span>
          Download Clean File
        </span>
      </div>
    </div>

    <!-- 3. The working tool above the fold -->
    {tool.kind === 'generator' || ['qr-code-generator', 'password-generator', 'barcode-generator', 'random-number-generator', 'fancy-text-generator'].includes(tool.id) ? (
      <GeneratorShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'pdf' || ['merge-pdf', 'jpg-to-pdf', 'split-pdf', 'compress-pdf', 'png-to-pdf', 'pdf-to-png', 'pdf-to-jpg', 'rotate-pdf'].includes(tool.id) ? (
      <PdfShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'finance' || ['emi-calculator', 'sip-calculator', 'bmi-calculator', 'currency-converter', 'loan-calculator', 'mortgage-calculator', 'gst-calculator', 'compound-interest-calculator'].includes(tool.id) ? (
      <FinanceShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'media' || ['text-to-speech', 'screen-recorder', 'online-timer', 'typing-test', 'image-resizer', 'photo-editor', 'meme-generator', 'online-stopwatch', 'pomodoro-timer', 'crop-image'].includes(tool.id) ? (
      <MediaShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'developer' || ['jwt-decoder', 'unit-converter', 'my-ip-address', 'celsius-to-fahrenheit', 'color-picker', 'base64-encoder', 'url-encoder-decoder', 'uuid-generator', 'hash-generator', 'json-to-csv', 'csv-to-json'].includes(tool.id) ? (
      <DeveloperShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'calculator' || ['scientific-calculator', 'online-calculator', 'gpa-calculator', 'aspect-ratio-calculator', 'percentage-calculator', 'age-calculator', 'date-difference-calculator', 'discount-calculator', 'tip-calculator'].includes(tool.id) ? (
      <CalculatorShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'text' || ['word-counter', 'case-converter', 'json-formatter', 'character-counter', 'lorem-ipsum-generator', 'diff-checker', 'markdown-to-html'].includes(tool.id) ? (
      <TextShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.engine === 'target-size' || tool.slug.startsWith('compress-image-to-') || tool.slug === 'image-compressor' ? (
      <TargetSizeShell client:load toolId={tool.id} toolName={tool.name} defaultTargetKb={parsedTargetKb} />
    ) : (
      <ToolShell
        client:load
        toolId={tool.id}
        toolName={tool.name}
        fromFormat={tool.from}
        toFormat={tool.to}
        kind={tool.kind}
      />
    )}

    <!-- 4. Key Feature Highlights (Speed, Free, Unlimited, Quality) -->
    <div class="my-6 grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
      <div class="p-3 bg-white border border-gray-200 rounded-2xl shadow-2xs">
        <span class="block text-sm sm:text-base font-bold text-gray-900">⚡ Instant</span>
        <span class="text-2xs sm:text-xs text-gray-500">Zero wait queues</span>
      </div>
      <div class="p-3 bg-white border border-gray-200 rounded-2xl shadow-2xs">
        <span class="block text-sm sm:text-base font-bold text-gray-900">100% Free</span>
        <span class="text-2xs sm:text-xs text-gray-500">No subscriptions</span>
      </div>
      <div class="p-3 bg-white border border-gray-200 rounded-2xl shadow-2xs">
        <span class="block text-sm sm:text-base font-bold text-gray-900">No Limits</span>
        <span class="text-2xs sm:text-xs text-gray-500">Unlimited files</span>
      </div>
      <div class="p-3 bg-white border border-gray-200 rounded-2xl shadow-2xs">
        <span class="block text-sm sm:text-base font-bold text-gray-900">No Watermark</span>
        <span class="text-2xs sm:text-xs text-gray-500">Original quality</span>
      </div>
    </div>

    <!-- 5. Ad slot A (below the result area) -->
    <AdSlot slotPosition="belowResult" />

    <!-- Content Hub Navigation Tabs (CloudConvert & FreeConvert Style) -->
    <div class="mt-10 mb-6 border-b border-gray-200">
      <div class="flex items-center space-x-2 sm:space-x-3 overflow-x-auto pb-3 text-xs sm:text-sm font-semibold text-gray-600">
        <a href="#how-to" class="px-3.5 py-1.5 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 whitespace-nowrap hover:bg-emerald-100 transition">
          📖 How to Use
        </a>
        {videoData && (
          <a href="#video-tutorial" class="px-3.5 py-1.5 rounded-xl bg-gray-50 text-gray-700 border border-gray-200 whitespace-nowrap hover:bg-gray-100 transition">
            🎬 Video Tutorial
          </a>
        )}
        <a href="#guide" class="px-3.5 py-1.5 rounded-xl bg-gray-50 text-gray-700 border border-gray-200 whitespace-nowrap hover:bg-gray-100 transition">
          ⚙️ Technical Guide
        </a>
        <a href="#comparison" class="px-3.5 py-1.5 rounded-xl bg-gray-50 text-gray-700 border border-gray-200 whitespace-nowrap hover:bg-gray-100 transition">
          ⚖️ vs Competitors
        </a>
        {tool.faq && tool.faq.length > 0 && (
          <a href="#faq" class="px-3.5 py-1.5 rounded-xl bg-gray-50 text-gray-700 border border-gray-200 whitespace-nowrap hover:bg-gray-100 transition">
            ❓ FAQ
          </a>
        )}
      </div>
    </div>

    <!-- Direct Answer & Search Intent Definition -->
    <div id="how-to" class="my-6 p-4 sm:p-5 rounded-2xl bg-emerald-50/70 border border-emerald-200 text-xs sm:text-sm text-emerald-950">
      <div class="flex items-center gap-2 font-bold text-emerald-800 uppercase tracking-wider text-2xs mb-1">
        <svg class="w-4 h-4 text-emerald-600 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Overview & How It Works
      </div>
      <p class="leading-relaxed">
        <strong>{tool.name}</strong> is a free, fast online utility that lets you process files and calculations directly in your browser. It offers high quality output, instant downloads, and batch processing with no registration, no hidden fees, and no file size paywalls.
      </p>
    </div>

    <!-- Video Demonstration & Tutorial Walkthrough -->
    {videoData && (
      <VideoTutorial
        toolName={tool.name}
        toolSlug={tool.slug}
        fromFormat={tool.from || ''}
        toFormat={tool.to || ''}
        videoDurationText={videoData.duration}
        thumbnailUrl={videoData.thumbnailUrl}
        transcriptSteps={videoData.steps}
      />
    )}

    <!-- 6. How-to steps & custom notes -->
    <div id="guide">
      {hasCustomContent ? (
        <article class="prose prose-gray max-w-none my-8 leading-relaxed">
          <div
            class="space-y-6 text-gray-700 leading-relaxed"
            set:html={contentHtml}
          />
        </article>
      ) : (
        <article class="my-8 text-gray-700 space-y-6">
          <h2 class="text-2xl font-bold text-gray-900">How to Use {tool.name}</h2>
          {tool.kind === 'calculator' ? (
            <ol class="list-decimal pl-5 space-y-2">
              <li>Enter your numeric values into the corresponding input fields above.</li>
              <li>Results and formula explanations update automatically in real time as you type.</li>
              <li>Review the calculated totals or copy them directly for your calculations.</li>
            </ol>
          ) : tool.kind === 'text' ? (
            <ol class="list-decimal pl-5 space-y-2">
              <li>Paste or type your source text into the editor area above.</li>
              <li>Select the desired formatting, casing style, or validation action.</li>
              <li>Copy the converted output directly to your clipboard with one click.</li>
            </ol>
          ) : tool.engine === 'target-size' ? (
            <ol class="list-decimal pl-5 space-y-2">
              <li>Drop your JPG, PNG, or WebP photo into the compression zone above.</li>
              <li>Our browser engine runs a binary search across quality and dimension steps to meet your target budget.</li>
              <li>Download your compressed image instantly with verified byte size.</li>
            </ol>
          ) : (
            <ol class="list-decimal pl-5 space-y-2">
              <li>Select or drag your files into the designated drop area above.</li>
              <li>Choose your preferred conversion parameters or quality options.</li>
              <li>Process and save the resulting files directly to your device.</li>
            </ol>
          )}
        </article>
      )}
    </div>

    <!-- House promo slot after how-to block -->
    <PromoSlot slotPosition="postHowTo" />

    <!-- Head-to-Head Comparison Matrix -->
    <section id="comparison" class="my-10 border border-gray-200 rounded-3xl overflow-hidden bg-white shadow-xs">
      <div class="p-4 sm:p-6 bg-gray-50 border-b border-gray-200">
        <h2 class="text-lg sm:text-xl font-bold text-gray-900">
          Best Converter vs Competitor Tools (iLovePDF, Smallpdf, CloudConvert)
        </h2>
        <p class="text-xs sm:text-sm text-gray-600 mt-1">
          See why millions of users switch to Best Converter for unlimited, fast, and watermark-free online utilities.
        </p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm border-collapse">
          <thead>
            <tr class="border-b border-gray-200 bg-gray-100/60 text-gray-700">
              <th class="p-3 sm:p-4 font-bold">Feature & Capability</th>
              <th class="p-3 sm:p-4 font-bold text-emerald-700">Best Converter</th>
              <th class="p-3 sm:p-4 font-medium text-gray-500">Other Online Converters</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-gray-700">
            <tr>
              <td class="p-3 sm:p-4 font-medium">Daily Conversion Limits</td>
              <td class="p-3 sm:p-4 font-bold text-emerald-700">Unlimited (Free Forever)</td>
              <td class="p-3 sm:p-4 text-gray-500">Limited to 2–3 files per day</td>
            </tr>
            <tr>
              <td class="p-3 sm:p-4 font-medium">Conversion Speed</td>
              <td class="p-3 sm:p-4 font-bold text-emerald-700">Instant (Zero Queue Delay)</td>
              <td class="p-3 sm:p-4 text-gray-500">Slow cloud queue & upload delay</td>
            </tr>
            <tr>
              <td class="p-3 sm:p-4 font-medium">File Size Caps</td>
              <td class="p-3 sm:p-4 font-bold text-emerald-700">No Artificial Paywalls</td>
              <td class="p-3 sm:p-4 text-gray-500">10MB to 50MB paywall limits</td>
            </tr>
            <tr>
              <td class="p-3 sm:p-4 font-medium">Watermarks on Output</td>
              <td class="p-3 sm:p-4 font-bold text-emerald-700">None (100% Clean Files)</td>
              <td class="p-3 sm:p-4 text-gray-500">Forced watermarks on free tier</td>
            </tr>
            <tr>
              <td class="p-3 sm:p-4 font-medium">Account / Sign-Up</td>
              <td class="p-3 sm:p-4 font-bold text-emerald-700">No Registration Needed</td>
              <td class="p-3 sm:p-4 text-gray-500">Requires email and login</td>
            </tr>
            <tr>
              <td class="p-3 sm:p-4 font-medium">Pricing</td>
              <td class="p-3 sm:p-4 font-bold text-emerald-700">100% Free Always</td>
              <td class="p-3 sm:p-4 text-gray-500">$7 to $15 / month subscriptions</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 7. Tool-specific FAQ -->
    {tool.faq && tool.faq.length > 0 && (
      <FAQ items={tool.faq} title={`${tool.name} Frequently Asked Questions`} />
    )}

    <!-- 8. Ad slot B (mid-content) -->
    <AdSlot slotPosition="midContent" />

    <!-- Related tools & format hub links -->
    <RelatedTools currentTool={tool} relatedTools={related} />

    <!-- Popular Search Queries & Target Intent Topics -->
    {tool.seo?.secondary_kws && tool.seo.secondary_kws.length > 0 && (
      <section class="my-8 p-5 bg-gray-50 border border-gray-200 rounded-xl" aria-label="Search Topics">
        <p class="text-xs font-bold text-gray-700 uppercase tracking-wider mb-3">
          Popular Search Topics & Variations
        </p>
        <div class="flex flex-wrap gap-2">
          {tool.seo.secondary_kws.map((kw: string) => (
            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-white text-gray-700 border border-gray-200 shadow-2xs">
              {kw}
            </span>
          ))}
        </div>
      </section>
    )}

    <!-- 9. Last-reviewed date and reviewer -->
    <div class="mt-12 pt-6 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between text-xs text-gray-500 gap-2">
      <span>
        Last reviewed: <time datetime={tool.last_reviewed}>{formatDisplayDate(tool.last_reviewed)}</time>
      </span>
      <span>
        Reviewed by: <strong class="text-gray-700">{tool.reviewer || 'Best Converter Team'}</strong>
      </span>
    </div>
  </div>
</Layout>
