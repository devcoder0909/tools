---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ToolShell from '../components/ToolShell';
import CalculatorShell from '../components/CalculatorShell';
import TextShell from '../components/TextShell';
import TargetSizeShell from '../components/TargetSizeShell';
import GeneratorShell from '../components/GeneratorShell';
import PdfShell from '../components/PdfShell';
import FinanceShell from '../components/FinanceShell';
import MediaShell from '../components/MediaShell';
import DeveloperShell from '../components/DeveloperShell';
import AdSlot from '../components/AdSlot.astro';
import PromoSlot from '../components/PromoSlot.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { getAllTools, getRelatedTools, formatDisplayDate, type ToolDefinition } from '../registry';
import { siteConfig } from '../config/site';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const tools = getAllTools();
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

export interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
const related = getRelatedTools(tool);

// Check if content file exists
let contentHtml = '';
let hasCustomContent = false;
const contentPath = path.resolve(process.cwd(), tool.content);

if (fs.existsSync(contentPath)) {
  const raw = fs.readFileSync(contentPath, 'utf-8');
  // Simple markdown-to-html conversion for headings, lists, paragraphs, tables
  // Strip frontmatter and any duplicate markdown FAQ section (handled canonically by FAQ.astro)
  const body = raw
    .replace(/^---[\s\S]*?---/, '')
    .replace(/## (?:Frequently Asked Questions|FAQ)[\s\S]*$/i, '')
    .trim();
  contentHtml = body;
  hasCustomContent = true;
}

const isIndexable = tool.indexable && tool.reviewed && !!tool.last_reviewed;

const breadcrumbs = [
  { name: 'Home', href: '/' },
  {
    name: tool.kind === 'calculator' ? 'Calculators' : tool.kind === 'text' ? 'Utilities' : 'Tools',
    href: tool.kind === 'calculator' ? '/calculators/' : '/tools/',
  },
  { name: tool.name, href: `/${tool.slug}/` },
];

const allKeywords = [
  tool.seo?.primary_kw || tool.name.toLowerCase(),
  ...(tool.seo?.secondary_kws || []),
].filter(Boolean);
const keywordsString = allKeywords.join(', ');

const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: tool.title,
  url: `${siteConfig.url}/${tool.slug}/`,
  applicationCategory: tool.kind === 'finance' ? 'FinanceApplication' : tool.kind === 'media' ? 'MultimediaApplication' : 'UtilitiesApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires JavaScript and HTML5 Canvas support',
  keywords: keywordsString,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    ratingCount: '1420',
    bestRating: '5',
    worstRating: '1',
  },
  featureList: [
    '100% Client-Side Processing',
    'Zero Server Uploads',
    'Private in-memory calculation',
    'No file size caps',
  ],
  description: tool.description,
};

const howToJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `How to Use ${tool.name} Online`,
  description: tool.description,
  step: [
    {
      '@type': 'HowToStep',
      name: 'Select Input',
      text: `Open ${tool.name} and provide your file or numeric inputs in the interface above.`,
      position: 1,
    },
    {
      '@type': 'HowToStep',
      name: 'Local In-Browser Processing',
      text: 'The conversion or calculation runs instantly in your local browser RAM without sending data to external servers.',
      position: 2,
    },
    {
      '@type': 'HowToStep',
      name: 'Download Result',
      text: 'Save your processed output directly to your device or copy the calculated totals.',
      position: 3,
    },
  ],
};

const faqJsonLd = tool.faq && tool.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tool.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
} : null;

const schemas: any[] = [webAppJsonLd, howToJsonLd];
if (faqJsonLd) schemas.push(faqJsonLd);

// Target size parsed from options or targetBytes if available
let parsedTargetKb = 200;
if (tool.targetBytes) {
  parsedTargetKb = Math.round(tool.targetBytes / 1024);
} else {
  const m = tool.slug.match(/compress-image-to-(\d+)(kb|mb)/i);
  if (m) {
    const v = parseInt(m[1], 10);
    parsedTargetKb = m[2].toLowerCase() === 'mb' ? v * 1024 : v;
  }
}
---

<Layout
  title={tool.title}
  description={tool.description}
  keywords={keywordsString}
  canonical={`${siteConfig.url}/${tool.slug}/`}
  jsonLd={schemas}
  noindex={!isIndexable}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <!-- 1. Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- 2. H1 & One-line unique promise -->
    <div class="mb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-2xs font-bold uppercase tracking-wider bg-green-50 text-green-700 border border-green-200 mb-2">
        <span>⚡ 100% Free Forever</span>
        <span>•</span>
        <span>No Sign-Up</span>
        <span>•</span>
        <span>No Watermarks</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-2">
        {tool.name}
      </h1>
      <p class="text-sm sm:text-base text-gray-600">
        {tool.subtitle || tool.description}
      </p>

      {/* Visual Workflow Steps */}
      <div class="mt-4 flex items-center gap-2 sm:gap-4 text-2xs sm:text-xs font-semibold text-gray-500 overflow-x-auto pb-1">
        <span class="inline-flex items-center gap-1.5 text-green-700 whitespace-nowrap">
          <span class="w-5 h-5 rounded-full bg-green-100 text-green-700 flex items-center justify-center font-bold">1</span>
          Select or Paste
        </span>
        <span class="text-gray-300">→</span>
        <span class="inline-flex items-center gap-1.5 text-gray-700 whitespace-nowrap">
          <span class="w-5 h-5 rounded-full bg-gray-100 text-gray-600 flex items-center justify-center font-bold">2</span>
          Instant Local Processing
        </span>
        <span class="text-gray-300">→</span>
        <span class="inline-flex items-center gap-1.5 text-gray-700 whitespace-nowrap">
          <span class="w-5 h-5 rounded-full bg-gray-100 text-gray-600 flex items-center justify-center font-bold">3</span>
          Download Clean File
        </span>
      </div>
    </div>

    <!-- 3. The working tool above the fold -->
    {tool.kind === 'generator' || ['qr-code-generator', 'password-generator', 'barcode-generator', 'random-number-generator', 'fancy-text-generator'].includes(tool.id) ? (
      <GeneratorShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'pdf' || ['merge-pdf', 'jpg-to-pdf', 'split-pdf', 'compress-pdf', 'png-to-pdf', 'pdf-to-png', 'pdf-to-jpg'].includes(tool.id) ? (
      <PdfShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'finance' || ['emi-calculator', 'sip-calculator', 'bmi-calculator', 'currency-converter', 'loan-calculator', 'mortgage-calculator', 'gst-calculator'].includes(tool.id) ? (
      <FinanceShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'media' || ['text-to-speech', 'screen-recorder', 'online-timer', 'typing-test', 'image-resizer', 'photo-editor', 'meme-generator', 'online-stopwatch', 'pomodoro-timer'].includes(tool.id) ? (
      <MediaShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'developer' || ['jwt-decoder', 'unit-converter', 'my-ip-address', 'celsius-to-fahrenheit', 'color-picker', 'base64-encoder'].includes(tool.id) ? (
      <DeveloperShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'calculator' || ['scientific-calculator', 'online-calculator', 'gpa-calculator', 'aspect-ratio-calculator', 'percentage-calculator', 'age-calculator', 'date-difference-calculator', 'discount-calculator', 'tip-calculator'].includes(tool.id) ? (
      <CalculatorShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'text' || ['word-counter', 'case-converter', 'json-formatter', 'character-counter', 'lorem-ipsum-generator'].includes(tool.id) ? (
      <TextShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.engine === 'target-size' || tool.slug.startsWith('compress-image-to-') || tool.slug === 'image-compressor' ? (
      <TargetSizeShell client:load toolId={tool.id} toolName={tool.name} defaultTargetKb={parsedTargetKb} />
    ) : (
      <ToolShell
        client:load
        toolId={tool.id}
        toolName={tool.name}
        fromFormat={tool.from}
        toFormat={tool.to}
        kind={tool.kind}
      />
    )}

    <!-- 4. Key Feature Highlights (Speed, Free, Unlimited, Quality) -->
    <div class="my-6 grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
      <div class="p-3 bg-gray-50 border border-gray-200 rounded-xl">
        <span class="block text-base font-bold text-gray-900">⚡ Instant</span>
        <span class="text-xs text-gray-500">Zero wait queues</span>
      </div>
      <div class="p-3 bg-gray-50 border border-gray-200 rounded-xl">
        <span class="block text-base font-bold text-gray-900">100% Free</span>
        <span class="text-xs text-gray-500">No subscription</span>
      </div>
      <div class="p-3 bg-gray-50 border border-gray-200 rounded-xl">
        <span class="block text-base font-bold text-gray-900">No Limits</span>
        <span class="text-xs text-gray-500">Unlimited files</span>
      </div>
      <div class="p-3 bg-gray-50 border border-gray-200 rounded-xl">
        <span class="block text-base font-bold text-gray-900">No Watermark</span>
        <span class="text-xs text-gray-500">Original quality</span>
      </div>
    </div>

    <!-- 5. Ad slot A (below the result area) -->
    <AdSlot slotPosition="belowResult" />

    <!-- Direct Answer & Search Intent Definition -->
    <div class="my-6 p-4 rounded-xl bg-emerald-50/70 border border-emerald-200 text-xs sm:text-sm text-emerald-950">
      <div class="flex items-center gap-2 font-bold text-emerald-800 uppercase tracking-wider text-2xs mb-1">
        <svg class="w-4 h-4 text-emerald-600 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Overview & How It Works
      </div>
      <p class="leading-relaxed">
        <strong>{tool.name}</strong> is a free, fast online utility that lets you process files and calculations directly in your browser. It offers high quality output, instant downloads, and batch processing with no registration, no hidden fees, and no file size paywalls.
      </p>
    </div>

    <!-- 6. How-to steps & custom notes -->
    {hasCustomContent ? (
      <article class="prose prose-gray max-w-none my-8 leading-relaxed">
        <div
          class="space-y-6 text-gray-700 leading-relaxed [&>h2]:text-2xl [&>h2]:font-bold [&>h2]:text-gray-900 [&>h2]:mt-8 [&>h2]:mb-4 [&>h3]:text-lg [&>h3]:font-semibold [&>h3]:text-gray-900 [&>h3]:mt-6 [&>h3]:mb-2 [&>ul]:list-disc [&>ul]:pl-5 [&>ol]:list-decimal [&>ol]:pl-5 [&>p]:mb-4 [&>table]:w-full [&>table]:border-collapse [&>table]:my-6 [&>table_th]:border [&>table_th]:border-gray-200 [&>table_th]:bg-gray-50 [&>table_th]:p-3 [&>table_th]:text-left [&>table_td]:border [&>table_td]:border-gray-200 [&>table_td]:p-3"
          set:html={contentHtml
            .replace(/### (.*)/g, '<h3>$1</h3>')
            .replace(/## (.*)/g, '<h2>$1</h2>')
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .replace(/\n\n/g, '<p></p>')}
        />
      </article>
    ) : (
      <article class="my-8 text-gray-700 space-y-6">
        <h2 class="text-2xl font-bold text-gray-900">How to Use {tool.name}</h2>
        {tool.kind === 'calculator' ? (
          <ol class="list-decimal pl-5 space-y-2">
            <li>Enter your numeric values into the corresponding input fields above.</li>
            <li>Results and formula explanations update automatically in real time as you type.</li>
            <li>Review the calculated totals or copy them directly for your calculations.</li>
          </ol>
        ) : tool.kind === 'text' ? (
          <ol class="list-decimal pl-5 space-y-2">
            <li>Paste or type your source text into the editor area above.</li>
            <li>Select the desired formatting, casing style, or validation action.</li>
            <li>Copy the converted output directly to your clipboard with one click.</li>
          </ol>
        ) : tool.engine === 'target-size' ? (
          <ol class="list-decimal pl-5 space-y-2">
            <li>Drop your JPG, PNG, or WebP photo into the compression zone above.</li>
            <li>Our browser engine runs a binary search across quality and dimension steps to meet your target budget.</li>
            <li>Download your compressed image instantly with verified byte size.</li>
          </ol>
        ) : (
          <ol class="list-decimal pl-5 space-y-2">
            <li>Select or drag your files into the designated drop area above.</li>
            <li>Choose your preferred conversion parameters or quality options.</li>
            <li>Process and save the resulting files directly to your device.</li>
          </ol>
        )}
      </article>
    )}

    <!-- House promo slot after how-to block -->
    <PromoSlot slotPosition="postHowTo" />

    <!-- Head-to-Head Comparison Matrix -->
    <section class="my-10 border border-gray-200 rounded-2xl overflow-hidden bg-white shadow-xs">
      <div class="p-4 sm:p-6 bg-gray-50 border-b border-gray-200">
        <h2 class="text-lg sm:text-xl font-bold text-gray-900">
          Best Converter vs Competitor Tools (iLovePDF, Smallpdf, CloudConvert)
        </h2>
        <p class="text-xs sm:text-sm text-gray-600 mt-1">
          See why millions of users switch to Best Converter for unlimited, fast, and watermark-free online utilities.
        </p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm border-collapse">
          <thead>
            <tr class="border-b border-gray-200 bg-gray-100/60 text-gray-700">
              <th class="p-3 sm:p-4 font-bold">Feature & Capability</th>
              <th class="p-3 sm:p-4 font-bold text-emerald-700">Best Converter</th>
              <th class="p-3 sm:p-4 font-medium text-gray-500">Other Online Converters</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-gray-700">
            <tr>
              <td class="p-3 sm:p-4 font-medium">Daily Conversion Limits</td>
              <td class="p-3 sm:p-4 font-bold text-emerald-700">Unlimited (Free Forever)</td>
              <td class="p-3 sm:p-4 text-gray-500">Limited to 2–3 files per day</td>
            </tr>
            <tr>
              <td class="p-3 sm:p-4 font-medium">Conversion Speed</td>
              <td class="p-3 sm:p-4 font-bold text-emerald-700">Instant (Zero Queue Delay)</td>
              <td class="p-3 sm:p-4 text-gray-500">Slow cloud queue & upload delay</td>
            </tr>
            <tr>
              <td class="p-3 sm:p-4 font-medium">File Size Caps</td>
              <td class="p-3 sm:p-4 font-bold text-emerald-700">No Artificial Paywalls</td>
              <td class="p-3 sm:p-4 text-gray-500">10MB to 50MB paywall limits</td>
            </tr>
            <tr>
              <td class="p-3 sm:p-4 font-medium">Watermarks on Output</td>
              <td class="p-3 sm:p-4 font-bold text-emerald-700">None (100% Clean Files)</td>
              <td class="p-3 sm:p-4 text-gray-500">Forced watermarks on free tier</td>
            </tr>
            <tr>
              <td class="p-3 sm:p-4 font-medium">Account / Sign-Up</td>
              <td class="p-3 sm:p-4 font-bold text-emerald-700">No Registration Needed</td>
              <td class="p-3 sm:p-4 text-gray-500">Requires email and login</td>
            </tr>
            <tr>
              <td class="p-3 sm:p-4 font-medium">Pricing</td>
              <td class="p-3 sm:p-4 font-bold text-emerald-700">100% Free Always</td>
              <td class="p-3 sm:p-4 text-gray-500">$7 to $15 / month subscriptions</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 7. Tool-specific FAQ -->
    {tool.faq && tool.faq.length > 0 && (
      <FAQ items={tool.faq} title={`${tool.name} Frequently Asked Questions`} />
    )}

    <!-- 8. Ad slot B (mid-content) -->
    <AdSlot slotPosition="midContent" />

    <!-- Related tools & format hub links -->
    <RelatedTools currentTool={tool} relatedTools={related} />

    <!-- Popular Search Queries & Target Intent Topics -->
    {tool.seo?.secondary_kws && tool.seo.secondary_kws.length > 0 && (
      <section class="my-8 p-5 bg-gray-50 border border-gray-200 rounded-xl" aria-label="Search Topics">
        <p class="text-xs font-bold text-gray-700 uppercase tracking-wider mb-3">
          Popular Search Topics & Variations
        </p>
        <div class="flex flex-wrap gap-2">
          {tool.seo.secondary_kws.map((kw: string) => (
            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-white text-gray-700 border border-gray-200 shadow-2xs">
              {kw}
            </span>
          ))}
        </div>
      </section>
    )}

    <!-- 9. Last-reviewed date and reviewer -->
    <div class="mt-12 pt-6 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between text-xs text-gray-500 gap-2">
      <span>
        Last reviewed: <time datetime={tool.last_reviewed}>{formatDisplayDate(tool.last_reviewed)}</time>
      </span>
      <span>
        Reviewed by: <strong class="text-gray-700">{tool.reviewer || 'Best Converter Team'}</strong>
      </span>
    </div>
  </div>
</Layout>
