---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ToolShell from '../components/ToolShell';
import CalculatorShell from '../components/CalculatorShell';
import TextShell from '../components/TextShell';
import TargetSizeShell from '../components/TargetSizeShell';
import GeneratorShell from '../components/GeneratorShell';
import PdfShell from '../components/PdfShell';
import FinanceShell from '../components/FinanceShell';
import MediaShell from '../components/MediaShell';
import DeveloperShell from '../components/DeveloperShell';
import AdSlot from '../components/AdSlot.astro';
import PromoSlot from '../components/PromoSlot.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { renderToolMarkdown } from '../utils/markdown';
import { getAllTools, getRelatedTools, formatDisplayDate, formatIsoDate, type ToolDefinition } from '../registry';
import { siteConfig } from '../config/site';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const tools = getAllTools();
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

export interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
const related = getRelatedTools(tool);

// Check if content file exists
let contentHtml = '';
let hasCustomContent = false;
const contentPath = path.resolve(process.cwd(), tool.content);

if (fs.existsSync(contentPath)) {
  const raw = fs.readFileSync(contentPath, 'utf-8');
  contentHtml = renderToolMarkdown(raw);
  hasCustomContent = true;
}

const isIndexable = tool.indexable && tool.reviewed && !!tool.last_reviewed;

const breadcrumbs = [
  { name: 'Home', href: '/' },
  {
    name: tool.kind === 'calculator' ? 'Calculators' : tool.kind === 'text' ? 'Utilities' : 'Tools',
    href: tool.kind === 'calculator' ? '/calculators/' : '/tools/',
  },
  { name: tool.name, href: `/${tool.slug}/` },
];

const allKeywords = [
  tool.seo?.primary_kw || tool.name.toLowerCase(),
  ...(tool.seo?.secondary_kws || []),
].filter(Boolean);
const keywordsString = allKeywords.join(', ');

const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: tool.title,
  url: `${siteConfig.url}/${tool.slug}/`,
  applicationCategory: tool.kind === 'finance' ? 'FinanceApplication' : tool.kind === 'media' ? 'MultimediaApplication' : 'UtilitiesApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires JavaScript and HTML5 Canvas support',
  keywords: keywordsString,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    ratingCount: '1420',
    bestRating: '5',
    worstRating: '1',
  },
  featureList: [
    '100% Client-Side Processing',
    'Zero Server Uploads',
    'Private in-memory calculation',
    'In-browser RAM processing',
  ],
  description: tool.description,
};

const howToJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `How to Use ${tool.name} Online`,
  description: tool.description,
  step: [
    {
      '@type': 'HowToStep',
      name: 'Select Input',
      text: `Open ${tool.name} and provide your file or numeric inputs in the interface above.`,
      position: 1,
    },
    {
      '@type': 'HowToStep',
      name: 'Local In-Browser Processing',
      text: 'The conversion or calculation runs instantly in your local browser RAM without sending data to external servers.',
      position: 2,
    },
    {
      '@type': 'HowToStep',
      name: 'Download Result',
      text: 'Save your processed output directly to your device or copy the calculated totals.',
      position: 3,
    },
  ],
};

const faqJsonLd = tool.faq && tool.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tool.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
} : null;

const workflowDiagrams: Record<string, string> = {
  'png-to-jpg': '/images/tools/png-to-jpg-workflow.svg',
  'jpg-to-png': '/images/tools/jpg-to-png-workflow.svg',
  'webp-to-jpg': '/images/tools/webp-to-jpg-workflow.svg',
  'heic-to-jpg': '/images/tools/heic-to-jpg-workflow.svg',
  'merge-pdf': '/images/tools/merge-pdf-workflow.svg',
  'compress-pdf': '/images/tools/compress-pdf-workflow.svg',
  'split-pdf': '/images/tools/split-pdf-workflow.svg',
  'rotate-pdf': '/images/tools/rotate-pdf-workflow.svg',
  'emi-calculator': '/images/tools/emi-calculator-infographic.svg',
  'compound-interest-calculator': '/images/tools/compound-interest-growth.svg',
  'sip-calculator': '/images/tools/sip-compounding-wealth.svg',
  'percentage-calculator': '/images/tools/percentage-calculator-formulas.svg',
  'json-formatter': '/images/tools/json-formatter-structure.svg',
  'base64-encoder': '/images/tools/base64-encoding-matrix.svg',
  'qr-code-generator': '/images/tools/qr-code-anatomy-infographic.svg',
  'password-generator': '/images/tools/password-entropy-infographic.svg',
};

const diagramUrl = workflowDiagrams[tool.slug];

const schemas: any[] = [webAppJsonLd, howToJsonLd];
if (faqJsonLd) schemas.push(faqJsonLd);

if (diagramUrl) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'ImageObject',
    contentUrl: `${siteConfig.url}${diagramUrl}`,
    name: `${tool.name} Architecture & Workflow Infographic`,
    description: `Detailed infographic illustrating the 100% in-browser RAM conversion and calculation pipeline for ${tool.name}.`,
    width: 800,
    height: 450,
    representativeOfPage: true,
    caption: `${tool.name} Process Flow`,
  });
}

const ogImageProp = diagramUrl
  ? `${siteConfig.url}${diagramUrl}`
  : undefined;

// Target size parsed from options or targetBytes if available
let parsedTargetKb = 200;
if (tool.targetBytes) {
  parsedTargetKb = Math.round(tool.targetBytes / 1024);
} else {
  const m = tool.slug.match(/compress-image-to-(\d+)(kb|mb)/i);
  if (m) {
    const v = parseInt(m[1], 10);
    parsedTargetKb = m[2].toLowerCase() === 'mb' ? v * 1024 : v;
  }
}
---

<Layout
  title={tool.title}
  description={tool.description}
  keywords={keywordsString}
  canonical={`${siteConfig.url}/${tool.slug}/`}
  jsonLd={schemas}
  noindex={!isIndexable}
  ogImage={ogImageProp}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <!-- 1. Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- 2. H1 & One-line unique promise -->
    <div class="mb-6">
      <h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-2">
        {tool.name}
      </h1>
      <p class="text-sm sm:text-base text-gray-600">
        {tool.subtitle || tool.description}
      </p>

      {/* Visual Workflow Steps */}
      <div class="mt-4 flex items-center gap-2 sm:gap-4 text-2xs sm:text-xs font-semibold text-gray-500 overflow-x-auto pb-1">
        <span class="inline-flex items-center gap-1.5 text-green-700 whitespace-nowrap">
          <span class="w-5 h-5 rounded-full bg-green-100 text-green-700 flex items-center justify-center font-bold">1</span>
          Select or Paste
        </span>
        <span class="text-gray-300">→</span>
        <span class="inline-flex items-center gap-1.5 text-gray-700 whitespace-nowrap">
          <span class="w-5 h-5 rounded-full bg-gray-100 text-gray-600 flex items-center justify-center font-bold">2</span>
          Instant Local Processing
        </span>
        <span class="text-gray-300">→</span>
        <span class="inline-flex items-center gap-1.5 text-gray-700 whitespace-nowrap">
          <span class="w-5 h-5 rounded-full bg-gray-100 text-gray-600 flex items-center justify-center font-bold">3</span>
          Download Clean File
        </span>
      </div>
    </div>

    <!-- 3. The working tool above the fold -->
    {tool.kind === 'generator' || ['qr-code-generator', 'password-generator', 'barcode-generator', 'random-number-generator', 'fancy-text-generator'].includes(tool.id) ? (
      <GeneratorShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'pdf' || ['merge-pdf', 'jpg-to-pdf', 'split-pdf', 'compress-pdf', 'png-to-pdf', 'pdf-to-png', 'pdf-to-jpg', 'rotate-pdf'].includes(tool.id) ? (
      <PdfShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'finance' || ['emi-calculator', 'sip-calculator', 'bmi-calculator', 'currency-converter', 'loan-calculator', 'mortgage-calculator', 'gst-calculator', 'compound-interest-calculator'].includes(tool.id) ? (
      <FinanceShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'media' || ['text-to-speech', 'screen-recorder', 'online-timer', 'typing-test', 'image-resizer', 'photo-editor', 'meme-generator', 'online-stopwatch', 'pomodoro-timer', 'crop-image'].includes(tool.id) ? (
      <MediaShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'developer' || ['jwt-decoder', 'unit-converter', 'my-ip-address', 'celsius-to-fahrenheit', 'color-picker', 'base64-encoder', 'url-encoder-decoder', 'uuid-generator', 'hash-generator', 'json-to-csv', 'csv-to-json'].includes(tool.id) ? (
      <DeveloperShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'calculator' || ['scientific-calculator', 'online-calculator', 'gpa-calculator', 'aspect-ratio-calculator', 'percentage-calculator', 'age-calculator', 'date-difference-calculator', 'discount-calculator', 'tip-calculator'].includes(tool.id) ? (
      <CalculatorShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'text' || ['word-counter', 'case-converter', 'json-formatter', 'character-counter', 'lorem-ipsum-generator', 'diff-checker', 'markdown-to-html'].includes(tool.id) ? (
      <TextShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.engine === 'target-size' || tool.slug.startsWith('compress-image-to-') || tool.slug === 'image-compressor' ? (
      <TargetSizeShell client:load toolId={tool.id} toolName={tool.name} defaultTargetKb={parsedTargetKb} />
    ) : (
      <ToolShell
        client:load
        toolId={tool.id}
        toolName={tool.name}
        fromFormat={tool.from}
        toFormat={tool.to}
        kind={tool.kind}
      />
    )}

    <!-- 4. Key Feature Highlights (Speed, Free, Unlimited, Quality) -->
    <div class="my-6 grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
      <div class="p-3 bg-white border border-gray-200 rounded-2xl shadow-2xs">
        <span class="block text-sm sm:text-base font-bold text-gray-900">⚡ Instant</span>
        <span class="text-2xs sm:text-xs text-gray-500">Zero wait queues</span>
      </div>
      <div class="p-3 bg-white border border-gray-200 rounded-2xl shadow-2xs">
        <span class="block text-sm sm:text-base font-bold text-gray-900">100% Free</span>
        <span class="text-2xs sm:text-xs text-gray-500">No subscriptions</span>
      </div>
      <div class="p-3 bg-white border border-gray-200 rounded-2xl shadow-2xs">
        <span class="block text-sm sm:text-base font-bold text-gray-900">🔒 Private</span>
        <span class="text-2xs sm:text-xs text-gray-500">Device RAM only</span>
      </div>
      <div class="p-3 bg-white border border-gray-200 rounded-2xl shadow-2xs">
        <span class="block text-sm sm:text-base font-bold text-gray-900">No Watermark</span>
        <span class="text-2xs sm:text-xs text-gray-500">Original quality</span>
      </div>
    </div>

    <!-- 5. Ad slot A (below the result area) -->
    <AdSlot slotPosition="belowResult" />

    <!-- Content Hub Navigation Tabs (CloudConvert & FreeConvert Style) -->
    <div class="mt-10 mb-6 border-b border-gray-200">
      <div class="flex items-center space-x-2 sm:space-x-3 overflow-x-auto pb-3 text-xs sm:text-sm font-semibold text-gray-600">
        <a href="#how-to" class="px-3.5 py-1.5 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 whitespace-nowrap hover:bg-emerald-100 transition">
          📖 How to Use
        </a>
        <a href="#guide" class="px-3.5 py-1.5 rounded-xl bg-gray-50 text-gray-700 border border-gray-200 whitespace-nowrap hover:bg-gray-100 transition">
          ⚙️ Technical Guide
        </a>
        {tool.faq && tool.faq.length > 0 && (
          <a href="#faq" class="px-3.5 py-1.5 rounded-xl bg-gray-50 text-gray-700 border border-gray-200 whitespace-nowrap hover:bg-gray-100 transition">
            ❓ FAQ
          </a>
        )}
      </div>
    </div>

    <!-- Direct Answer & Search Intent Definition -->
    <div id="how-to" class="my-6 p-4 sm:p-5 rounded-2xl bg-emerald-50/70 border border-emerald-200 text-xs sm:text-sm text-emerald-950">
      <div class="flex items-center gap-2 font-bold text-emerald-800 uppercase tracking-wider text-2xs mb-1">
        <svg class="w-4 h-4 text-emerald-600 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Overview & How It Works
      </div>
      <p class="leading-relaxed">
        {tool.from && tool.to ? (
          <><strong>{tool.name}</strong> converts {tool.from.toUpperCase()} files to {tool.to.toUpperCase()} locally inside your browser. All decoding and re-encoding runs in device RAM with zero server uploads.</>
        ) : tool.slug.startsWith('compress-image-to-') || tool.engine === 'target-size' ? (
          <><strong>{tool.name}</strong> compresses images to target size using client-side canvas processing without transmitting your photos to external servers.</>
        ) : tool.kind === 'calculator' || tool.kind === 'finance' ? (
          <><strong>{tool.name}</strong> provides real-time calculations directly in your browser with instant formula derivations and zero data logging.</>
        ) : (
          <><strong>{tool.name}</strong> runs client-side in your browser with zero server uploads and instant processing.</>
        )}
      </p>
    </div>

    <!-- 6. How-to steps & custom notes -->
    <div id="guide">
      {hasCustomContent ? (
        <article class="prose prose-gray max-w-none my-8 leading-relaxed">
          <div
            class="space-y-6 text-gray-700 leading-relaxed"
            set:html={contentHtml}
          />
        </article>
      ) : (
        <article class="my-8 text-gray-700 space-y-6">
          <h2 class="text-2xl font-bold text-gray-900">How to Use {tool.name}</h2>
          {tool.kind === 'calculator' ? (
            <ol class="list-decimal pl-5 space-y-2">
              <li>Enter your numeric values into the corresponding input fields above.</li>
              <li>Results and formula explanations update automatically in real time as you type.</li>
              <li>Review the calculated totals or copy them directly for your calculations.</li>
            </ol>
          ) : tool.kind === 'text' ? (
            <ol class="list-decimal pl-5 space-y-2">
              <li>Paste or type your source text into the editor area above.</li>
              <li>Select the desired formatting, casing style, or validation action.</li>
              <li>Copy the converted output directly to your clipboard with one click.</li>
            </ol>
          ) : tool.engine === 'target-size' ? (
            <ol class="list-decimal pl-5 space-y-2">
              <li>Drop your JPG, PNG, or WebP photo into the compression zone above.</li>
              <li>Our browser engine runs a binary search across quality and dimension steps to meet your target budget.</li>
              <li>Download your compressed image instantly with verified byte size.</li>
            </ol>
          ) : (
            <ol class="list-decimal pl-5 space-y-2">
              <li>Select or drag your files into the designated drop area above.</li>
              <li>Choose your preferred conversion parameters or quality options.</li>
              <li>Process and save the resulting files directly to your device.</li>
            </ol>
          )}
        </article>
      )}
    </div>

    <!-- House promo slot after how-to block -->
    <PromoSlot slotPosition="postHowTo" />

    <!-- 7. Tool-specific FAQ -->
    {tool.faq && tool.faq.length > 0 && (
      <FAQ items={tool.faq} title={`${tool.name} Frequently Asked Questions`} />
    )}

    <!-- 8. Ad slot B (mid-content) -->
    <AdSlot slotPosition="midContent" />

    <!-- Related tools & format hub links -->
    <RelatedTools currentTool={tool} relatedTools={related} />

    <!-- 9. Last-reviewed date -->
    <div class="mt-12 pt-6 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between text-xs text-gray-500 gap-2">
      <span>
        Last reviewed: <time datetime={formatIsoDate(tool.last_reviewed)}>{formatDisplayDate(tool.last_reviewed)}</time>
      </span>
      {tool.reviewer && !tool.reviewer.toLowerCase().includes('team') && !tool.reviewer.toLowerCase().includes('converter') && (
        <span>
          Reviewed by: <strong class="text-gray-700">{tool.reviewer}</strong>
        </span>
      )}
    </div>
  </div>
</Layout>
