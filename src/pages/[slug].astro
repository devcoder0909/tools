---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ToolShell from '../components/ToolShell';
import CalculatorShell from '../components/CalculatorShell';
import TextShell from '../components/TextShell';
import TargetSizeShell from '../components/TargetSizeShell';
import GeneratorShell from '../components/GeneratorShell';
import PdfShell from '../components/PdfShell';
import FinanceShell from '../components/FinanceShell';
import MediaShell from '../components/MediaShell';
import ImageToText from '../components/ImageToText';
import QRScanner from '../components/QRScanner';
import PdfExport from '../components/PdfExport';
import VideoCompressor from '../components/VideoCompressor';
import Gta6SpecsCalculator from '../components/Gta6SpecsCalculator';
import Gta6Countdown from '../components/Gta6Countdown';
import WhatsAppMediaSaver from '../components/WhatsAppMediaSaver';
import DeveloperShell from '../components/DeveloperShell';
import BackgroundRemoverShell from '../components/BackgroundRemoverShell';
import AdSlot from '../components/AdSlot.astro';
import PromoSlot from '../components/PromoSlot.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolExamples } from '../content/tool-examples';
import { renderToolMarkdown } from '../utils/markdown';
import { getAllTools, getRelatedTools, formatDisplayDate, formatIsoDate, type ToolDefinition } from '../registry';
import { siteConfig } from '../config/site';
import { getToolMedia } from '../config/tool-media';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const tools = getAllTools();
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

export interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
const related = getRelatedTools(tool);
const example = toolExamples[tool.slug];
const toolMedia = getToolMedia(tool.slug);

// Check if content file exists
let contentHtml = '';
let hasCustomContent = false;
const contentPath = path.resolve(process.cwd(), tool.content);

if (fs.existsSync(contentPath)) {
  const raw = fs.readFileSync(contentPath, 'utf-8');
  contentHtml = renderToolMarkdown(raw, tool.name);
  hasCustomContent = true;
}

const isIndexable = tool.indexable && tool.reviewed && !!tool.last_reviewed;

const breadcrumbs = [
  { name: 'Home', href: '/' },
  {
    name: tool.kind === 'calculator' ? 'Calculators' : tool.kind === 'text' ? 'Utilities' : 'Tools',
    href: tool.kind === 'calculator' ? '/calculators/' : '/tools/',
  },
  { name: tool.name, href: `/${tool.slug}/` },
];

const allKeywords = [
  tool.seo?.primary_kw || tool.name.toLowerCase(),
  ...(tool.seo?.secondary_kws || []),
].filter(Boolean);
const keywordsString = allKeywords.join(', ');

const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `${siteConfig.url}/${tool.slug}/#application`,
  name: tool.name,
  url: `${siteConfig.url}/${tool.slug}/`,
  applicationCategory: tool.kind === 'finance' ? 'FinanceApplication' : tool.kind === 'media' ? 'MultimediaApplication' : 'UtilitiesApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires a modern browser with JavaScript enabled',
  isAccessibleForFree: true,
  inLanguage: tool.lang || 'en',
  keywords: keywordsString,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  description: tool.description,
};

const faqJsonLd = tool.faq && tool.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tool.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
} : null;

const workflowDiagrams: Record<string, string> = {
  'background-remover': '/images/tools/background-remover-workflow.svg',
  'dpi-calculator': '/images/tools/dpi-calculator-workflow.svg',
  'png-to-jpg': '/images/tools/png-to-jpg-workflow.svg',
  'jpg-to-png': '/images/tools/jpg-to-png-workflow.svg',
  'webp-to-jpg': '/images/tools/webp-to-jpg-workflow.svg',
  'heic-to-jpg': '/images/tools/heic-to-jpg-workflow.svg',
  'merge-pdf': '/images/tools/merge-pdf-workflow.svg',
  'compress-pdf': '/images/tools/compress-pdf-workflow.svg',
  'split-pdf': '/images/tools/split-pdf-workflow.svg',
  'rotate-pdf': '/images/tools/rotate-pdf-workflow.svg',
  'emi-calculator': '/images/tools/emi-calculator-infographic.svg',
  'compound-interest-calculator': '/images/tools/compound-interest-growth.svg',
  'sip-calculator': '/images/tools/sip-compounding-wealth.svg',
  'percentage-calculator': '/images/tools/percentage-calculator-formulas.svg',
  'json-formatter': '/images/tools/json-formatter-structure.svg',
  'base64-encoder': '/images/tools/base64-encoding-matrix.svg',
  'qr-code-generator': '/images/tools/qr-code-anatomy-infographic.svg',
  'password-generator': '/images/tools/password-entropy-infographic.svg',
};

const diagramUrl = toolMedia?.diagramUrl || workflowDiagrams[tool.slug];

const schemas: any[] = isIndexable ? [webAppJsonLd] : [];
if (faqJsonLd && isIndexable) schemas.push(faqJsonLd);

if (diagramUrl && isIndexable) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'ImageObject',
    contentUrl: `${siteConfig.url}${diagramUrl}`,
    name: `${tool.name} Architecture & Workflow Infographic`,
    description: `Detailed infographic illustrating the processing and calculation workflow for ${tool.name}.`,
    width: 800,
    height: 450,
    representativeOfPage: true,
    caption: `${tool.name} Process Flow`,
  });
}

const ogImageProp = diagramUrl
  ? `${siteConfig.url}${diagramUrl}`
  : undefined;

// Target size parsed from options or targetBytes if available
let parsedTargetKb = 200;
if (tool.targetBytes) {
  parsedTargetKb = Math.round(tool.targetBytes / 1024);
} else {
  const m = tool.slug.match(/compress-image-to-(\d+)(kb|mb)/i);
  if (m) {
    const v = parseInt(m[1], 10);
    parsedTargetKb = m[2].toLowerCase() === 'mb' ? v * 1024 : v;
  }
}
---

<Layout
  title={tool.title}
  description={tool.description}
  canonical={`${siteConfig.url}/${tool.slug}/`}
  jsonLd={schemas}
  noindex={!isIndexable}
  ogImage={ogImageProp}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    {tool.slug === 'pdf-to-jpg' && <p class="mb-6 p-4 border border-amber-300 rounded-xl bg-amber-50 text-amber-950">
      This tool is not ready for PDF page conversion. The current output is a placeholder image, not a rendering of your document. Please keep your original PDF.
    </p>}
    {tool.slug === 'heic-to-pdf' && <p class="mb-6 p-4 border border-amber-300 rounded-xl bg-amber-50 text-amber-950">
      HEIC-to-PDF conversion is not ready. The current download is not a valid PDF. Keep the original image and use a supported JPG or PNG source with the image-to-PDF tools.
    </p>}
    <!-- 1. Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- 2. H1 & One-line unique promise -->
    <div class="mb-6">
      <div class="flex items-center gap-2 mb-2.5 flex-wrap">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md text-2xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/60 uppercase tracking-wide">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          {tool.kind === 'calculator' ? 'Calculator' : tool.kind === 'finance' ? 'Financial Tool' : tool.kind === 'pdf' ? 'PDF Utility' : 'Online Utility'}
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight mb-2">
        {tool.name}
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-2xl">
        {tool.subtitle || tool.description}
      </p>
    </div>

    <!-- 3. The working tool above the fold -->
    {tool.id === 'gta-6-pc-specs-calculator' ? (
      <Gta6SpecsCalculator client:load />
    ) : tool.id === 'gta-6-release-countdown' ? (
      <Gta6Countdown client:load />
    ) : ['pdf-to-text', 'pdf-to-word'].includes(tool.id) ? (
      <PdfExport client:load word={tool.id === 'pdf-to-word'} />
    ) : tool.id === 'video-compressor' ? (
      <VideoCompressor client:load />
    ) : tool.id === 'qr-code-scanner' ? (
      <QRScanner client:load />
    ) : tool.id === 'image-to-text' ? (
      <ImageToText client:load />
    ) : tool.id === 'whatsapp-dp-status-downloader' ? (
      <WhatsAppMediaSaver client:load />
    ) : tool.id === 'background-remover' ? (
      <BackgroundRemoverShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'generator' || ['qr-code-generator', 'password-generator', 'barcode-generator', 'random-number-generator', 'fancy-text-generator'].includes(tool.id) ? (
      <GeneratorShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'pdf' || ['merge-pdf', 'jpg-to-pdf', 'png-to-pdf', 'images-to-pdf', 'split-pdf', 'compress-pdf', 'pdf-to-png', 'pdf-to-jpg', 'rotate-pdf'].includes(tool.id) ? (
      <PdfShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'finance' || ['emi-calculator', 'sip-calculator', 'bmi-calculator', 'currency-converter', 'loan-calculator', 'mortgage-calculator', 'gst-calculator', 'compound-interest-calculator'].includes(tool.id) ? (
      <FinanceShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'media' || ['text-to-speech', 'screen-recorder', 'online-timer', 'typing-test', 'image-resizer', 'photo-editor', 'meme-generator', 'online-stopwatch', 'pomodoro-timer', 'crop-image'].includes(tool.id) ? (
      <MediaShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'developer' || ['jwt-decoder', 'unit-converter', 'my-ip-address', 'celsius-to-fahrenheit', 'color-picker', 'base64-encoder', 'url-encoder-decoder', 'uuid-generator', 'hash-generator', 'json-to-csv', 'csv-to-json'].includes(tool.id) ? (
      <DeveloperShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'calculator' || ['scientific-calculator', 'online-calculator', 'gpa-calculator', 'aspect-ratio-calculator', 'percentage-calculator', 'age-calculator', 'date-difference-calculator', 'discount-calculator', 'tip-calculator', 'dpi-calculator'].includes(tool.id) ? (
      <CalculatorShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.kind === 'text' || ['word-counter', 'case-converter', 'json-formatter', 'character-counter', 'lorem-ipsum-generator', 'diff-checker', 'markdown-to-html', 'reading-time-calculator'].includes(tool.id) ? (
      <TextShell client:load toolId={tool.id} toolName={tool.name} />
    ) : tool.engine === 'target-size' || tool.slug.startsWith('compress-image-to-') || tool.slug === 'image-compressor' ? (
      <TargetSizeShell client:load toolId={tool.id} toolName={tool.name} defaultTargetKb={parsedTargetKb} />
    ) : (
      <ToolShell
        client:load
        toolId={tool.id}
        toolName={tool.name}
        fromFormat={tool.from}
        toFormat={tool.to}
        kind={tool.kind}
      />
    )}

    <!-- Ad slot A (below the result area) -->
    <AdSlot slotPosition="belowResult" />

    <!-- Content Hub Navigation Tabs -->
    <div class="mt-10 mb-6 border-b border-slate-200">
      <div class="flex items-center space-x-2 sm:space-x-3 overflow-x-auto pb-3 text-xs sm:text-sm font-semibold text-slate-600">
        <a href="#guide" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-white text-slate-700 border border-slate-200 whitespace-nowrap hover:bg-slate-50 transition">
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>How to use this tool</span>
        </a>
        {tool.faq && tool.faq.length > 0 && (
          <a href="#faq" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-white text-slate-700 border border-slate-200 whitespace-nowrap hover:bg-slate-50 transition">
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>FAQ</span>
          </a>
        )}
      </div>
    </div>

    <!-- Editorial Content Section (Semantic Article for Full Intent Fulfillment) -->
    <article class="editorial-content my-8 space-y-8">
      {example && <section id="how-to" class="my-8 max-w-3xl">
        <h2 class="text-xl font-bold text-slate-900 mb-2">{example.heading}</h2>
        <p class="leading-relaxed text-slate-700">{example.text}</p>
      </section>}

      {toolMedia && (
        <figure class="my-6 p-5 sm:p-6 rounded-2xl bg-white border border-slate-200/90 shadow-card text-center">
          <img
            src={toolMedia.diagramUrl}
            alt={`${tool.name} — ${tool.seo?.primary_kw || tool.name.toLowerCase()} architecture and processing workflow diagram`}
            width="720"
            height="360"
            class="max-w-full h-auto mx-auto rounded-xl border border-slate-100"
            loading="lazy"
          />
          <figcaption class="mt-3 text-xs text-slate-500 font-medium">
            <strong class="text-slate-700">Architecture Overview:</strong> {toolMedia.diagramCaption}
          </figcaption>
        </figure>
      )}

      <!-- 6. How-to steps & custom notes -->
      <div id="guide" class="prose prose-slate max-w-none leading-relaxed">
        {hasCustomContent ? (
          <div
            class="space-y-6 text-slate-700 leading-relaxed"
            set:html={contentHtml}
          />
        ) : (
          <div class="my-8 text-slate-700 space-y-6">
            <h2 class="text-2xl font-bold text-slate-900">How to Use {tool.name}</h2>
            {tool.kind === 'calculator' ? (
              <ol class="list-decimal pl-5 space-y-2">
                <li>Enter your numeric values into the corresponding input fields above.</li>
                <li>Results and formula explanations update automatically in real time as you type.</li>
                <li>Review the calculated totals or copy them directly for your calculations.</li>
              </ol>
            ) : tool.kind === 'text' ? (
              <ol class="list-decimal pl-5 space-y-2">
                <li>Paste or type your source text into the editor area above.</li>
                <li>Select the desired formatting, casing style, or validation action.</li>
                <li>Copy the converted output directly to your clipboard with one click.</li>
              </ol>
            ) : tool.engine === 'target-size' ? (
              <ol class="list-decimal pl-5 space-y-2">
                <li>Drop your JPG, PNG, or WebP photo into the compression zone above.</li>
                <li>Our browser engine runs a binary search across quality and dimension steps to meet your target budget.</li>
                <li>Download your compressed image instantly with verified byte size.</li>
              </ol>
            ) : (
              <ol class="list-decimal pl-5 space-y-2">
                <li>Select or drag your files into the designated drop area above.</li>
                <li>Choose your preferred conversion parameters or quality options.</li>
                <li>Process and save the resulting files directly to your device.</li>
              </ol>
            )}
          </div>
        )}
      </div>

      <!-- House promo slot after how-to block -->
      <PromoSlot slotPosition="postHowTo" />

      <!-- 7. Tool-specific FAQ -->
      {tool.faq && tool.faq.length > 0 && (
        <FAQ items={tool.faq} title={`${tool.name} Frequently Asked Questions`} />
      )}
    </article>

    <!-- 8. Ad slot B (mid-content) -->
    <AdSlot slotPosition="midContent" />

    <!-- Related tools & format hub links -->
    <RelatedTools currentTool={tool} relatedTools={related} />

    <!-- 9. Last-reviewed date -->
    <div class="mt-12 pt-6 border-t border-slate-200/80 flex flex-col sm:flex-row sm:items-center justify-between text-xs text-slate-500 gap-2">
      <span>
        Last reviewed: <time datetime={formatIsoDate(tool.last_reviewed)}>{formatDisplayDate(tool.last_reviewed)}</time>
      </span>
      {tool.reviewer && !tool.reviewer.toLowerCase().includes('team') && !tool.reviewer.toLowerCase().includes('converter') && (
        <span>
          Reviewed by: <strong class="text-slate-700">{tool.reviewer}</strong>
        </span>
      )}
    </div>
  </div>
</Layout>
