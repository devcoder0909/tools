---
import CollegeLayout from '../../layouts/CollegeLayout.astro';
import SourceBox from '../../components/colleges/SourceBox.astro';
import RankPredictorShell from '../../components/colleges/RankPredictorShell';

const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'JEE Main Rank College Predictor',
  url: 'https://convert.gudmud.site/jee-main-rank-college-predictor/',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires JavaScript',
  description: 'Predict college admission chances for NITs, IIITs, and GFTIs based on official JoSAA closing ranks.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://convert.gudmud.site/' },
    { '@type': 'ListItem', position: 2, name: 'Colleges', item: 'https://convert.gudmud.site/colleges/' },
    { '@type': 'ListItem', position: 3, name: 'College Predictor', item: 'https://convert.gudmud.site/jee-main-rank-college-predictor/' },
  ],
};
---

<CollegeLayout
  title="JEE Main Rank College Predictor (JoSAA) | Gudmud Colleges"
  description="Predict your admission chances for NITs, IIITs, and GFTIs using official JoSAA cutoffs. View Safe, Moderate, and Reach college bands based on your AIR rank."
  canonical="https://convert.gudmud.site/jee-main-rank-college-predictor/"
  jsonLd={[webAppJsonLd, breadcrumbJsonLd]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Breadcrumb trail -->
    <nav class="flex items-center gap-2 text-xs text-gray-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <a href="/colleges/" class="hover:underline">Colleges</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">JEE Main Predictor</span>
    </nav>

    <!-- Header Section (Keywords H1) -->
    <header class="mb-6">
      <h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-3">
        JEE Main Rank College Predictor
      </h1>
      <p class="text-sm sm:text-base text-gray-600 max-w-3xl leading-relaxed">
        Calculate your admission probability for 116 institutes including NITs, IIITs, GFTIs, and IITs using official JoSAA Round 5 closing ranks. Enter your All India Rank, category, and quota to review customized Safe, Moderate, and Reach college bands.
      </p>
    </header>

    <!-- Methodology & Provenance Box -->
    <SourceBox
      sourceName="JoSAA Official Seat Allotment Archive"
      sourceUrl="https://josaa.nic.in"
      sourceYear={2024}
      lastVerified="2026-11-15"
      verifiedBy="Gudmud Data Engineering Team"
    />

    <!-- Interactive Predictor Tool (Above the Fold) -->
    <section class="my-8" aria-label="Interactive Rank Predictor">
      <RankPredictorShell client:load />
    </section>

    <!-- Predictor CTA to Advanced and Category Cutoffs -->
    <div class="mb-8 bg-indigo-50 border border-indigo-200 rounded-xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-sm font-bold text-indigo-950 mb-1">Appeared for JEE Advanced?</h2>
        <p class="text-xs text-indigo-800">Use our dedicated JEE Advanced predictor to estimate your admission likelihood across all 23 IITs based on CRL and category ranks.</p>
      </div>
      <a
        href="/jee-advanced-rank-college-predictor/"
        class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-indigo-600 text-white text-xs font-semibold hover:bg-indigo-700 transition shrink-0"
      >
        Open IIT Rank Predictor &rarr;
      </a>
    </div>

    <!-- Explanatory Guide on Predictor Probability Bands -->
    <section class="mt-12 space-y-6 text-sm text-gray-700 leading-relaxed border-t border-gray-200 pt-8">
      <h2 class="text-xl font-bold text-gray-900">
        How the JoSAA Prediction Bands are Calculated
      </h2>
      <p>
        Unlike commercial portals that collect phone numbers and show opaque scores, our predictor runs 100% transparently inside your browser using mathematical margin formulas based on JoSAA 2024 closing ranks:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-6">
        <div class="p-4 rounded-xl border border-emerald-200 bg-emerald-50/50">
          <h3 class="font-bold text-emerald-950 mb-1">Safe Band (&gt;15% Margin)</h3>
          <p class="text-xs text-gray-600">
            Assigned when your rank is comfortably lower (better) than 85% of the program's previous closing rank. Historically, seat retention probability in this band exceeds 85%.
          </p>
        </div>
        <div class="p-4 rounded-xl border border-amber-200 bg-amber-50/50">
          <h3 class="font-bold text-amber-950 mb-1">Moderate Band (&plusmn;15% Margin)</h3>
          <p class="text-xs text-gray-600">
            Assigned when your rank is close to the cutoff (between 85% and 100% of closing rank). Highly competitive; allotments fluctuate based on applicant choice patterns.
          </p>
        </div>
        <div class="p-4 rounded-xl border border-rose-200 bg-rose-50/50">
          <h3 class="font-bold text-rose-950 mb-1">Reach Band (Up to 15% Stretch)</h3>
          <p class="text-xs text-gray-600">
            Assigned when your rank is up to 15% higher than last year's closing rank. These programs require seat matrix expansions or lower category demand to become viable.
          </p>
        </div>
      </div>

      <h2 class="text-xl font-bold text-gray-900 pt-4">
        Predictor Frequently Asked Questions
      </h2>
      <div class="space-y-4">
        <details class="p-4 rounded-xl border border-gray-200 bg-white" open>
          <summary class="font-bold text-gray-900 cursor-pointer">
            Does this college predictor store my rank or personal phone number?
          </summary>
          <p class="mt-2 text-xs text-gray-600 leading-relaxed">
            No. Best Converter and Gudmud Colleges enforce a strict zero-lead-capture policy. All calculations run strictly in client-side JavaScript on your personal device without sending your rank to any server.
          </p>
        </details>
        <details class="p-4 rounded-xl border border-gray-200 bg-white">
          <summary class="font-bold text-gray-900 cursor-pointer">
            Can I predict IIT colleges using my JEE Main rank?
          </summary>
          <p class="mt-2 text-xs text-gray-600 leading-relaxed">
            No. Admissions to the 23 Indian Institutes of Technology (IITs) are based solely on JEE Advanced All India Ranks. JEE Main ranks are used for admissions to NITs, IIITs, and GFTIs. Select "JEE Advanced" in the exam filter to view IIT cutoffs.
          </p>
        </details>
      </div>
    </section>
  </div>
</CollegeLayout>
