---
import CollegeLayout from '../../layouts/CollegeLayout.astro';
import SourceBox from '../../components/colleges/SourceBox.astro';
import collegesData from '@/data/colleges.json';
import programsData from '@/data/programs.json';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  return collegesData.map((college) => ({
    params: { slug: college.slug },
    props: { college },
  }));
}

const { college } = Astro.props;

// Load cutoffs
const cutoffsPath = path.resolve(process.cwd(), 'public/data/cutoffs/2024-all.json');
let allCutoffs: any[] = [];
if (fs.existsSync(cutoffsPath)) {
  try {
    allCutoffs = JSON.parse(fs.readFileSync(cutoffsPath, 'utf-8'));
  } catch (e) {
    allCutoffs = [];
  }
}

// Filter cutoffs for this college: [slug, program_code, quota, seat_type, gender, round, opening_rank, closing_rank]
const collegeCutoffs = allCutoffs.filter((row) => row[0] === college.slug);

// Program name lookup
const programMap = new Map<string, string>();
for (const p of programsData) {
  programMap.set(p.code, p.name);
}

// Find similar institutes by NIRF rank or type
const myEngRank = college.nirf?.find((n: any) => n.category === 'Engineering')?.rank;
let similarColleges: any[] = [];
if (myEngRank) {
  similarColleges = collegesData
    .filter((c) => c.slug !== college.slug)
    .filter((c) => {
      const r = c.nirf?.find((n: any) => n.category === 'Engineering')?.rank;
      return r && Math.abs(r - myEngRank) <= 12;
    })
    .slice(0, 4);
}
if (similarColleges.length === 0) {
  similarColleges = collegesData
    .filter((c) => c.slug !== college.slug && c.type === college.type)
    .slice(0, 4);
}

// Title & Meta formatting strictly <= 60 chars and 120-158 chars
const displayName = college.short_name || college.name;
let title = `${displayName}: NIRF Rank, Cutoffs & Links`;
if (title.length > 60) {
  title = `${displayName}: NIRF Rank & Cutoffs 2024`;
}
if (title.length > 60) {
  title = `${displayName.slice(0, 32)}: NIRF & Cutoffs`;
}

let description = `Explore ${displayName} (${college.city}, ${college.state}) NIRF 2024 ranking history, official JoSAA cutoffs, academic programs, and verified portal links.`;
if (description.length > 158) {
  description = description.slice(0, 155) + '...';
} else if (description.length < 120) {
  description = `${description} Verified against official Ministry of Education data.`;
}

// Structured Data
const collegeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollegeOrUniversity',
  name: college.name,
  alternateName: college.short_name || undefined,
  url: college.official_url,
  address: {
    '@type': 'PostalAddress',
    addressLocality: college.city,
    addressRegion: college.state,
    addressCountry: 'IN',
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://convert.gudmud.site/' },
    { '@type': 'ListItem', position: 2, name: 'Colleges', item: 'https://convert.gudmud.site/colleges/' },
    { '@type': 'ListItem', position: 3, name: displayName, item: `https://convert.gudmud.site/colleges/${college.slug}/` },
  ],
};
---

<CollegeLayout
  title={title}
  description={description}
  canonical={`https://convert.gudmud.site/colleges/${college.slug}/`}
  jsonLd={[collegeJsonLd, breadcrumbJsonLd]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-gray-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <a href="/colleges/" class="hover:underline">Colleges</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">{displayName}</span>
    </nav>

    <!-- Header Section -->
    <header class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200 mb-3">
        <span>Verified Institute Profile</span>
        <span>•</span>
        <span>Type: {college.type}</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-3">
        {college.name}
      </h1>
      <p class="text-sm sm:text-base text-gray-600 max-w-3xl leading-relaxed">
        {college.short_name || college.name} is an autonomous public {college.type} institution located in {college.city}, {college.state}. Established in {college.established}, it offers undergraduate and postgraduate technical degrees through national competitive examinations.
      </p>
    </header>

    <!-- Key Facts Cards -->
    <section class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
      <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm">
        <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider block mb-1">Institution Type</span>
        <span class="text-lg font-bold text-gray-900">{college.type}</span>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm">
        <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider block mb-1">Established</span>
        <span class="text-lg font-bold text-gray-900">{college.established}</span>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm">
        <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider block mb-1">Location</span>
        <span class="text-lg font-bold text-gray-900">{college.city}, {college.state}</span>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm">
        <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider block mb-1">JoSAA Code</span>
        <span class="text-lg font-mono font-bold text-indigo-600">{college.josaa_code || 'N/A'}</span>
      </div>
    </section>

    <!-- Official Actions & Links -->
    <section class="bg-indigo-50 border border-indigo-200 rounded-xl p-5 mb-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h2 class="text-base font-bold text-indigo-950 mb-1">Official Portals & admissions</h2>
        <p class="text-xs text-indigo-800">
          We do not host or alter official applications. Always access fees, seat reservations, and notifications directly from the institute.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href={college.official_url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold shadow-sm"
        >
          Visit Official Website ↗
        </a>
        <a
          href={`/cutoff/${college.slug}/`}
          class="inline-flex items-center px-4 py-2 bg-white hover:bg-gray-50 text-indigo-700 border border-indigo-300 rounded-lg text-xs font-semibold"
        >
          View Full Cutoff Page →
        </a>
      </div>
    </section>

    <!-- NIRF Historical Ranking Table -->
    {college.nirf && college.nirf.length > 0 && (
      <section class="mb-10 bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
          <h2 class="text-base font-bold text-gray-900">National Institutional Ranking Framework (NIRF) History</h2>
          <p class="text-xs text-gray-500">Official ranking benchmark published by the Ministry of Education, Government of India.</p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-gray-100 border-b border-gray-200 text-xs font-semibold text-gray-600 uppercase tracking-wider">
                <th class="px-4 py-3">Category</th>
                <th class="px-4 py-3 text-center">Edition Year</th>
                <th class="px-4 py-3 text-center">All India Rank</th>
                <th class="px-4 py-3 text-right">NIRF Score</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              {college.nirf.map((r: any) => (
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 font-semibold text-gray-900">{r.category}</td>
                  <td class="px-4 py-3 text-center font-mono text-gray-700">{r.year}</td>
                  <td class="px-4 py-3 text-center font-bold text-indigo-700">#{r.rank}</td>
                  <td class="px-4 py-3 text-right font-mono text-gray-900">{r.score ? r.score.toFixed(2) : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <!-- JoSAA Round 5 Cutoffs Table -->
    <section class="mb-10 bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
        <div>
          <h2 class="text-base font-bold text-gray-900">Official JoSAA 2024 Cutoffs (Round 5)</h2>
          <p class="text-xs text-gray-500">Opening and closing ranks for undergraduate programs.</p>
        </div>
        <a href={`/cutoff/${college.slug}/`} class="text-xs font-semibold text-indigo-600 hover:underline">
          See All Rounds & Quotas →
        </a>
      </div>
      {collegeCutoffs.length > 0 ? (
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-gray-100 border-b border-gray-200 text-xs font-semibold text-gray-600 uppercase tracking-wider">
                <th class="px-4 py-3">Academic Program</th>
                <th class="px-4 py-3 text-center">Quota</th>
                <th class="px-4 py-3 text-center">Seat Type</th>
                <th class="px-4 py-3 text-center">Gender</th>
                <th class="px-4 py-3 text-right">Opening Rank</th>
                <th class="px-4 py-3 text-right">Closing Rank</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              {collegeCutoffs.map((row) => (
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 font-medium text-gray-900">
                    {programMap.get(row[1]) || row[1]}
                  </td>
                  <td class="px-4 py-3 text-center">
                    <span class="px-2 py-0.5 rounded text-xs font-semibold bg-gray-100 text-gray-700">
                      {row[2]}
                    </span>
                  </td>
                  <td class="px-4 py-3 text-center text-xs font-medium text-gray-700">
                    {row[3]}
                  </td>
                  <td class="px-4 py-3 text-center text-xs text-gray-600">
                    {row[4]}
                  </td>
                  <td class="px-4 py-3 text-right font-mono text-gray-700">
                    {row[6]}
                  </td>
                  <td class="px-4 py-3 text-right font-mono font-bold text-indigo-700">
                    {row[7]}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="p-6 text-sm text-gray-500 text-center">
          Cutoff data for this institute is updated annually following JoSAA counselling completion.
          <div class="mt-3">
            <a href="/cutoff/" class="text-indigo-600 hover:underline font-medium">
              Explore the JoSAA Cutoff Explorer →
            </a>
          </div>
        </div>
      )}
    </section>

    <!-- Similar Institutes in NIRF Rank Band -->
    {similarColleges.length > 0 && (
      <section class="mb-10 bg-gray-50 border border-gray-200 rounded-xl p-6">
        <h2 class="text-base font-bold text-gray-900 mb-2">Similar Institutes in Comparable Rank Band</h2>
        <p class="text-xs text-gray-600 mb-4">
          Institutions with matching academic profile, institutional status, or neighboring NIRF ranking:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
          {similarColleges.map((sim) => (
            <a
              href={`/colleges/${sim.slug}/`}
              class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm hover:border-indigo-400 hover:shadow-md transition-all flex flex-col justify-between"
            >
              <div>
                <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-semibold bg-gray-100 text-gray-700 mb-1">
                  {sim.type}
                </span>
                <h3 class="text-sm font-bold text-gray-900 mb-1 leading-snug">
                  {sim.short_name || sim.name}
                </h3>
                <p class="text-xs text-gray-500 mb-2">{sim.city}, {sim.state}</p>
              </div>
              <span class="text-xs font-semibold text-indigo-600 hover:underline">
                View Profile →
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Provenance & SourceBox -->
    <SourceBox
      sourceName="Official Portals (NIRF & JoSAA)"
      sourceUrl="https://josaa.nic.in"
      sourceYear={2024}
      verifiedAt="2026-11-15"
      methodologyNote="Institute information is sourced directly from government public gazettes, NIRF reports, and JoSAA seat allocation datasets. We do not accept private listing fees or sponsor endorsements."
    />
  </div>
</CollegeLayout>
