---
import Layout from '../layouts/Layout.astro';
import { getAllTools } from '../registry';
import { siteConfig } from '../config/site';

const popularTools = getAllTools().slice(0, 6);
---

<Layout
  title={`Page Not Found (404) | ${siteConfig.brand}`}
  description="The page you requested could not be found. Browse our popular image converters, calculators, and file format guides."
  canonical={`${siteConfig.url}/404/`}
  noindex={true}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16 text-center">
    <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full bg-rose-50 text-rose-700 border border-rose-200/80 mb-4">
      Error 404
    </span>
    <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 mb-4 tracking-tight">
      Page Not Found
    </h1>
    <p class="text-base sm:text-lg text-slate-600 mb-8 max-w-xl mx-auto leading-relaxed">
      The tool or page you were looking for may have moved or doesn't exist. Check out our most popular free tools below:
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left my-8">
      {popularTools.map((tool) => (
        <a
          href={`/${tool.slug}/`}
          class="p-4 rounded-xl border border-slate-200/90 bg-white hover:border-emerald-500 hover:shadow-card transition-all group"
        >
          <h2 class="font-bold text-slate-900 group-hover:text-emerald-700 text-sm mb-1 transition-colors">
            {tool.name}
          </h2>
          <p class="text-xs text-slate-500 line-clamp-1">
            {tool.description}
          </p>
        </a>
      ))}
    </div>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-sm font-semibold shadow-xs hover:shadow-sm transition-all active:scale-[0.99] cursor-pointer"
      >
        Back to Homepage
      </a>
      <a
        href="/tools/"
        class="px-5 py-2.5 bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 rounded-xl text-sm font-semibold shadow-2xs transition-all cursor-pointer"
      >
        All Tools Directory
      </a>
    </div>
  </div>
</Layout>
