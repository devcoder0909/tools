---
import Layout from '../layouts/Layout.astro';
import { getAllTools } from '../registry';
import { siteConfig } from '../config/site';

const popularTools = getAllTools().slice(0, 6);
---

<Layout
  title="Page Not Found (404) - Best Converter"
  description="The page you requested could not be found. Browse our popular image converters, calculators, and file format guides."
  canonical={`${siteConfig.url}/404/`}
  noindex={true}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16 text-center">
    <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full bg-red-50 text-red-700 mb-4">
      Error 404
    </span>
    <h1 class="text-3xl sm:text-5xl font-extrabold text-gray-900 mb-4">
      Page Not Found
    </h1>
    <p class="text-base sm:text-lg text-gray-600 mb-8 max-w-xl mx-auto">
      The tool or page you were looking for may have moved or doesn't exist. Check out our most popular free tools below:
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left my-8">
      {popularTools.map((tool) => (
        <a
          href={`/${tool.slug}/`}
          class="p-4 rounded-lg border border-gray-200 bg-white hover:border-green-500 hover:shadow-xs transition group"
        >
          <h2 class="font-semibold text-gray-900 group-hover:text-green-600 text-sm mb-1">
            {tool.name}
          </h2>
          <p class="text-xs text-gray-500 line-clamp-1">
            {tool.description}
          </p>
        </a>
      ))}
    </div>

    <div class="mt-8 flex justify-center space-x-4">
      <a
        href="/"
        class="px-5 py-2.5 bg-green-600 hover:bg-green-700 text-white rounded-lg text-sm font-semibold transition"
      >
        Back to Homepage
      </a>
      <a
        href="/tools/"
        class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-lg text-sm font-semibold transition"
      >
        All Tools Directory
      </a>
    </div>
  </div>
</Layout>
