---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getIndexableTools } from '../../registry';
import { siteConfig } from '../../config/site';

const tools = getIndexableTools();
const pdfTools = tools.filter((t) => t.kind === 'pdf');
const imageConverters = tools.filter((t) => t.kind === 'converter');
const calculators = tools.filter((t) => t.kind === 'finance' || t.kind === 'calculator');
const generators = tools.filter((t) => t.kind === 'generator');
const mediaTools = tools.filter((t) => t.kind === 'media');
const developerTools = tools.filter((t) => t.kind === 'developer' || t.kind === 'text');

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'All Tools', href: '/tools/' },
];
---

<Layout
  title={`All Free Online Tools & Converters | ${siteConfig.brand}`}
  description="Find a free tool for your task. Convert photos, reduce image sizes, merge or split PDFs, format JSON, and calculate dates, percentages or loan payments."
  canonical={`${siteConfig.url}/tools/`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mb-10 text-center sm:text-left">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-3">
        All Free Online Tools &amp; File Converters
      </h1>
      <p class="text-base text-slate-600 max-w-3xl leading-relaxed">
        Choose from {tools.length} tools by task. Start with the file type you have, the result you need, or a calculation such as a percentage change.
      </p>


    </div>

    <!-- Real-time Interactive Tool Search -->
    <div class="mb-8">
      <div class="relative max-w-xl">
        <input
          type="search"
          id="tool-search-input"
          aria-label="Search tools"
          inputmode="search"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          placeholder={`Search ${tools.length} tools (e.g. PDF to Word, video compressor, aspect ratio)`}
          class="w-full pl-11 pr-12 py-3.5 border border-slate-200/90 rounded-2xl text-base sm:text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 shadow-xs bg-white text-slate-900 transition"
        />
        <svg class="w-5 h-5 text-slate-400 absolute left-3.5 top-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <button
          type="button"
          id="tool-search-clear"
          class="hidden absolute right-3 top-2.5 p-2 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 focus:outline-none transition cursor-pointer"
          aria-label="Clear search input"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        <span id="tool-search-kbd" class="hidden sm:inline-block absolute right-3.5 top-3.5 px-2 py-0.5 rounded-md bg-slate-100 text-2xs font-mono font-semibold text-slate-400 border border-slate-200 pointer-events-none">/</span>
      </div>
      <div id="tool-search-feedback" class="hidden mt-2 text-xs font-semibold text-slate-600" aria-live="polite"></div>
    </div>

    <!-- Empty Search State -->
    <div id="empty-search-state" class="hidden text-center py-12 px-4 rounded-2xl border border-dashed border-slate-300 bg-slate-50/70 my-6">
      <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </div>
      <h3 class="text-base font-bold text-slate-900 mb-1" id="empty-query-text">No tools found matching your search</h3>
      <p class="text-xs text-slate-500 max-w-md mx-auto mb-4">Try searching by file format (e.g. PDF, JPG, WebP), task (e.g. compress, split, convert), or calculate.</p>
      <button type="button" id="reset-search-btn" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-emerald-600 hover:bg-emerald-700 text-white shadow-xs transition active:scale-[0.98] cursor-pointer">Reset Search</button>
    </div>

    <!-- Quick Navigation Anchor Links -->
    <div class="flex flex-wrap gap-2 mb-10 pb-4 border-b border-slate-200">
      <a href="#pdf" class="px-3.5 py-1.5 rounded-xl bg-slate-100 hover:bg-emerald-600 hover:text-white text-slate-700 text-xs font-semibold border border-slate-200/60 transition-all">PDF Tools ({pdfTools.length})</a>
      <a href="#converters" class="px-3.5 py-1.5 rounded-xl bg-slate-100 hover:bg-emerald-600 hover:text-white text-slate-700 text-xs font-semibold border border-slate-200/60 transition-all">Image Converters ({imageConverters.length})</a>
      <a href="#calculators" class="px-3.5 py-1.5 rounded-xl bg-slate-100 hover:bg-emerald-600 hover:text-white text-slate-700 text-xs font-semibold border border-slate-200/60 transition-all">Calculators &amp; Finance ({calculators.length})</a>
      <a href="#generators" class="px-3.5 py-1.5 rounded-xl bg-slate-100 hover:bg-emerald-600 hover:text-white text-slate-700 text-xs font-semibold border border-slate-200/60 transition-all">Generators ({generators.length})</a>
      <a href="#media" class="px-3.5 py-1.5 rounded-xl bg-slate-100 hover:bg-emerald-600 hover:text-white text-slate-700 text-xs font-semibold border border-slate-200/60 transition-all">Media &amp; Recorders ({mediaTools.length})</a>
      <a href="#developer" class="px-3.5 py-1.5 rounded-xl bg-slate-100 hover:bg-emerald-600 hover:text-white text-slate-700 text-xs font-semibold border border-slate-200/60 transition-all">Developer &amp; Text ({developerTools.length})</a>
    </div>

    <!-- PDF Tools -->
    <section id="pdf" class="mb-14 scroll-mt-6">
      <div class="flex items-center justify-between mb-4 border-b border-slate-200 pb-2">
        <h2 class="text-2xl font-bold text-slate-900">
          PDF &amp; Document Tools
        </h2>
        <span class="text-xs font-semibold text-slate-500">Fast In-Browser PDF Engine</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {pdfTools.map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="tool-card p-4 sm:p-5 rounded-2xl border border-slate-200 bg-white hover:border-emerald-500 hover:shadow-xs transition duration-200 group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-semibold uppercase px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 group-hover:bg-emerald-50 group-hover:text-emerald-700 transition-colors mb-2 inline-block">PDF</span>
              <h3 class="font-bold text-slate-900 group-hover:text-emerald-600 mb-1 text-sm sm:text-base transition-colors">
                {tool.name}
              </h3>
              <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                {tool.description}
              </p>
            </div>
            <div class="mt-3 text-xs font-medium text-emerald-600 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Launch tool &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Image Converters -->
    <section id="converters" class="mb-14 scroll-mt-6">
      <div class="flex items-center justify-between mb-4 border-b border-slate-200 pb-2">
        <h2 class="text-2xl font-bold text-slate-900">
          Image Converters &amp; Size Compressors
        </h2>
        <span class="text-xs font-semibold text-slate-500">Canvas &amp; WebAssembly Optimization</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {imageConverters.map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="tool-card p-4 sm:p-5 rounded-2xl border border-slate-200 bg-white hover:border-emerald-500 hover:shadow-xs transition duration-200 group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-semibold uppercase px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 group-hover:bg-emerald-50 group-hover:text-emerald-700 transition-colors mb-2 inline-block">Image</span>
              <h3 class="font-bold text-slate-900 group-hover:text-emerald-600 mb-1 text-sm sm:text-base transition-colors">
                {tool.name}
              </h3>
              <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                {tool.description}
              </p>
            </div>
            <div class="mt-3 text-xs font-medium text-emerald-600 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Launch tool &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Calculators & Financial Tools -->
    <section id="calculators" class="mb-14 scroll-mt-6">
      <div class="flex items-center justify-between mb-4 border-b border-slate-200 pb-2">
        <h2 class="text-2xl font-bold text-slate-900">
          Calculators &amp; Financial Utilities
        </h2>
        <span class="text-xs font-semibold text-slate-500">IEEE 754 Floating-Point Accuracy</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {calculators.map((calc) => (
          <a
            href={`/${calc.slug}/`}
            class="tool-card p-4 sm:p-5 rounded-2xl border border-slate-200 bg-white hover:border-emerald-500 hover:shadow-xs transition duration-200 group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-semibold uppercase px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 group-hover:bg-emerald-50 group-hover:text-emerald-700 transition-colors mb-2 inline-block">Calculator</span>
              <h3 class="font-bold text-slate-900 group-hover:text-emerald-600 mb-1 text-sm sm:text-base transition-colors">
                {calc.name}
              </h3>
              <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                {calc.description}
              </p>
            </div>
            <div class="mt-3 text-xs font-medium text-emerald-600 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Launch calculator &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Generators & Creators -->
    <section id="generators" class="mb-14 scroll-mt-6">
      <div class="flex items-center justify-between mb-4 border-b border-slate-200 pb-2">
        <h2 class="text-2xl font-bold text-slate-900">
          Generators &amp; Creative Utilities
        </h2>
        <span class="text-xs font-semibold text-slate-500">Cryptographic Security &amp; Vector Output</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {generators.map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="tool-card p-4 sm:p-5 rounded-2xl border border-slate-200 bg-white hover:border-emerald-500 hover:shadow-xs transition duration-200 group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-semibold uppercase px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 group-hover:bg-emerald-50 group-hover:text-emerald-700 transition-colors mb-2 inline-block">Generator</span>
              <h3 class="font-bold text-slate-900 group-hover:text-emerald-600 mb-1 text-sm sm:text-base transition-colors">
                {tool.name}
              </h3>
              <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                {tool.description}
              </p>
            </div>
            <div class="mt-3 text-xs font-medium text-emerald-600 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Generate &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Media & Recorders -->
    <section id="media" class="mb-14 scroll-mt-6">
      <div class="flex items-center justify-between mb-4 border-b border-slate-200 pb-2">
        <h2 class="text-2xl font-bold text-slate-900">
          Audio, Video &amp; Screen Recorders
        </h2>
        <span class="text-xs font-semibold text-slate-500">Native HTML5 Web Media APIs</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {mediaTools.map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="tool-card p-4 sm:p-5 rounded-2xl border border-slate-200 bg-white hover:border-emerald-500 hover:shadow-xs transition duration-200 group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-semibold uppercase px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 group-hover:bg-emerald-50 group-hover:text-emerald-700 transition-colors mb-2 inline-block">Media</span>
              <h3 class="font-bold text-slate-900 group-hover:text-emerald-600 mb-1 text-sm sm:text-base transition-colors">
                {tool.name}
              </h3>
              <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                {tool.description}
              </p>
            </div>
            <div class="mt-3 text-xs font-medium text-emerald-600 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Launch tool &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Developer & Text Utilities -->
    <section id="developer" class="mb-14 scroll-mt-6">
      <div class="flex items-center justify-between mb-4 border-b border-slate-200 pb-2">
        <h2 class="text-2xl font-bold text-slate-900">
          Developer Utilities &amp; Text Transformers
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {developerTools.map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="tool-card p-4 sm:p-5 rounded-2xl border border-slate-200 bg-white hover:border-emerald-500 hover:shadow-xs transition duration-200 group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-semibold uppercase px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 group-hover:bg-emerald-50 group-hover:text-emerald-700 transition-colors mb-2 inline-block">Developer</span>
              <h3 class="font-bold text-slate-900 group-hover:text-emerald-600 mb-1 text-sm sm:text-base transition-colors">
                {tool.name}
              </h3>
              <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                {tool.description}
              </p>
            </div>
            <div class="mt-3 text-xs font-medium text-emerald-600 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Launch utility &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="space-y-3 my-8 text-slate-700">
      <h2 class="text-xl font-bold text-slate-900">Which tool fits your task?</h2>
      <p>If an upload rejects your photo, check the error first. Use the <a class="underline" href="/resize-image/">image resizer</a> for pixel dimensions or compare <a class="underline" href="/topics/image-compression-tools/">image compression tools by file size</a> for a KB limit.</p>
      <p>To combine documents in reading order, <a class="underline" href="/merge-pdf/">merge PDF files</a>. To extract a smaller selection, <a class="underline" href="/split-pdf/">split a PDF by page</a>.</p>
      <p>For an API response, <a class="underline" href="/json-formatter/">format JSON for inspection</a>. For a spreadsheet import, compare the <a class="underline" href="/topics/json-csv-tools/">JSON and CSV conversion tools</a>.</p>
    </section>
  </div>

  <script is:inline>
    (() => {
      const searchInput = document.getElementById('tool-search-input');
      const clearBtn = document.getElementById('tool-search-clear');
      const kbdBadge = document.getElementById('tool-search-kbd');
      const feedback = document.getElementById('tool-search-feedback');
      const emptyState = document.getElementById('empty-search-state');
      const emptyQueryText = document.getElementById('empty-query-text');
      const resetBtn = document.getElementById('reset-search-btn');
      const cards = Array.from(document.querySelectorAll('.tool-card'));
      const sections = Array.from(document.querySelectorAll('section[id]'));

      function runSearch(query) {
        const q = (query || '').toLowerCase().trim();

        if (clearBtn) {
          if (q) {
            clearBtn.classList.remove('hidden');
            if (kbdBadge) kbdBadge.classList.add('hidden');
          } else {
            clearBtn.classList.add('hidden');
            if (kbdBadge) kbdBadge.classList.remove('hidden');
          }
        }

        let visibleCount = 0;
        cards.forEach((card) => {
          const text = card.textContent.toLowerCase();
          if (!q || text.includes(q)) {
            card.style.display = '';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        // Hide or show category sections based on visible cards inside them
        sections.forEach((sec) => {
          const visibleCards = sec.querySelectorAll('.tool-card:not([style*="display: none"])');
          if (q && visibleCards.length === 0) {
            sec.style.display = 'none';
          } else {
            sec.style.display = '';
          }
        });

        if (feedback) {
          if (q) {
            feedback.textContent = visibleCount === 1 ? 'Found 1 matching tool' : `Found ${visibleCount} matching tools`;
            feedback.classList.remove('hidden');
          } else {
            feedback.textContent = '';
            feedback.classList.add('hidden');
          }
        }

        if (emptyState) {
          if (q && visibleCount === 0) {
            if (emptyQueryText) emptyQueryText.textContent = `No tools found matching "${query}"`;
            emptyState.classList.remove('hidden');
          } else {
            emptyState.classList.add('hidden');
          }
        }
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          runSearch(e.target.value);
        });

        if (clearBtn) {
          clearBtn.addEventListener('click', () => {
            searchInput.value = '';
            runSearch('');
            searchInput.focus();
          });
        }

        if (resetBtn) {
          resetBtn.addEventListener('click', () => {
            searchInput.value = '';
            runSearch('');
            searchInput.focus();
          });
        }

        // Check URL params on load
        const params = new URLSearchParams(window.location.search);
        const qParam = params.get('q');
        const focusParam = params.get('focus');

        if (qParam) {
          searchInput.value = qParam;
          runSearch(qParam);
          searchInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else if (focusParam === 'search') {
          searchInput.focus();
          searchInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }

      // Global keyboard shortcut
      window.addEventListener('keydown', (e) => {
        if ((e.key === '/' || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k')) && document.activeElement !== searchInput) {
          if (!['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) {
            e.preventDefault();
            searchInput?.focus();
            searchInput?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        }
      });
    })();
  </script>
</Layout>