---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getAllTools } from '../../registry';
import { siteConfig } from '../../config/site';

const tools = getAllTools();
const pdfTools = tools.filter((t) => t.kind === 'pdf');
const imageConverters = tools.filter((t) => t.kind === 'converter');
const calculators = tools.filter((t) => t.kind === 'finance' || t.kind === 'calculator');
const generators = tools.filter((t) => t.kind === 'generator');
const mediaTools = tools.filter((t) => t.kind === 'media');
const developerTools = tools.filter((t) => t.kind === 'developer' || t.kind === 'text');

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'All Tools', href: '/tools/' },
];
---

<Layout
  title="All Free Online Tools & Converters - Best Converter"
  description="Browse our complete directory of 100% private in-browser converters, image compressors, calculators, and text transformers."
  canonical={`${siteConfig.url}/tools/`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mb-10 text-center sm:text-left">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800 mb-3">
        Zero Server Uploads • 100% Client-Side
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-3">
        All Online File Converters & Utilities
      </h1>
      <p class="text-base text-gray-600 max-w-3xl">
        Every single tool operates entirely within your browser memory (RAM). Your files, images, calculations, and sensitive text never touch a remote cloud server.
      </p>
    </div>

    <!-- Real-time Interactive Tool Search -->
    <div class="mb-8">
      <div class="relative max-w-xl">
        <input
          type="text"
          id="tool-search-input"
          placeholder="Search 70+ tools (e.g. color picker, base64, gpa, gst, merge pdf, qr code)..."
          class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 shadow-xs"
        />
        <svg class="w-5 h-5 text-gray-400 absolute left-3 top-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>

    <!-- Quick Navigation Anchor Links -->
    <div class="flex flex-wrap gap-2 mb-10 pb-4 border-b border-gray-200">
      <a href="#pdf" class="px-3 py-1.5 rounded-lg bg-gray-100 hover:bg-green-100 text-gray-700 hover:text-green-800 text-xs font-semibold transition">PDF Tools ({pdfTools.length})</a>
      <a href="#converters" class="px-3 py-1.5 rounded-lg bg-gray-100 hover:bg-green-100 text-gray-700 hover:text-green-800 text-xs font-semibold transition">Image Converters ({imageConverters.length})</a>
      <a href="#calculators" class="px-3 py-1.5 rounded-lg bg-gray-100 hover:bg-green-100 text-gray-700 hover:text-green-800 text-xs font-semibold transition">Calculators & Finance ({calculators.length})</a>
      <a href="#generators" class="px-3 py-1.5 rounded-lg bg-gray-100 hover:bg-green-100 text-gray-700 hover:text-green-800 text-xs font-semibold transition">Generators ({generators.length})</a>
      <a href="#media" class="px-3 py-1.5 rounded-lg bg-gray-100 hover:bg-green-100 text-gray-700 hover:text-green-800 text-xs font-semibold transition">Media & Recorders ({mediaTools.length})</a>
      <a href="#developer" class="px-3 py-1.5 rounded-lg bg-gray-100 hover:bg-green-100 text-gray-700 hover:text-green-800 text-xs font-semibold transition">Developer & Text ({developerTools.length})</a>
    </div>

    <!-- PDF Tools -->
    <section id="pdf" class="mb-14 scroll-mt-6">
      <div class="flex items-center justify-between mb-4 border-b border-gray-200 pb-2">
        <h2 class="text-2xl font-bold text-gray-900">
          PDF & Document Tools
        </h2>
        <span class="text-xs font-semibold text-gray-500">Fast In-Browser PDF Engine</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {pdfTools.map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="tool-card p-4 rounded-xl border border-gray-200 bg-white hover:border-green-500 hover:shadow-xs transition group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-semibold uppercase px-2 py-0.5 rounded bg-red-50 text-red-700 mb-2 inline-block">PDF</span>
              <h3 class="font-bold text-gray-900 group-hover:text-green-600 mb-1 text-sm sm:text-base">
                {tool.name}
              </h3>
              <p class="text-xs text-gray-500 line-clamp-2">
                {tool.description}
              </p>
            </div>
            <div class="mt-3 text-xs font-medium text-green-600 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Launch tool &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Image Converters -->
    <section id="converters" class="mb-14 scroll-mt-6">
      <div class="flex items-center justify-between mb-4 border-b border-gray-200 pb-2">
        <h2 class="text-2xl font-bold text-gray-900">
          Image Converters & Size Compressors
        </h2>
        <span class="text-xs font-semibold text-gray-500">Canvas & WebAssembly Optimization</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {imageConverters.map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="tool-card p-4 rounded-xl border border-gray-200 bg-white hover:border-green-500 hover:shadow-xs transition group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-semibold uppercase px-2 py-0.5 rounded bg-blue-50 text-blue-700 mb-2 inline-block">Image</span>
              <h3 class="font-bold text-gray-900 group-hover:text-green-600 mb-1 text-sm sm:text-base">
                {tool.name}
              </h3>
              <p class="text-xs text-gray-500 line-clamp-2">
                {tool.description}
              </p>
            </div>
            <div class="mt-3 text-xs font-medium text-green-600 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Launch tool &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Calculators & Financial Tools -->
    <section id="calculators" class="mb-14 scroll-mt-6">
      <div class="flex items-center justify-between mb-4 border-b border-gray-200 pb-2">
        <h2 class="text-2xl font-bold text-gray-900">
          Calculators & Financial Utilities
        </h2>
        <span class="text-xs font-semibold text-gray-500">IEEE 754 Floating-Point Accuracy</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {calculators.map((calc) => (
          <a
            href={`/${calc.slug}/`}
            class="tool-card p-4 rounded-xl border border-gray-200 bg-white hover:border-green-500 hover:shadow-xs transition group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-semibold uppercase px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 mb-2 inline-block">Calculator</span>
              <h3 class="font-bold text-gray-900 group-hover:text-green-600 mb-1 text-sm sm:text-base">
                {calc.name}
              </h3>
              <p class="text-xs text-gray-500 line-clamp-2">
                {calc.description}
              </p>
            </div>
            <div class="mt-3 text-xs font-medium text-green-600 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Launch calculator &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Generators & Creators -->
    <section id="generators" class="mb-14 scroll-mt-6">
      <div class="flex items-center justify-between mb-4 border-b border-gray-200 pb-2">
        <h2 class="text-2xl font-bold text-gray-900">
          Generators & Creative Utilities
        </h2>
        <span class="text-xs font-semibold text-gray-500">Cryptographic Security & Vector Output</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {generators.map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="tool-card p-4 rounded-xl border border-gray-200 bg-white hover:border-green-500 hover:shadow-xs transition group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-semibold uppercase px-2 py-0.5 rounded bg-purple-50 text-purple-700 mb-2 inline-block">Generator</span>
              <h3 class="font-bold text-gray-900 group-hover:text-green-600 mb-1 text-sm sm:text-base">
                {tool.name}
              </h3>
              <p class="text-xs text-gray-500 line-clamp-2">
                {tool.description}
              </p>
            </div>
            <div class="mt-3 text-xs font-medium text-green-600 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Generate &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Media & Recorders -->
    <section id="media" class="mb-14 scroll-mt-6">
      <div class="flex items-center justify-between mb-4 border-b border-gray-200 pb-2">
        <h2 class="text-2xl font-bold text-gray-900">
          Audio, Video & Screen Recorders
        </h2>
        <span class="text-xs font-semibold text-gray-500">Native HTML5 Web Media APIs</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {mediaTools.map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="tool-card p-4 rounded-xl border border-gray-200 bg-white hover:border-green-500 hover:shadow-xs transition group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-semibold uppercase px-2 py-0.5 rounded bg-amber-50 text-amber-700 mb-2 inline-block">Media</span>
              <h3 class="font-bold text-gray-900 group-hover:text-green-600 mb-1 text-sm sm:text-base">
                {tool.name}
              </h3>
              <p class="text-xs text-gray-500 line-clamp-2">
                {tool.description}
              </p>
            </div>
            <div class="mt-3 text-xs font-medium text-green-600 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Launch tool &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Developer & Text Utilities -->
    <section id="developer" class="mb-14 scroll-mt-6">
      <div class="flex items-center justify-between mb-4 border-b border-gray-200 pb-2">
        <h2 class="text-2xl font-bold text-gray-900">
          Developer Utilities & Text Transformers
        </h2>
        <span class="text-xs font-semibold text-gray-500">Zero Server Logging • Offline Capable</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {developerTools.map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="tool-card p-4 rounded-xl border border-gray-200 bg-white hover:border-green-500 hover:shadow-xs transition group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-semibold uppercase px-2 py-0.5 rounded bg-indigo-50 text-indigo-700 mb-2 inline-block">Developer</span>
              <h3 class="font-bold text-gray-900 group-hover:text-green-600 mb-1 text-sm sm:text-base">
                {tool.name}
              </h3>
              <p class="text-xs text-gray-500 line-clamp-2">
                {tool.description}
              </p>
            </div>
            <div class="mt-3 text-xs font-medium text-green-600 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Launch utility &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Comprehensive Explainer Section for SEO Word Count and User Trust -->
    <section class="prose max-w-none text-gray-700 space-y-4 my-8 text-sm sm:text-base leading-relaxed bg-gray-50 border border-gray-200 rounded-2xl p-6 sm:p-8">
      <h2 class="text-xl font-bold text-gray-900">Why Modern Web Utilities Must Run Client-Side</h2>
      <p>
        The online utility software market has historically required users to upload confidential files to centralized cloud servers. Every time a consumer converts an iPhone HEIC photo, combines confidential business invoices into a PDF, decodes an authentication JWT token, or enters financial loan details into an online calculator, that sensitive data is dispatched over the public internet to third-party data centers.
      </p>
      <p>
        Best Converter completely changes this paradigm by engineering modern browser technologies—such as the HTML5 File API, Web Workers, Canvas 2D rendering, PDF-lib binary manipulation, and Web Cryptography (SubtleCrypto)—directly into lightweight client-side applications. Because execution occurs exclusively inside your device memory, you benefit from instantaneous zero-latency responses, zero monthly subscription paywalls, and uncompromising privacy compliance (GDPR, CCPA, and HIPAA friendly).
      </p>
      <p>
        Our algorithms operate completely offline once the page has loaded. Whether you are generating high-density vector QR codes for marketing campaigns, extracting specific pages from large multi-gigabyte PDF contracts, computing complex amortization schedules for mortgage planning, or testing typing speed, your data remains safely in your hands. You can verify this architecture in real time by opening your browser Network inspector (press F12) and observing that zero file payloads leave your computer.
      </p>
    </section>
  </div>

  <script is:inline>
    const searchInput = document.getElementById('tool-search-input');
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const q = e.target.value.toLowerCase().trim();
        const cards = document.querySelectorAll('.tool-card');
        cards.forEach((card) => {
          const text = card.textContent.toLowerCase();
          if (!q || text.includes(q)) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    }
  </script>
</Layout>