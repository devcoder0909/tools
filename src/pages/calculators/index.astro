---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getIndexableTools } from '../../registry';
import { siteConfig } from '../../config/site';

const tools = getIndexableTools();
const financeTools = tools.filter((t) => t.kind === 'finance');
const mathCalculators = tools.filter((t) => t.kind === 'calculator');
const textAndDevTools = tools.filter((t) => t.kind === 'text' || t.kind === 'developer');

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Calculators', href: '/calculators/' },
];
---

<Layout
  title={`Online Calculators for Age, Tips, Percentages and Loans | ${siteConfig.brand}`}
  description="Find a calculator by task. Check age on a specific date, split a restaurant bill, work out a sale price or percentage change, and estimate monthly loan payments."
  canonical={`${siteConfig.url}/calculators/`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mb-10 text-center sm:text-left">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-3 tracking-tight">
        Free Online Calculators
      </h1>
      <p class="text-base text-slate-600 max-w-3xl leading-relaxed">
        Choose a calculator for the question you want to answer.
      </p>

      <nav aria-label="Everyday calculator tasks" class="mt-5 grid max-w-4xl gap-3 text-left sm:grid-cols-2">
        {[
          { slug: 'percentage-increase-calculator', task: 'Calculate percentage increase or growth', detail: 'Find percent change, price raises, or inflation between two values.' },
          { slug: 'percentage-difference-calculator', task: 'Compare two numbers by percentage', detail: 'Find relative percentage difference between two positive values.' },
          { slug: 'tip-calculator', task: 'Calculate a tip and split the bill', detail: 'See the tip, total and amount each guest owes.' },
          { slug: 'haircut-tip-calculator', task: 'Calculate haircut and salon tip', detail: 'Standard 15% to 25% tips for barbers, stylists, and assistants.' },
          { slug: 'body-fat-percentage-calculator', task: 'Calculate body fat percentage', detail: 'Measure body composition using the US Army and Navy method.' },
          { slug: 'age-calculator', task: 'Calculate age on a specific date', detail: 'Enter a birthday and the date you want to check.' },
          { slug: 'percentage-calculator', task: 'Calculate a percentage or percent change', detail: 'Find a share of a total or compare two values.' },
          { slug: 'discount-calculator', task: 'Find the sale price after a discount', detail: 'Check the savings and total after optional sales tax.' },
        ].map(({ slug, task, detail }) => (
          <a href={`/${slug}/`} class="rounded-xl border border-slate-200 p-4 hover:border-emerald-600 focus-visible:outline-emerald-600">
            <strong class="block text-emerald-800">{task}</strong>
            <span class="text-sm text-slate-600">{detail}</span>
          </a>
        ))}
      </nav>
    </div>

    <!-- Financial & Investment Calculators -->
    <section class="mb-14">
      <div class="flex items-center justify-between mb-4 border-b border-slate-200/80 pb-2">
        <h2 class="text-2xl font-bold text-slate-900">
          Financial & Investment Calculators
        </h2>
        <span class="text-xs font-semibold text-slate-500">Wealth, Loan & Exchange Calculations</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {financeTools.map((calc) => (
          <a
            href={`/${calc.slug}/`}
            class="p-5 rounded-2xl border border-slate-200/90 bg-white hover:border-emerald-500 hover:shadow-card transition-all duration-200 group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-bold uppercase px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 group-hover:bg-emerald-50 group-hover:text-emerald-800 transition-colors mb-2 inline-block">Finance</span>
              <h3 class="font-bold text-slate-900 group-hover:text-emerald-700 mb-1 text-base transition-colors">
                {calc.name}
              </h3>
              <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                {calc.description}
              </p>
            </div>
            <div class="mt-3.5 text-xs font-semibold text-emerald-700 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Calculate now &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Everyday Math & Scientific Calculators -->
    <section class="mb-14">
      <div class="flex items-center justify-between mb-4 border-b border-slate-200/80 pb-2">
        <h2 class="text-2xl font-bold text-slate-900">
          Math, Science &amp; Life Calculators
        </h2>
        <span class="text-xs font-semibold text-slate-500">Accurate Real-Time Math Engines</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {mathCalculators.map((calc) => (
          <a
            href={`/${calc.slug}/`}
            class="p-5 rounded-2xl border border-slate-200/90 bg-white hover:border-emerald-500 hover:shadow-card transition-all duration-200 group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-bold uppercase px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 group-hover:bg-emerald-50 group-hover:text-emerald-800 transition-colors mb-2 inline-block">Math</span>
              <h3 class="font-bold text-slate-900 group-hover:text-emerald-700 mb-1 text-base transition-colors">
                {calc.name}
              </h3>
              <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                {calc.description}
              </p>
            </div>
            <div class="mt-3.5 text-xs font-semibold text-emerald-700 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Calculate now &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Developer & Text Analysis Utilities -->
    <section class="mb-14">
      <div class="flex items-center justify-between mb-4 border-b border-slate-200/80 pb-2">
        <h2 class="text-2xl font-bold text-slate-900">
          Developer Utilities &amp; Text Analysis
        </h2>
        <span class="text-xs font-semibold text-slate-500">Offline Formatting, Metrics &amp; Diagnostics</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {textAndDevTools.map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="p-5 rounded-2xl border border-slate-200/90 bg-white hover:border-emerald-500 hover:shadow-card transition-all duration-200 group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-bold uppercase px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 group-hover:bg-emerald-50 group-hover:text-emerald-800 transition-colors mb-2 inline-block">Developer</span>
              <h3 class="font-bold text-slate-900 group-hover:text-emerald-700 mb-1 text-base transition-colors">
                {tool.name}
              </h3>
              <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                {tool.description}
              </p>
            </div>
            <div class="mt-3.5 text-xs font-semibold text-emerald-700 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Inspect utility &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- European & Multilingual Calculators -->
    <section class="mb-14">
      <div class="flex items-center justify-between mb-4 border-b border-slate-200/80 pb-2">
        <h2 class="text-2xl font-bold text-slate-900">
          European &amp; Multilingual Calculators
        </h2>
        <span class="text-xs font-semibold text-slate-500">DE, ES, FR, PL, IT</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <a href="/de/trinkgeld-rechner/" class="p-5 rounded-2xl border border-slate-200/90 bg-white hover:border-emerald-500 hover:shadow-card transition-all duration-200 group flex flex-col justify-between">
          <div>
            <span class="text-2xs font-bold uppercase px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-800 mb-2 inline-block">Deutsch (DE)</span>
            <h3 class="font-bold text-slate-900 group-hover:text-emerald-700 mb-1 text-base transition-colors">Trinkgeld Rechner</h3>
            <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">Trinkgeld berechnen und Restaurantrechnung fair aufteilen.</p>
          </div>
          <div class="mt-3.5 text-xs font-semibold text-emerald-700 flex items-center gap-1 group-hover:translate-x-1 transition-transform">Öffnen &rarr;</div>
        </a>
        <a href="/es/calculadora-de-propinas/" class="p-5 rounded-2xl border border-slate-200/90 bg-white hover:border-emerald-500 hover:shadow-card transition-all duration-200 group flex flex-col justify-between">
          <div>
            <span class="text-2xs font-bold uppercase px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-800 mb-2 inline-block">Español (ES)</span>
            <h3 class="font-bold text-slate-900 group-hover:text-emerald-700 mb-1 text-base transition-colors">Calculadora de Propinas</h3>
            <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">Calcular propina y dividir la cuenta del restaurante por persona.</p>
          </div>
          <div class="mt-3.5 text-xs font-semibold text-emerald-700 flex items-center gap-1 group-hover:translate-x-1 transition-transform">Abrir &rarr;</div>
        </a>
        <a href="/fr/calculateur-de-pourboire/" class="p-5 rounded-2xl border border-slate-200/90 bg-white hover:border-emerald-500 hover:shadow-card transition-all duration-200 group flex flex-col justify-between">
          <div>
            <span class="text-2xs font-bold uppercase px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-800 mb-2 inline-block">Français (FR)</span>
            <h3 class="font-bold text-slate-900 group-hover:text-emerald-700 mb-1 text-base transition-colors">Calculateur de Pourboire</h3>
            <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">Calculer le pourboire et partager l'addition équitablement.</p>
          </div>
          <div class="mt-3.5 text-xs font-semibold text-emerald-700 flex items-center gap-1 group-hover:translate-x-1 transition-transform">Ouvrir &rarr;</div>
        </a>
        <a href="/pl/kalkulator-napiwkow/" class="p-5 rounded-2xl border border-slate-200/90 bg-white hover:border-emerald-500 hover:shadow-card transition-all duration-200 group flex flex-col justify-between">
          <div>
            <span class="text-2xs font-bold uppercase px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-800 mb-2 inline-block">Polski (PL)</span>
            <h3 class="font-bold text-slate-900 group-hover:text-emerald-700 mb-1 text-base transition-colors">Kalkulator Napiwków</h3>
            <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">Oblicz kwotę napiwku i podziel rachunek restauracyjny na osoby.</p>
          </div>
          <div class="mt-3.5 text-xs font-semibold text-emerald-700 flex items-center gap-1 group-hover:translate-x-1 transition-transform">Otwórz &rarr;</div>
        </a>
        <a href="/it/calcolo-mance/" class="p-5 rounded-2xl border border-slate-200/90 bg-white hover:border-emerald-500 hover:shadow-card transition-all duration-200 group flex flex-col justify-between">
          <div>
            <span class="text-2xs font-bold uppercase px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-800 mb-2 inline-block">Italiano (IT)</span>
            <h3 class="font-bold text-slate-900 group-hover:text-emerald-700 mb-1 text-base transition-colors">Calcolo Mance</h3>
            <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">Calcola la mancia e dividi il conto alla romana con precisione.</p>
          </div>
          <div class="mt-3.5 text-xs font-semibold text-emerald-700 flex items-center gap-1 group-hover:translate-x-1 transition-transform">Apri &rarr;</div>
        </a>
      </div>
    </section>

    <section class="my-8 max-w-3xl space-y-3 text-slate-700" aria-labelledby="choosing-calculator">
      <h2 id="choosing-calculator" class="text-xl font-bold text-slate-900">Which calculator fits my question?</h2>
      <p>For US staffing or project planning, look up <a class="underline" href="/date-difference-calculator/#us-working-days">working days by month in 2026 and 2027</a> to see how weekends and observed federal holidays affect the total.</p>
      <p>For an application, check your <a class="underline" href="/age-calculator/#article-how-old-will-i-be-on-a-cutoff-date">age on the cutoff date</a>. If you only know the year, <a class="underline" href="/age-calculator/#age-by-year">calculate age from a birth year</a>. For a project deadline, use the <a class="underline" href="/date-difference-calculator/">date difference calculator</a> to count the interval between two dates.</p>
      <p>If a price drops from $80 to $60, the reduction is 25%. If the values you’re comparing are already percentages, see how to calculate <a class="underline" href="/percentage-calculator/#article-what-is-the-difference-between-percent-change-and-percentage-points">percent change and percentage points</a>. If values grow over time, use the <a class="underline" href="/percentage-increase-calculator/">percentage increase calculator</a>. To compare two separate values against their midpoint, use the <a class="underline" href="/percentage-difference-calculator/">percentage difference calculator</a>.</p>
      <p>For a shared restaurant check, see how to tell <a class="underline" href="/tip-calculator/#article-is-the-suggested-tip-on-my-receipt-before-or-after-sales-tax">whether the suggested tip includes sales tax</a>. For grooming and salon services, consult the <a class="underline" href="/haircut-tip-calculator/">haircut tip calculator</a>.</p>
      <p>To assess personal fitness and body composition beyond scale weight, measure circumference with our <a class="underline" href="/body-fat-percentage-calculator/">body fat percentage calculator</a>.</p>
    </section>
  </div>
</Layout>
