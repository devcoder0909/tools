---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getIndexableTools } from '../../registry';
import { siteConfig } from '../../config/site';

const tools = getIndexableTools();
const financeTools = tools.filter((t) => t.kind === 'finance');
const mathCalculators = tools.filter((t) => t.kind === 'calculator');
const textAndDevTools = tools.filter((t) => t.kind === 'text' || t.kind === 'developer');

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Calculators', href: '/calculators/' },
];
---

<Layout
  title={`Online Calculators for Age, Tips, Percentages and Loans | ${siteConfig.brand}`}
  description="Find a calculator by task. Check age on a specific date, split a restaurant bill, work out a sale price or percentage change, and estimate monthly loan payments."
  canonical={`${siteConfig.url}/calculators/`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mb-10 text-center sm:text-left">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-3 tracking-tight">
        Free Online Calculators
      </h1>
      <p class="text-base text-slate-600 max-w-3xl leading-relaxed">
        Choose a calculator for the question you want to answer.
      </p>

      <nav aria-label="Everyday calculator tasks" class="mt-5 grid max-w-4xl gap-3 text-left sm:grid-cols-2">
        {[
          { slug: 'age-calculator', task: 'Calculate age on a specific date', detail: 'Enter a birthday and the date you want to check.' },
          { slug: 'tip-calculator', task: 'Calculate a tip and split the bill', detail: 'See the tip, total and amount each guest owes.' },
          { slug: 'percentage-calculator', task: 'Calculate a percentage or percent change', detail: 'Find a share of a total or compare two values.' },
          { slug: 'discount-calculator', task: 'Find the sale price after a discount', detail: 'Check the savings and total after optional sales tax.' },
        ].map(({ slug, task, detail }) => (
          <a href={`/${slug}/`} class="rounded-xl border border-slate-200 p-4 hover:border-emerald-600 focus-visible:outline-emerald-600">
            <strong class="block text-emerald-800">{task}</strong>
            <span class="text-sm text-slate-600">{detail}</span>
          </a>
        ))}
      </nav>
    </div>

    <!-- Financial & Investment Calculators -->
    <section class="mb-14">
      <div class="flex items-center justify-between mb-4 border-b border-slate-200/80 pb-2">
        <h2 class="text-2xl font-bold text-slate-900">
          Financial & Investment Calculators
        </h2>
        <span class="text-xs font-semibold text-slate-500">Wealth, Loan & Exchange Calculations</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {financeTools.map((calc) => (
          <a
            href={`/${calc.slug}/`}
            class="p-5 rounded-2xl border border-slate-200/90 bg-white hover:border-emerald-500 hover:shadow-card transition-all duration-200 group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-bold uppercase px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 group-hover:bg-emerald-50 group-hover:text-emerald-800 transition-colors mb-2 inline-block">Finance</span>
              <h3 class="font-bold text-slate-900 group-hover:text-emerald-700 mb-1 text-base transition-colors">
                {calc.name}
              </h3>
              <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                {calc.description}
              </p>
            </div>
            <div class="mt-3.5 text-xs font-semibold text-emerald-700 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Calculate now &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Everyday Math & Scientific Calculators -->
    <section class="mb-14">
      <div class="flex items-center justify-between mb-4 border-b border-slate-200/80 pb-2">
        <h2 class="text-2xl font-bold text-slate-900">
          Math, Science &amp; Life Calculators
        </h2>
        <span class="text-xs font-semibold text-slate-500">Accurate Real-Time Math Engines</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {mathCalculators.map((calc) => (
          <a
            href={`/${calc.slug}/`}
            class="p-5 rounded-2xl border border-slate-200/90 bg-white hover:border-emerald-500 hover:shadow-card transition-all duration-200 group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-bold uppercase px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 group-hover:bg-emerald-50 group-hover:text-emerald-800 transition-colors mb-2 inline-block">Math</span>
              <h3 class="font-bold text-slate-900 group-hover:text-emerald-700 mb-1 text-base transition-colors">
                {calc.name}
              </h3>
              <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                {calc.description}
              </p>
            </div>
            <div class="mt-3.5 text-xs font-semibold text-emerald-700 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Calculate now &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Developer & Text Analysis Utilities -->
    <section class="mb-14">
      <div class="flex items-center justify-between mb-4 border-b border-slate-200/80 pb-2">
        <h2 class="text-2xl font-bold text-slate-900">
          Developer Utilities &amp; Text Analysis
        </h2>
        <span class="text-xs font-semibold text-slate-500">Offline Formatting, Metrics &amp; Diagnostics</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {textAndDevTools.map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="p-5 rounded-2xl border border-slate-200/90 bg-white hover:border-emerald-500 hover:shadow-card transition-all duration-200 group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-bold uppercase px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 group-hover:bg-emerald-50 group-hover:text-emerald-800 transition-colors mb-2 inline-block">Developer</span>
              <h3 class="font-bold text-slate-900 group-hover:text-emerald-700 mb-1 text-base transition-colors">
                {tool.name}
              </h3>
              <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                {tool.description}
              </p>
            </div>
            <div class="mt-3.5 text-xs font-semibold text-emerald-700 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Inspect utility &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="my-8 max-w-3xl space-y-3 text-slate-700" aria-labelledby="choosing-calculator">
      <h2 id="choosing-calculator" class="text-xl font-bold text-slate-900">Which calculator fits my question?</h2>
      <p>For a birthday or application cutoff, choose the age calculator to see completed years, months and days. For a project deadline, use the <a class="underline" href="/date-difference-calculator/">date difference calculator</a> to count the interval between two dates.</p>
      <p>If a price drops from $80 to $60, use percentage change to find the 25% reduction. If the label already says 25% off, the discount calculator starts with the original $80 and gives you the $60 sale price.</p>
      <p>For a shared restaurant check, use the tip calculator to divide the total after gratuity. If your receipt lists both a subtotal and tax, the <a class="underline" href="/guides/restaurant-tipping-and-bill-splitting/">restaurant tipping and bill splitting guide</a> explains how to choose the amount to tip on.</p>
    </section>
  </div>
</Layout>