---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getAllTools } from '../../registry';
import { siteConfig } from '../../config/site';

const tools = getAllTools();
const financeTools = tools.filter((t) => t.kind === 'finance');
const mathCalculators = tools.filter((t) => t.kind === 'calculator');
const textAndDevTools = tools.filter((t) => t.kind === 'text' || t.kind === 'developer');

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Calculators', href: '/calculators/' },
];
---

<Layout
  title={`Free Online Calculators & Financial Tools | ${siteConfig.brand}`}
  description="Use our free online calculators for percentages, loan EMI, discounts, date differences, and financial planning. Fast, accurate, and completely private."
  canonical={`${siteConfig.url}/calculators/`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mb-10 text-center sm:text-left">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-3 tracking-tight">
        Free Online Calculators &amp; Financial Utilities
      </h1>
      <p class="text-base text-slate-600 max-w-3xl leading-relaxed">
        Perform instant mathematical and financial calculations with our free online calculators. Get verified formulas, step-by-step math breakdowns, zero intrusive ads, and complete privacy directly inside your browser.
      </p>

      <figure class="my-6 p-5 rounded-2xl bg-white border border-slate-200/90 shadow-card text-center max-w-3xl">
        <img
          src="/images/tools/emi-calculator-infographic.svg"
          alt="Free Online Calculators Mathematical Formula Matrix and Financial Amortization Diagram"
          width="720"
          height="360"
          class="max-w-full h-auto mx-auto rounded-xl"
          loading="lazy"
        />
        <figcaption class="mt-2.5 text-xs text-slate-500 font-medium">
          <strong>Figure:</strong> Amortization formulas and compound growth curves for ZixTool free online calculators.
        </figcaption>
      </figure>
    </div>

    <!-- Financial & Investment Calculators -->
    <section class="mb-14">
      <div class="flex items-center justify-between mb-4 border-b border-slate-200/80 pb-2">
        <h2 class="text-2xl font-bold text-slate-900">
          Financial & Investment Calculators
        </h2>
        <span class="text-xs font-semibold text-slate-500">Wealth, Loan & Exchange Calculations</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {financeTools.map((calc) => (
          <a
            href={`/${calc.slug}/`}
            class="p-5 rounded-2xl border border-slate-200/90 bg-white hover:border-emerald-500 hover:shadow-card transition-all duration-200 group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-bold uppercase px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 group-hover:bg-emerald-50 group-hover:text-emerald-800 transition-colors mb-2 inline-block">Finance</span>
              <h3 class="font-bold text-slate-900 group-hover:text-emerald-700 mb-1 text-base transition-colors">
                {calc.name}
              </h3>
              <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                {calc.description}
              </p>
            </div>
            <div class="mt-3.5 text-xs font-semibold text-emerald-700 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Calculate now &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Everyday Math & Scientific Calculators -->
    <section class="mb-14">
      <div class="flex items-center justify-between mb-4 border-b border-slate-200/80 pb-2">
        <h2 class="text-2xl font-bold text-slate-900">
          Math, Science &amp; Life Calculators
        </h2>
        <span class="text-xs font-semibold text-slate-500">Accurate Real-Time Math Engines</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {mathCalculators.map((calc) => (
          <a
            href={`/${calc.slug}/`}
            class="p-5 rounded-2xl border border-slate-200/90 bg-white hover:border-emerald-500 hover:shadow-card transition-all duration-200 group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-bold uppercase px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 group-hover:bg-emerald-50 group-hover:text-emerald-800 transition-colors mb-2 inline-block">Math</span>
              <h3 class="font-bold text-slate-900 group-hover:text-emerald-700 mb-1 text-base transition-colors">
                {calc.name}
              </h3>
              <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                {calc.description}
              </p>
            </div>
            <div class="mt-3.5 text-xs font-semibold text-emerald-700 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Calculate now &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Developer & Text Analysis Utilities -->
    <section class="mb-14">
      <div class="flex items-center justify-between mb-4 border-b border-slate-200/80 pb-2">
        <h2 class="text-2xl font-bold text-slate-900">
          Developer Utilities &amp; Text Analysis
        </h2>
        <span class="text-xs font-semibold text-slate-500">Offline Formatting, Metrics &amp; Diagnostics</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {textAndDevTools.map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="p-5 rounded-2xl border border-slate-200/90 bg-white hover:border-emerald-500 hover:shadow-card transition-all duration-200 group flex flex-col justify-between"
          >
            <div>
              <span class="text-2xs font-bold uppercase px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 group-hover:bg-emerald-50 group-hover:text-emerald-800 transition-colors mb-2 inline-block">Developer</span>
              <h3 class="font-bold text-slate-900 group-hover:text-emerald-700 mb-1 text-base transition-colors">
                {tool.name}
              </h3>
              <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                {tool.description}
              </p>
            </div>
            <div class="mt-3.5 text-xs font-semibold text-emerald-700 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Inspect utility &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- In-depth Mathematical Architecture Article for SEO -->
    <article class="prose prose-slate max-w-none text-slate-700 space-y-4 my-8 text-sm sm:text-base leading-relaxed bg-slate-50 border border-slate-200/90 rounded-2xl p-6 sm:p-8 shadow-card">
      <h2 class="text-xl font-bold text-slate-900">Why Use Our Free Online Calculators?</h2>
      <p>
        Everyday math and finance should be simple and fast. Whether you need an EMI calculator, age tool, or discount finder, you want instant answers. You do not want slow pages or intrusive ads.
      </p>
      <p>
        Every calculator on {siteConfig.brand} runs directly inside your web browser. This means results update on every keystroke. There is zero delay and zero network lag. Because your data stays in your device RAM, your numbers remain private.
      </p>
      <p>
        Our free online calculators use verified formulas. Loan tools use standard reducing balance math. Percentage and date tools handle leap years and decimal rounding cleanly. You always get accurate results you can trust.
      </p>
      <h3 class="text-lg font-bold text-slate-900 mt-6 mb-2">Key Categories Covered</h3>
      <ul class="list-disc pl-5 space-y-2">
        <li><strong>Financial Tools:</strong> Compute loan payments, compound interest growth, and discount savings for personal budget planning.</li>
        <li><strong>Everyday Math:</strong> Calculate percentages, date differences, chronological age, and aspect ratios with step-by-step clarity.</li>
        <li><strong>Developer Utilities:</strong> Format JSON, validate data payloads, encode URLs, and generate hashes safely on your machine.</li>
      </ul>
      <h3 class="text-lg font-bold text-slate-900 mt-6 mb-2">Privacy &amp; Precision First</h3>
      <p>
        Traditional websites send your figures to remote cloud servers to compute results. Our free online calculators do all the heavy lifting locally on your phone or laptop. No numbers are logged, no tracking cookies are set, and your calculations remain 100% confidential.
      </p>
      <h3 class="text-lg font-bold text-slate-900 mt-6 mb-2">Completely Free &amp; Offline Ready</h3>
      <p>
        Every utility here is completely free with no limits, paywalls, or accounts needed. Because our free online calculators run locally using modern web standards, you can even use them offline when travelling without an active internet connection.
      </p>
      <p>
        Use our free online calculators on your phone, tablet, or desktop. Plan a loan, balance your budget, or count dates with confidence.
      </p>
    </article>
  </div>
</Layout>