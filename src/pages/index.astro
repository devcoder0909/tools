---
import Layout from '../layouts/Layout.astro';
import HomeConverterShell from '../components/HomeConverterShell';
import { siteConfig } from '../config/site';
import { getAllTools, getFormatHubs } from '../registry';

const allTools = getAllTools();
const converters = allTools.filter((t) => t.kind === 'converter');
const pdfTools = allTools.filter((t) => t.kind === 'pdf');
const calculators = allTools.filter((t) => t.kind === 'finance' || t.kind === 'calculator');
const generatorsAndMedia = allTools.filter((t) => t.kind === 'generator' || t.kind === 'media' || t.kind === 'developer' || t.kind === 'text');
const formatHubs = getFormatHubs();

// Flagship Tier 1 featured tools
const featuredSlugs = [
  'qr-code-generator',
  'merge-pdf',
  'password-generator',
  'emi-calculator',
  'split-pdf',
  'currency-converter',
  'scientific-calculator',
  'compress-pdf',
  'text-to-speech',
  'bmi-calculator',
  'screen-recorder',
  'jwt-decoder',
];
const featuredTools = featuredSlugs
  .map((slug) => allTools.find((t) => t.slug === slug))
  .filter(Boolean);

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.brand,
  url: siteConfig.url,
  description: siteConfig.description,
};

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.brand,
  url: siteConfig.url,
  logo: `${siteConfig.url}/og-image.png`,
  sameAs: [
    'https://github.com/devcoder0909/tools',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    email: siteConfig.contactEmail,
    contactType: 'customer support',
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Are my files uploaded to any server when using Best Converter?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Best Converter operates 100% client-side inside your browser memory (RAM). Files are decoded and processed locally using HTML5 File API, WebAssembly, and Canvas. No files or personal data are ever uploaded or transmitted across the network.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is there a file size limit for converting images and PDFs?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Because processing happens entirely on your local CPU and RAM rather than remote cloud servers, there are no artificial file size paywalls or queue restrictions. You can process large files as long as your device has available RAM.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I use Best Converter tools offline without an active internet connection?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Best Converter includes an integrated Progressive Web App (PWA) Service Worker. Once loaded in your browser, the utility algorithms are cached locally, allowing you to convert files, calculate financial models, and format data completely offline.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does client-side PDF merging and splitting work securely?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We utilize WebAssembly and client-side JavaScript PDF parsing engines to assemble binary PDF streams directly in your browser. Pages are extracted and merged without third-party server involvement, ensuring total privacy for sensitive documents.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is Best Converter free for commercial and personal use?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. All 50+ file converters, financial calculators, and media utilities are 100% free with no registration, no subscription paywalls, and no hidden usage tiers.',
      },
    },
  ],
};
---

<Layout
  title={`${siteConfig.brand} - Free Private Online File Converters`}
  description="Fast, private client-side file converters, PDF tools, and calculators. Convert images, merge PDFs, and calculate EMIs offline without uploads."
  canonical={`${siteConfig.url}/`}
  jsonLd={[websiteJsonLd, organizationJsonLd, faqJsonLd]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <!-- Hero Section -->
    <header class="text-center max-w-3xl mx-auto mb-8">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800 mb-4">
        100% Client-Side Privacy • Zero Server Uploads
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-gray-900 tracking-tight mb-4">
        Free In-Browser Converters & Calculators
      </h1>
      <p class="text-base sm:text-lg text-gray-600 leading-relaxed">
        Convert images, merge PDFs, generate QR codes, and calculate loan EMIs directly inside your device memory. Your files and private data never leave your browser.
      </p>
    </header>

    <!-- Working Universal Tool Above the Fold -->
    <HomeConverterShell client:load />

    <!-- Popular Flagship Utilities -->
    <section class="mb-16" aria-labelledby="featured-heading">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 id="featured-heading" class="text-2xl font-bold text-gray-900">
            Featured Global Utilities
          </h2>
          <p class="text-sm text-gray-500">Highest-demand tools engineered for instantaneous client-side performance.</p>
        </div>
        <a href="/tools/" class="text-sm font-semibold text-green-600 hover:underline">
          View all 50+ tools &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {featuredTools.map((tool) => (
          <a
            href={`/${tool!.slug}/`}
            class="p-4 rounded-xl border border-gray-200 bg-white hover:border-green-500 hover:shadow-xs transition group flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-2xs font-bold uppercase px-2 py-0.5 rounded bg-gray-100 text-gray-700">
                  {tool!.kind}
                </span>
                <span class="text-green-600 text-xs opacity-0 group-hover:opacity-100 transition-opacity">
                  &rarr;
                </span>
              </div>
              <h3 class="font-bold text-gray-900 group-hover:text-green-600 text-sm sm:text-base mb-1">
                {tool!.name}
              </h3>
              <p class="text-xs text-gray-500 line-clamp-2">
                {tool!.description}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- PDF & Document Utilities -->
    <section class="mb-16" aria-labelledby="pdf-heading">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 id="pdf-heading" class="text-2xl font-bold text-gray-900">
            PDF & Document Utilities
          </h2>
          <p class="text-sm text-gray-500">Merge multiple documents, extract page ranges, and compress PDFs offline.</p>
        </div>
        <a href="/tools/#pdf" class="text-sm font-semibold text-green-600 hover:underline">
          All PDF tools &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {pdfTools.map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="p-5 rounded-xl border border-gray-200 bg-white hover:border-red-500 hover:shadow-xs transition group"
          >
            <div class="flex items-center justify-between mb-2">
              <span class="text-2xs font-semibold px-2 py-0.5 rounded bg-red-50 text-red-700 uppercase">
                PDF
              </span>
              <span class="text-red-600 opacity-0 group-hover:opacity-100 transition-opacity">
                &rarr;
              </span>
            </div>
            <h3 class="font-bold text-gray-900 group-hover:text-red-600 text-base mb-1">
              {tool.name}
            </h3>
            <p class="text-xs text-gray-500 line-clamp-2">
              {tool.description}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Image Converters Grid -->
    <section class="mb-16" aria-labelledby="converters-heading">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 id="converters-heading" class="text-2xl font-bold text-gray-900">
            Image Converters & Compression
          </h2>
          <p class="text-sm text-gray-500">Universal formats, target-size optimization, and batch processing.</p>
        </div>
        <a href="/tools/#converters" class="text-sm font-semibold text-green-600 hover:underline">
          View all converters &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {converters.slice(0, 9).map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="p-5 rounded-xl border border-gray-200 bg-white hover:border-green-500 hover:shadow-xs transition group"
          >
            <div class="flex items-center justify-between mb-2">
              <span class="text-2xs font-semibold px-2 py-0.5 rounded bg-gray-100 text-gray-700 uppercase">
                {tool.slug.includes('compress') ? 'Compress' : 'Convert'}
              </span>
              <span class="text-green-600 opacity-0 group-hover:opacity-100 transition-opacity">
                &rarr;
              </span>
            </div>
            <h3 class="font-bold text-gray-900 group-hover:text-green-600 text-base mb-1">
              {tool.name}
            </h3>
            <p class="text-xs text-gray-500 line-clamp-2">
              {tool.description}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Calculators & Financial Tools Grid -->
    <section class="mb-16" aria-labelledby="calculators-heading">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 id="calculators-heading" class="text-2xl font-bold text-gray-900">
            Calculators & Financial Utilities
          </h2>
          <p class="text-sm text-gray-500">Instant calculations, compound interest schedules, and currency rates.</p>
        </div>
        <a href="/calculators/" class="text-sm font-semibold text-green-600 hover:underline">
          View all calculators &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        {calculators.slice(0, 8).map((calc) => (
          <a
            href={`/${calc.slug}/`}
            class="p-5 rounded-xl border border-gray-200 bg-white hover:border-emerald-500 hover:shadow-xs transition group"
          >
            <span class="text-2xs font-semibold px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 uppercase mb-2 inline-block">
              {calc.kind}
            </span>
            <h3 class="font-bold text-gray-900 group-hover:text-emerald-600 text-base mb-1">
              {calc.name}
            </h3>
            <p class="text-xs text-gray-500 line-clamp-2">
              {calc.description}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Generators & Media Grid -->
    <section class="mb-16" aria-labelledby="generators-heading">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 id="generators-heading" class="text-2xl font-bold text-gray-900">
            Generators & Media Utilities
          </h2>
          <p class="text-sm text-gray-500">Vector QR codes, secure passwords, screen recording, and speech synthesis.</p>
        </div>
        <a href="/tools/#generators" class="text-sm font-semibold text-green-600 hover:underline">
          All utilities &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        {generatorsAndMedia.map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="p-5 rounded-xl border border-gray-200 bg-white hover:border-purple-500 hover:shadow-xs transition group"
          >
            <span class="text-2xs font-semibold px-2 py-0.5 rounded bg-purple-50 text-purple-700 uppercase mb-2 inline-block">
              {tool.kind}
            </span>
            <h3 class="font-bold text-gray-900 group-hover:text-purple-600 text-base mb-1">
              {tool.name}
            </h3>
            <p class="text-xs text-gray-500 line-clamp-2">
              {tool.description}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Format Guides Hub -->
    <section class="mb-16" aria-labelledby="formats-heading">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 id="formats-heading" class="text-2xl font-bold text-gray-900">
            Image Format Guides & Specifications
          </h2>
          <p class="text-sm text-gray-500">Honest compression benchmarks, browser support tables, and format trade-offs.</p>
        </div>
        <a href="/formats/" class="text-sm font-semibold text-green-600 hover:underline">
          All formats &rarr;
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
        {formatHubs.map((fmt) => (
          <a
            href={`/formats/${fmt.id}/`}
            class="p-4 rounded-lg border border-gray-200 bg-gray-50 hover:bg-white hover:border-green-500 transition text-center group"
          >
            <span class="block font-mono font-bold text-lg text-gray-900 group-hover:text-green-600">
              {fmt.extension.toUpperCase()}
            </span>
            <span class="text-xs text-gray-500">
              {fmt.name}
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Privacy & Verification Explainer with Architectural Diagram -->
    <section class="bg-gray-50 border border-gray-200 rounded-2xl p-6 sm:p-10 mb-16" aria-labelledby="architecture-heading">
      <div class="max-w-4xl mx-auto">
        <h2 id="architecture-heading" class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4 text-center sm:text-left">
          The Zero-Upload Security Architecture
        </h2>
        <p class="text-sm sm:text-base text-gray-600 leading-relaxed mb-6">
          Traditional online file converters transmit your sensitive documents, bank statements, personal photos, and corporate contracts to remote third-party cloud servers. Once uploaded, those files sit on unknown hard drives, subject to data mining, security breaches, and retention policies.
        </p>

        <!-- Informative Vector Architecture Diagram -->
        <div class="my-8">
          <img
            src="/client-architecture.svg"
            alt="Best Converter client-side in-browser file processing and security architecture diagram"
            width="800"
            height="400"
            loading="eager"
            decoding="async"
            class="w-full max-w-3xl mx-auto rounded-xl border border-gray-200 shadow-xs"
          />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-8">
          <div class="bg-white p-5 rounded-xl border border-gray-200">
            <h3 class="font-bold text-gray-900 text-base mb-2">1. Memory-Only Processing</h3>
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
              Files are streamed into isolated browser memory using the <a href="https://developer.mozilla.org/en-US/docs/Web/API/File_API" target="_blank" rel="noopener noreferrer" class="text-green-600 underline font-medium">MDN File API</a>. No temporary files are created on disk.
            </p>
          </div>
          <div class="bg-white p-5 rounded-xl border border-gray-200">
            <h3 class="font-bold text-gray-900 text-base mb-2">2. Hardware Acceleration</h3>
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
              Image re-encoding leverages the <a href="https://html.spec.whatwg.org/multipage/canvas.html" target="_blank" rel="noopener noreferrer" class="text-green-600 underline font-medium">HTML5 Canvas Specification</a> and GPU pipelines, converting images in milliseconds.
            </p>
          </div>
          <div class="bg-white p-5 rounded-xl border border-gray-200">
            <h3 class="font-bold text-gray-900 text-base mb-2">3. Cryptographic Privacy</h3>
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
              All entropy and hashing operations utilize the native <a href="https://www.w3.org/TR/WebCryptoAPI/" target="_blank" rel="noopener noreferrer" class="text-green-600 underline font-medium">W3C Web Cryptography API</a> for enterprise-grade cryptographic random values.
            </p>
          </div>
        </div>

        <p class="text-sm text-gray-600 leading-relaxed">
          <strong>Verify yourself:</strong> Open your browser Developer Tools (<kbd class="px-1.5 py-0.5 bg-gray-200 rounded text-xs font-mono">F12</kbd>), navigate to the <strong>Network</strong> tab, and convert any file. You will observe exactly zero file payload requests sent to external servers.
        </p>
      </div>
    </section>

    <!-- Comparison Table: Best Converter vs Cloud Converters -->
    <section class="mb-16" aria-labelledby="comparison-heading">
      <div class="max-w-4xl mx-auto">
        <h2 id="comparison-heading" class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4 text-center sm:text-left">
          In-Browser Processing vs Traditional Cloud Converters
        </h2>
        <p class="text-sm sm:text-base text-gray-600 leading-relaxed mb-6">
          Compare how our client-side zero-upload engine outperforms conventional server-based conversion tools in speed, privacy, and reliability:
        </p>

        <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white">
          <table class="w-full text-left text-sm text-gray-600">
            <thead class="bg-gray-50 text-xs uppercase font-semibold text-gray-900 border-b border-gray-200">
              <tr>
                <th scope="col" class="px-6 py-4">Capability & Security Metric</th>
                <th scope="col" class="px-6 py-4 text-green-700 bg-green-50/50">Best Converter</th>
                <th scope="col" class="px-6 py-4 text-gray-500">Cloud-Based Tools (iLovePDF, etc.)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <tr>
                <th scope="row" class="px-6 py-4 font-semibold text-gray-900">File Transmission</th>
                <td class="px-6 py-4 font-medium text-green-700 bg-green-50/30">Zero (100% In-Browser RAM)</td>
                <td class="px-6 py-4 text-gray-500">Uploaded over network to cloud</td>
              </tr>
              <tr>
                <th scope="row" class="px-6 py-4 font-semibold text-gray-900">Conversion Latency</th>
                <td class="px-6 py-4 font-medium text-green-700 bg-green-50/30">Instantaneous (CPU/GPU local)</td>
                <td class="px-6 py-4 text-gray-500">Queued in server processing batch</td>
              </tr>
              <tr>
                <th scope="row" class="px-6 py-4 font-semibold text-gray-900">Data Breach Risk</th>
                <td class="px-6 py-4 font-medium text-green-700 bg-green-50/30">Impossible (No server copies)</td>
                <td class="px-6 py-4 text-gray-500">High (Stored on third-party disks)</td>
              </tr>
              <tr>
                <th scope="row" class="px-6 py-4 font-semibold text-gray-900">File Size Paywalls</th>
                <td class="px-6 py-4 font-medium text-green-700 bg-green-50/30">Unlimited (Bound only by RAM)</td>
                <td class="px-6 py-4 text-gray-500">Restricted (15MB - 50MB limits)</td>
              </tr>
              <tr>
                <th scope="row" class="px-6 py-4 font-semibold text-gray-900">Offline Operation</th>
                <td class="px-6 py-4 font-medium text-green-700 bg-green-50/30">Yes (PWA Service Worker)</td>
                <td class="px-6 py-4 text-gray-500">No (Requires constant internet)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Frequently Asked Questions (FAQ) -->
    <section class="mb-16" aria-labelledby="faq-heading">
      <div class="max-w-4xl mx-auto">
        <h2 id="faq-heading" class="text-2xl sm:text-3xl font-bold text-gray-900 mb-6 text-center sm:text-left">
          Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          <details class="group bg-white p-5 rounded-xl border border-gray-200 [&_summary::-webkit-details-marker]:hidden" open>
            <summary class="flex items-center justify-between cursor-pointer font-bold text-gray-900 text-base sm:text-lg">
              <span>Are my files uploaded to any server when using Best Converter?</span>
              <span class="ml-4 flex-shrink-0 text-gray-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-sm text-gray-600 leading-relaxed">
              No. Best Converter operates entirely inside your local web browser using client-side JavaScript, WebAssembly, and the HTML5 Canvas API. Files are decoded in your computer's RAM and never transmitted to our servers or any third-party infrastructure.
            </p>
          </details>

          <details class="group bg-white p-5 rounded-xl border border-gray-200 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between cursor-pointer font-bold text-gray-900 text-base sm:text-lg">
              <span>Is there a file size limit for converting images and PDFs?</span>
              <span class="ml-4 flex-shrink-0 text-gray-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-sm text-gray-600 leading-relaxed">
              There are no artificial file size limits or subscription paywalls. Because processing occurs on your local hardware rather than a shared server cluster, you can process large image batches and multi-page PDFs as long as your device has sufficient RAM.
            </p>
          </details>

          <details class="group bg-white p-5 rounded-xl border border-gray-200 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between cursor-pointer font-bold text-gray-900 text-base sm:text-lg">
              <span>Can I use Best Converter tools offline without an active internet connection?</span>
              <span class="ml-4 flex-shrink-0 text-gray-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-sm text-gray-600 leading-relaxed">
              Yes. Best Converter is engineered as a Progressive Web App (PWA) with offline Service Worker support. Once you open the application, all necessary conversion libraries and UI components are cached in your browser storage, enabling full offline functionality on flights, trains, or low-connectivity zones.
            </p>
          </details>

          <details class="group bg-white p-5 rounded-xl border border-gray-200 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between cursor-pointer font-bold text-gray-900 text-base sm:text-lg">
              <span>How does client-side PDF merging and splitting work securely?</span>
              <span class="ml-4 flex-shrink-0 text-gray-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-sm text-gray-600 leading-relaxed">
              We compile high-performance PDF manipulation libraries into client-side WebAssembly and modern JavaScript. When you select multiple documents, the binary PDF byte structures are unpacked and recombined into a new Blob URL entirely in your browser memory, avoiding cloud intermediaries completely.
            </p>
          </details>

          <details class="group bg-white p-5 rounded-xl border border-gray-200 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between cursor-pointer font-bold text-gray-900 text-base sm:text-lg">
              <span>Is Best Converter free for commercial and personal use?</span>
              <span class="ml-4 flex-shrink-0 text-gray-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-sm text-gray-600 leading-relaxed">
              Yes. All 50+ utilities across image conversion, PDF editing, financial calculations, and text generation are 100% free with no account creation, no email requirements, and no watermarks.
            </p>
          </details>
        </div>
      </div>
    </section>
  </div>
</Layout>
