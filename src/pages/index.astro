---
import Layout from '../layouts/Layout.astro';
import HomeConverterShell from '../components/HomeConverterShell';
import { siteConfig } from '../config/site';
import { getAllTools, getFormatHubs } from '../registry';

const allTools = getAllTools();
const converters = allTools.filter((t) => t.kind === 'converter');
const pdfTools = allTools.filter((t) => t.kind === 'pdf');
const calculators = allTools.filter((t) => t.kind === 'finance' || t.kind === 'calculator');
const generatorsAndMedia = allTools.filter((t) => t.kind === 'generator' || t.kind === 'media' || t.kind === 'developer' || t.kind === 'text');
const formatHubs = getFormatHubs();

// Flagship Tier 1 featured tools (highest search volume)
const featuredSlugs = [
  'image-compressor',
  'compress-image-to-20kb',
  'pdf-to-jpg',
  'merge-pdf',
  'qr-code-generator',
  'gst-calculator',
  'loan-calculator',
  'gpa-calculator',
  'color-picker',
  'aspect-ratio-calculator',
  'base64-encoder',
  'character-counter',
  'online-calculator',
  'pomodoro-timer',
  'lorem-ipsum-generator',
  'compress-pdf',
];
const featuredTools = featuredSlugs
  .map((slug) => allTools.find((t) => t.slug === slug))
  .filter(Boolean);

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.brand,
  url: siteConfig.url,
  description: '100% free online file converters, PDF editors, image compressors, and calculators.',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteConfig.url}/tools/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.brand,
  url: siteConfig.url,
  logo: `${siteConfig.url}/og-image.png`,
  sameAs: [
    'https://github.com/devcoder0909/tools',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    email: siteConfig.contactEmail,
    contactType: 'customer support',
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is Best Converter 100% free to use with no hidden limits?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Every tool on Best Converter is 100% free forever with no daily conversion quotas, no file size paywalls, no watermarks, and no sign-up or credit card required.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I compress an image to 20KB or a specific file size?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Use our Compress Image to 20KB tool or Universal Image Compressor. Simply upload your JPG, PNG, or WebP photo, select 20KB target size, and our adaptive compression algorithm shrinks the file size while preserving maximum visual sharpness.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are my uploaded files and documents kept private and secure?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Best Converter processes your files directly inside your browser memory using WebAssembly and HTML5 Canvas. Your documents and photos are never uploaded to any remote server or stored in the cloud.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I merge or split PDF documents without installing software?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Our Merge PDF and Split PDF tools work instantly in any desktop or mobile browser. Drag and drop your PDF pages, reorder them, and download the merged document immediately.',
      },
    },
    {
      '@type': 'Question',
      name: 'What file formats can I convert online for free?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Best Converter supports all major formats including HEIC, JPG, PNG, WebP, AVIF, GIF, SVG, BMP, ICO, PDF, and EPUB. We also offer financial loan calculators, QR code generators, and text utilities.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does Best Converter add any watermarks to my converted files?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. All conversions, compressions, and generated QR codes are 100% clean with zero watermarks, brand logos, or quality degradation.',
      },
    },
  ],
};
---

<Layout
  title="Best Converter - Free Online File Converters & PDF Tools"
  description="100% free online file converters, PDF editors, image compressors, and calculators. Convert HEIC to JPG, merge PDFs, shrink photo sizes, and create QR codes."
  canonical={`${siteConfig.url}/`}
  jsonLd={[websiteJsonLd, organizationJsonLd, faqJsonLd]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <!-- Hero Section -->
    <header class="text-center max-w-3xl mx-auto mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-green-50 text-green-700 border border-green-200 mb-4">
        <span>⚡ 100% Free Forever</span>
        <span>•</span>
        <span>No Sign-Up or Daily Limits</span>
        <span>•</span>
        <span>No Watermarks</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-gray-900 tracking-tight mb-4">
        Free Online File Converters, PDF Tools & Calculators
      </h1>
      <p class="text-base sm:text-lg text-gray-600 leading-relaxed">
        Convert images, merge and compress PDFs, shrink photo file sizes, generate custom QR codes, and calculate loan EMIs instantly online. 100% free with no registration or limits.
      </p>
    </header>

    <!-- Working Universal Tool Above the Fold -->
    <HomeConverterShell client:load />

    <!-- Popular Flagship Utilities -->
    <section class="mb-16" aria-labelledby="featured-heading">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 id="featured-heading" class="text-2xl font-bold text-gray-900">
            Featured Online Utilities & Tools
          </h2>
          <p class="text-sm text-gray-500">Most popular free file converters, PDF editors, image compressors, and calculators.</p>
        </div>
        <a href="/tools/" class="text-sm font-semibold text-green-600 hover:underline">
          View all 70+ tools &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {featuredTools.map((tool) => (
          <a
            href={`/${tool!.slug}/`}
            class="p-4 rounded-xl border border-gray-200 bg-white hover:border-green-500 hover:shadow-xs transition group flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-2xs font-bold uppercase px-2 py-0.5 rounded bg-gray-100 text-gray-700">
                  {tool!.kind}
                </span>
                <span class="text-green-600 text-xs opacity-0 group-hover:opacity-100 transition-opacity">
                  &rarr;
                </span>
              </div>
              <h3 class="font-bold text-gray-900 group-hover:text-green-600 text-sm sm:text-base mb-1">
                {tool!.name}
              </h3>
              <p class="text-xs text-gray-500 line-clamp-2">
                {tool!.description}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- PDF & Document Utilities -->
    <section class="mb-16" aria-labelledby="pdf-heading">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 id="pdf-heading" class="text-2xl font-bold text-gray-900">
            Free PDF Tools & Document Editors
          </h2>
          <p class="text-sm text-gray-500">Merge multiple PDFs, split pages, compress file sizes, and extract text without limits.</p>
        </div>
        <a href="/tools/#pdf" class="text-sm font-semibold text-green-600 hover:underline">
          All PDF tools &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {pdfTools.map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="p-5 rounded-xl border border-gray-200 bg-white hover:border-red-500 hover:shadow-xs transition group"
          >
            <div class="flex items-center justify-between mb-2">
              <span class="text-2xs font-semibold px-2 py-0.5 rounded bg-red-50 text-red-700 uppercase">
                PDF
              </span>
              <span class="text-red-600 opacity-0 group-hover:opacity-100 transition-opacity">
                &rarr;
              </span>
            </div>
            <h3 class="font-bold text-gray-900 group-hover:text-red-600 text-base mb-1">
              {tool.name}
            </h3>
            <p class="text-xs text-gray-500 line-clamp-2">
              {tool.description}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Image Converters & Compression Grid -->
    <section class="mb-16" aria-labelledby="converters-heading">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 id="converters-heading" class="text-2xl font-bold text-gray-900">
            Image Converters & Photo Compression
          </h2>
          <p class="text-sm text-gray-500">Convert HEIC, JPG, PNG, WebP and shrink photo file sizes down to 20KB, 50KB, or 100KB.</p>
        </div>
        <a href="/tools/#converters" class="text-sm font-semibold text-green-600 hover:underline">
          View all converters &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {converters.slice(0, 9).map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="p-5 rounded-xl border border-gray-200 bg-white hover:border-green-500 hover:shadow-xs transition group"
          >
            <div class="flex items-center justify-between mb-2">
              <span class="text-2xs font-semibold px-2 py-0.5 rounded bg-gray-100 text-gray-700 uppercase">
                {tool.slug.includes('compress') ? 'Compress' : 'Convert'}
              </span>
              <span class="text-green-600 opacity-0 group-hover:opacity-100 transition-opacity">
                &rarr;
              </span>
            </div>
            <h3 class="font-bold text-gray-900 group-hover:text-green-600 text-base mb-1">
              {tool.name}
            </h3>
            <p class="text-xs text-gray-500 line-clamp-2">
              {tool.description}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Calculators & Financial Tools Grid -->
    <section class="mb-16" aria-labelledby="calculators-heading">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 id="calculators-heading" class="text-2xl font-bold text-gray-900">
            Calculators & Financial Tools
          </h2>
          <p class="text-sm text-gray-500">Calculate loan EMIs, mortgage payments, compound interest, BMI, and currency exchange rates.</p>
        </div>
        <a href="/calculators/" class="text-sm font-semibold text-green-600 hover:underline">
          View all calculators &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        {calculators.slice(0, 12).map((calc) => (
          <a
            href={`/${calc.slug}/`}
            class="p-5 rounded-xl border border-gray-200 bg-white hover:border-emerald-500 hover:shadow-xs transition group"
          >
            <span class="text-2xs font-semibold px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 uppercase mb-2 inline-block">
              {calc.kind}
            </span>
            <h3 class="font-bold text-gray-900 group-hover:text-emerald-600 text-base mb-1">
              {calc.name}
            </h3>
            <p class="text-xs text-gray-500 line-clamp-2">
              {calc.description}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Generators & Media Grid -->
    <section class="mb-16" aria-labelledby="generators-heading">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 id="generators-heading" class="text-2xl font-bold text-gray-900">
            Online Generators & Utility Tools
          </h2>
          <p class="text-sm text-gray-500">High-resolution QR code generator, character counter, online stopwatch, and secure passwords.</p>
        </div>
        <a href="/tools/#generators" class="text-sm font-semibold text-green-600 hover:underline">
          All utilities &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        {generatorsAndMedia.slice(0, 12).map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="p-5 rounded-xl border border-gray-200 bg-white hover:border-purple-500 hover:shadow-xs transition group"
          >
            <span class="text-2xs font-semibold px-2 py-0.5 rounded bg-purple-50 text-purple-700 uppercase mb-2 inline-block">
              {tool.kind}
            </span>
            <h3 class="font-bold text-gray-900 group-hover:text-purple-600 text-base mb-1">
              {tool.name}
            </h3>
            <p class="text-xs text-gray-500 line-clamp-2">
              {tool.description}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Format Guides Hub -->
    <section class="mb-16" aria-labelledby="formats-heading">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 id="formats-heading" class="text-2xl font-bold text-gray-900">
            Image Format Guides & Specifications
          </h2>
          <p class="text-sm text-gray-500">Detailed format comparisons, compression benchmarks, and compatibility guides.</p>
        </div>
        <a href="/formats/" class="text-sm font-semibold text-green-600 hover:underline">
          All formats &rarr;
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
        {formatHubs.map((fmt) => (
          <a
            href={`/formats/${fmt.id}/`}
            class="p-4 rounded-lg border border-gray-200 bg-gray-50 hover:bg-white hover:border-green-500 transition text-center group"
          >
            <span class="block font-mono font-bold text-lg text-gray-900 group-hover:text-green-600">
              {fmt.extension.toUpperCase()}
            </span>
            <span class="text-xs text-gray-500">
              {fmt.name}
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Why Choose Best Converter (Consumer Value Proposition) -->
    <section class="bg-gray-50 border border-gray-200 rounded-2xl p-6 sm:p-10 mb-16" aria-labelledby="why-heading">
      <div class="max-w-4xl mx-auto">
        <h2 id="why-heading" class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4 text-center sm:text-left">
          Why Millions of Users Choose Best Converter for Daily Tools
        </h2>
        <p class="text-sm sm:text-base text-gray-600 leading-relaxed mb-8">
          Unlike restrictive cloud platforms that throttle your conversions behind subscription paywalls and daily limits, Best Converter delivers instant, unlimited, and watermark-free utilities right in your browser.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-2xs">
            <div class="text-2xl mb-2">⚡</div>
            <h3 class="font-bold text-gray-900 text-base mb-2">Instant Speed & No Queues</h3>
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
              Files process directly on your device CPU and GPU using WebAssembly. No waiting in cloud server queues or slow download links.
            </p>
          </div>
          <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-2xs">
            <div class="text-2xl mb-2">🚀</div>
            <h3 class="font-bold text-gray-900 text-base mb-2">Unlimited Free Conversions</h3>
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
              Convert as many files, PDFs, and images as you need every single day. No 3-file daily caps and no artificial file size paywalls.
            </p>
          </div>
          <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-2xs">
            <div class="text-2xl mb-2">🎯</div>
            <h3 class="font-bold text-gray-900 text-base mb-2">Zero Watermarks Added</h3>
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
              Export pristine, high-resolution PDFs, images, and QR codes. We never stamp logos or brand banners onto your converted files.
            </p>
          </div>
          <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-2xs">
            <div class="text-2xl mb-2">📱</div>
            <h3 class="font-bold text-gray-900 text-base mb-2">Works on All Devices</h3>
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
              Seamlessly compatible with Windows, macOS, iPhone, iPad, Android, and Linux. No software installation or app store downloads needed.
            </p>
          </div>
          <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-2xs">
            <div class="text-2xl mb-2">🔒</div>
            <h3 class="font-bold text-gray-900 text-base mb-2">Complete Device Privacy</h3>
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
              Your files and photos remain on your personal device. Data is decoded locally in browser memory and never transmitted to remote servers.
            </p>
          </div>
          <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-2xs">
            <div class="text-2xl mb-2">✨</div>
            <h3 class="font-bold text-gray-900 text-base mb-2">No Sign-Up or Credit Card</h3>
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
              Start working immediately without creating an account, confirming an email address, or inputting payment information.
            </p>
          </div>
        </div>

        <p class="text-sm text-gray-600 leading-relaxed">
          Need official technical details? Read our guides on the <a href="https://developer.mozilla.org/en-US/docs/Web/API/File_API" target="_blank" rel="noopener noreferrer" class="text-green-600 underline font-medium">MDN File API</a> and the <a href="https://html.spec.whatwg.org/multipage/canvas.html" target="_blank" rel="noopener noreferrer" class="text-green-600 underline font-medium">HTML5 Canvas Specification</a>.
        </p>
      </div>
    </section>

    <!-- Comparison Table: Best Converter vs Competitors -->
    <section class="mb-16" aria-labelledby="comparison-heading">
      <div class="max-w-4xl mx-auto">
        <h2 id="comparison-heading" class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4 text-center sm:text-left">
          Best Converter vs Competitor Platforms (iLovePDF, Smallpdf, CloudConvert)
        </h2>
        <p class="text-sm sm:text-base text-gray-600 leading-relaxed mb-6">
          See why users switch to Best Converter for daily image conversions, PDF editing, and calculations:
        </p>

        <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white">
          <table class="w-full text-left text-sm text-gray-600">
            <thead class="bg-gray-50 text-xs uppercase font-semibold text-gray-900 border-b border-gray-200">
              <tr>
                <th scope="col" class="px-6 py-4">Key Feature</th>
                <th scope="col" class="px-6 py-4 text-green-700 bg-green-50/50">Best Converter</th>
                <th scope="col" class="px-6 py-4 text-gray-500">iLovePDF / Smallpdf Free Tier</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <tr>
                <th scope="row" class="px-6 py-4 font-semibold text-gray-900">Daily Conversion Limit</th>
                <td class="px-6 py-4 font-medium text-green-700 bg-green-50/30">100% Unlimited</td>
                <td class="px-6 py-4 text-gray-500">Limited to 2–3 tasks per day</td>
              </tr>
              <tr>
                <th scope="row" class="px-6 py-4 font-semibold text-gray-900">Account / Sign-Up</th>
                <td class="px-6 py-4 font-medium text-green-700 bg-green-50/30">None Required</td>
                <td class="px-6 py-4 text-gray-500">Forced email registration after 1 file</td>
              </tr>
              <tr>
                <th scope="row" class="px-6 py-4 font-semibold text-gray-900">Watermarks Added</th>
                <td class="px-6 py-4 font-medium text-green-700 bg-green-50/30">Zero (Clean output)</td>
                <td class="px-6 py-4 text-gray-500">Watermarks on several free tools</td>
              </tr>
              <tr>
                <th scope="row" class="px-6 py-4 font-semibold text-gray-900">Processing Speed</th>
                <td class="px-6 py-4 font-medium text-green-700 bg-green-50/30">Instant (Local device)</td>
                <td class="px-6 py-4 text-gray-500">Slow server upload & queue wait</td>
              </tr>
              <tr>
                <th scope="row" class="px-6 py-4 font-semibold text-gray-900">File Size Paywalls</th>
                <td class="px-6 py-4 font-medium text-green-700 bg-green-50/30">No artificial caps</td>
                <td class="px-6 py-4 text-gray-500">Blocked above 15MB – 50MB</td>
              </tr>
              <tr>
                <th scope="row" class="px-6 py-4 font-semibold text-gray-900">Subscription Upgrades</th>
                <td class="px-6 py-4 font-medium text-green-700 bg-green-50/30">100% Free Forever</td>
                <td class="px-6 py-4 text-gray-500">Aggressive $12/month paywalls</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Frequently Asked Questions (FAQ) -->
    <section class="mb-16" aria-labelledby="faq-heading">
      <div class="max-w-4xl mx-auto">
        <h2 id="faq-heading" class="text-2xl sm:text-3xl font-bold text-gray-900 mb-6 text-center sm:text-left">
          Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          <details class="group bg-white p-5 rounded-xl border border-gray-200 [&_summary::-webkit-details-marker]:hidden" open>
            <summary class="flex items-center justify-between cursor-pointer font-bold text-gray-900 text-base sm:text-lg">
              <span>Is Best Converter 100% free to use with no hidden limits?</span>
              <span class="ml-4 flex-shrink-0 text-gray-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-sm text-gray-600 leading-relaxed">
              Yes. Every tool on Best Converter is 100% free forever with no daily conversion quotas, no file size paywalls, no watermarks, and no sign-up or credit card required.
            </p>
          </details>

          <details class="group bg-white p-5 rounded-xl border border-gray-200 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between cursor-pointer font-bold text-gray-900 text-base sm:text-lg">
              <span>How do I compress an image to 20KB or a specific file size?</span>
              <span class="ml-4 flex-shrink-0 text-gray-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-sm text-gray-600 leading-relaxed">
              Use our Compress Image to 20KB tool or Universal Image Compressor. Simply upload your JPG, PNG, or WebP photo, select 20KB target size, and our adaptive compression algorithm shrinks the file size while preserving maximum visual sharpness.
            </p>
          </details>

          <details class="group bg-white p-5 rounded-xl border border-gray-200 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between cursor-pointer font-bold text-gray-900 text-base sm:text-lg">
              <span>Are my uploaded files and documents kept private and secure?</span>
              <span class="ml-4 flex-shrink-0 text-gray-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-sm text-gray-600 leading-relaxed">
              Yes. Best Converter processes your files directly inside your browser memory using WebAssembly and HTML5 Canvas. Your documents and photos are never uploaded to any remote server or stored in the cloud.
            </p>
          </details>

          <details class="group bg-white p-5 rounded-xl border border-gray-200 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between cursor-pointer font-bold text-gray-900 text-base sm:text-lg">
              <span>Can I merge or split PDF documents without installing software?</span>
              <span class="ml-4 flex-shrink-0 text-gray-400 group-open:rotate-180 transition-transform">▼</span>
