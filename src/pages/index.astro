---
import Layout from '../layouts/Layout.astro';
import HomeConverterShell from '../components/HomeConverterShell';
import { siteConfig } from '../config/site';
import { getAllTools, getFormatHubs } from '../registry';

const allTools = getAllTools();
const converters = allTools.filter((t) => t.kind === 'converter');
const pdfTools = allTools.filter((t) => t.kind === 'pdf');
const calculators = allTools.filter((t) => t.kind === 'finance' || t.kind === 'calculator');
const generatorsAndMedia = allTools.filter((t) => t.kind === 'generator' || t.kind === 'media' || t.kind === 'developer' || t.kind === 'text');
const formatHubs = getFormatHubs();

// Flagship Tier 1 featured tools
const featuredSlugs = [
  'image-compressor',
  'passport-photo-resizer',
  'compress-image-to-50kb',
  'compress-image-to-20kb',
  'heic-to-jpg',
  'pdf-to-jpg',
  'merge-pdf',
  'compress-pdf',
  'jpg-compressor',
  'photo-compressor',
  'jpeg-to-jpg',
  'webp-to-png',
  'png-to-jpg',
  'emi-calculator',
  'qr-code-generator',
  'json-formatter',
];
const featuredTools = featuredSlugs
  .map((slug) => allTools.find((t) => t.slug === slug))
  .filter(Boolean);

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ZixTool',
  url: siteConfig.url,
  description: 'Fast, 100% private online file converters, PDF editors, image compressors, and calculators executed locally in your browser.',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteConfig.url}/tools/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ZixTool',
  url: siteConfig.url,
  logo: `${siteConfig.url}/images/brand/logo.png`,
  sameAs: [
    'https://github.com/devcoder0909/tools',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    email: siteConfig.contactEmail,
    contactType: 'customer support',
  },
};

const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ZixTool Online Utilities',
  url: siteConfig.url,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'All modern web browsers',
  browserRequirements: 'Requires JavaScript and modern HTML5 Canvas/WebAssembly support',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  featureList: [
    '100% Client-Side In-Browser Processing',
    'Zero File Uploads to Cloud Servers',
    'Image Compression to Exact KB Limits (20KB, 50KB, 100KB)',
    'Client-Side PDF Merging, Splitting and Compression',
    'Privacy Compliant and Safe for Biometric IDs',
    'Works Offline via Progressive Web App (PWA)',
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is ZixTool free to use with no hidden fees or limits?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Every tool on ZixTool is 100% free with no daily conversion quotas, no file size paywalls, no watermarks, and no sign-up or credit card required.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does client-side in-browser file conversion protect my privacy?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ZixTool processes your files entirely inside your device RAM using WebAssembly and HTML5 Canvas. Your documents, photos, and biometric signatures never leave your browser and are never uploaded to any remote cloud server.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I compress photos and signatures for exam portals (TNPSC, UPSC, Bank Exams)?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Use our Passport Photo Resizer or dedicated Compress to 20KB and 50KB tools. Select your target byte ceiling; our automated binary search engine clamps the output strictly within portal limits while preserving crisp facial and signature contours.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I convert Apple HEIC photos to JPG without installing software?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Our HEIC to JPG tool decodes Apple HEIC and HEIF photos locally using WebAssembly in any browser, exporting high quality JPGs without needing paid codec extensions.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I convert multi-page PDF documents into high-resolution JPG images?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Our PDF to JPG converter parses PDF vector streams and bitmaps in browser memory, allowing you to convert individual pages or extract all pages in a single ZIP download with zero server uploads.',
      },
    },
    {
      '@type': 'Question',
      name: 'What image and document formats are supported on ZixTool?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ZixTool supports all major formats including HEIC, JPG, JPEG, PNG, WebP, AVIF, GIF, SVG, BMP, TIFF, and PDF, alongside core deterministic calculators and developer formatters.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does ZixTool add watermarks or reduce image quality?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. All conversions, compressions, and generated files are 100% clean with zero watermarks, brand logos, or artificial quality degradation.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I use ZixTool offline without an active internet connection?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Once this page loads, ZixTool assets are cached by your browser via Progressive Web App (PWA) standards. You can disconnect from Wi-Fi or mobile data and continue converting and compressing photos offline.',
      },
    },
  ],
};
---

<Layout
  title="ZixTool - Free Online File Converters & Tools"
  description="Fast, 100% private online file converters, PDF editors, image compressors, and calculators. Works locally in your browser with zero file uploads."
  canonical={`${siteConfig.url}/`}
  jsonLd={[websiteJsonLd, organizationJsonLd, webAppJsonLd, faqJsonLd]}
>
  <div class="relative overflow-hidden">
    <!-- Ambient Backdrop Light Glow (Silicon Valley SaaS Polish) -->
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[720px] h-[360px] bg-gradient-to-tr from-emerald-100/40 via-teal-50/30 to-blue-50/20 blur-3xl pointer-events-none rounded-full" aria-hidden="true"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-16 relative">
      <!-- Hero Header -->
      <header class="text-center max-w-3xl mx-auto mb-8 sm:mb-12">
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-[1.15] mb-4">
          Free Online File Converters, Image Compressors & Utilities
        </h1>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto">
          Convert images, compress photos to 20KB–100KB for exam portals, edit PDFs, and calculate finances directly in device memory. No registration, no queues, and your data never leaves your device.
        </p>

        <!-- Quick-Intent Shortcuts -->
        <div class="flex flex-wrap items-center justify-center gap-2 mt-6" aria-label="Most Requested Tools">
          <a href="/compress-image-to-50kb/" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white hover:bg-emerald-50 hover:text-emerald-700 text-slate-700 text-xs font-semibold border border-slate-200/80 hover:border-emerald-300 shadow-2xs hover:shadow-xs transition duration-200">
            <span>📷</span><span>Compress to 50KB</span>
          </a>
          <a href="/passport-photo-resizer/" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white hover:bg-emerald-50 hover:text-emerald-700 text-slate-700 text-xs font-semibold border border-slate-200/80 hover:border-emerald-300 shadow-2xs hover:shadow-xs transition duration-200">
            <span>🪪</span><span>Exam & Passport Photo</span>
          </a>
          <a href="/heic-to-jpg/" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white hover:bg-emerald-50 hover:text-emerald-700 text-slate-700 text-xs font-semibold border border-slate-200/80 hover:border-emerald-300 shadow-2xs hover:shadow-xs transition duration-200">
            <span>🔄</span><span>HEIC to JPG</span>
          </a>
          <a href="/jpg-compressor/" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white hover:bg-emerald-50 hover:text-emerald-700 text-slate-700 text-xs font-semibold border border-slate-200/80 hover:border-emerald-300 shadow-2xs hover:shadow-xs transition duration-200">
            <span>📉</span><span>JPG Compressor</span>
          </a>
          <a href="/pdf-to-jpg/" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white hover:bg-emerald-50 hover:text-emerald-700 text-slate-700 text-xs font-semibold border border-slate-200/80 hover:border-emerald-300 shadow-2xs hover:shadow-xs transition duration-200">
            <span>📄</span><span>PDF to JPG</span>
          </a>
          <a href="/merge-pdf/" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white hover:bg-emerald-50 hover:text-emerald-700 text-slate-700 text-xs font-semibold border border-slate-200/80 hover:border-emerald-300 shadow-2xs hover:shadow-xs transition duration-200">
            <span>📑</span><span>Merge PDF</span>
          </a>
          <a href="/emi-calculator/" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white hover:bg-emerald-50 hover:text-emerald-700 text-slate-700 text-xs font-semibold border border-slate-200/80 hover:border-emerald-300 shadow-2xs hover:shadow-xs transition duration-200">
            <span>💰</span><span>EMI Calculator</span>
          </a>
          <a href="/qr-code-generator/" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white hover:bg-emerald-50 hover:text-emerald-700 text-slate-700 text-xs font-semibold border border-slate-200/80 hover:border-emerald-300 shadow-2xs hover:shadow-xs transition duration-200">
            <span>📱</span><span>QR Generator</span>
          </a>
        </div>
      </header>

      <!-- Interactive Universal Dropzone Above the Fold -->
      <div class="mb-14">
        <HomeConverterShell client:load />
      </div>

    <!-- Psychology Trust Pillars -->
    <section class="mb-16" aria-labelledby="trust-pillars-heading">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <h2 id="trust-pillars-heading" class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">
          Engineered for Complete Privacy & Zero Latency
        </h2>
        <p class="text-sm text-gray-500 mt-1">Why hundreds of thousands of users trust ZixTool over traditional cloud uploaders.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="p-5 rounded-2xl border border-gray-200/80 bg-white shadow-2xs hover:border-emerald-500/50 transition">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-lg mb-3">🛡️</div>
          <h3 class="font-bold text-gray-900 text-sm mb-1.5">100% In-Device Memory</h3>
          <p class="text-xs text-gray-500 leading-relaxed">All files are processed in local RAM via WebAssembly. Your photos, biometric IDs, and PDFs never upload to any remote server.</p>
        </div>
        <div class="p-5 rounded-2xl border border-gray-200/80 bg-white shadow-2xs hover:border-emerald-500/50 transition">
          <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-lg mb-3">⚡</div>
          <h3 class="font-bold text-gray-900 text-sm mb-1.5">Instant Zero Latency</h3>
          <p class="text-xs text-gray-500 leading-relaxed">No uploading over slow internet and no waiting in server queues. Even heavy 20MB photos transcode in milliseconds on your device.</p>
        </div>
        <div class="p-5 rounded-2xl border border-gray-200/80 bg-white shadow-2xs hover:border-emerald-500/50 transition">
          <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-lg mb-3">🎯</div>
          <h3 class="font-bold text-gray-900 text-sm mb-1.5">Exact Target Byte Limits</h3>
          <p class="text-xs text-gray-500 leading-relaxed">Automated binary search quantization ensures images strictly meet strict portal byte ceilings (under 20KB, 50KB, 100KB).</p>
        </div>
        <div class="p-5 rounded-2xl border border-gray-200/80 bg-white shadow-2xs hover:border-emerald-500/50 transition">
          <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold text-lg mb-3">🚫</div>
          <h3 class="font-bold text-gray-900 text-sm mb-1.5">Zero Traps or Watermarks</h3>
          <p class="text-xs text-gray-500 leading-relaxed">No subscription paywalls, no forced account signups, and zero brand watermarks stamped onto your personal output files.</p>
        </div>
      </div>
    </section>

    <!-- Interactive Search & Category Filter Section -->
    <section class="mb-14" aria-labelledby="explore-heading">
      <div class="bg-gradient-to-b from-gray-50 to-white border border-gray-200 rounded-3xl p-6 sm:p-8">
        <div class="max-w-2xl mx-auto text-center mb-6">
          <h2 id="explore-heading" class="text-2xl font-bold text-gray-900 tracking-tight">
            Explore 70+ Smart Online Utilities
          </h2>
          <p class="text-sm text-gray-500 mt-1">Instant search or choose a category below to quickly find the exact tool you need.</p>
        </div>

        <!-- Search Input -->
        <div class="max-w-xl mx-auto mb-6">
          <div class="relative">
            <input
              type="text"
              id="home-tool-search"
              placeholder="Search 70+ tools by name, format, or task (e.g. 50kb, heic, emi, pdf to jpg)..."
              class="w-full pl-11 pr-14 py-3 rounded-2xl border border-slate-200/90 bg-white text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 shadow-xs transition"
              aria-label="Search all tools"
            />
            <svg class="w-5 h-5 text-slate-400 absolute left-3.5 top-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span class="absolute right-3.5 top-2.5 px-2 py-1 rounded-md bg-slate-100 text-2xs font-mono font-semibold text-slate-400 border border-slate-200">/</span>
          </div>
        </div>

        <!-- Category Tabs -->
        <div class="flex flex-wrap items-center justify-center gap-2" role="tablist">
          <button type="button" class="category-tab active px-4 py-2 rounded-xl text-xs font-bold transition bg-emerald-600 text-white shadow-xs" data-category="all">
            All Tools ({allTools.length})
          </button>
          <button type="button" class="category-tab px-4 py-2 rounded-xl text-xs font-semibold transition bg-white border border-gray-200 text-gray-700 hover:bg-gray-100" data-category="converter">
            🖼️ Image & Photos ({converters.length})
          </button>
          <button type="button" class="category-tab px-4 py-2 rounded-xl text-xs font-semibold transition bg-white border border-gray-200 text-gray-700 hover:bg-gray-100" data-category="pdf">
            📑 PDF & Documents ({pdfTools.length})
          </button>
          <button type="button" class="category-tab px-4 py-2 rounded-xl text-xs font-semibold transition bg-white border border-gray-200 text-gray-700 hover:bg-gray-100" data-category="finance">
            💰 Calculators & Finance ({calculators.length})
          </button>
          <button type="button" class="category-tab px-4 py-2 rounded-xl text-xs font-semibold transition bg-white border border-gray-200 text-gray-700 hover:bg-gray-100" data-category="developer">
            🛠️ Developer & Utilities ({generatorsAndMedia.length})
          </button>
        </div>
      </div>
    </section>

    <!-- Flagship Top Tools Grid -->
    <section class="mb-16" aria-labelledby="featured-heading">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 id="featured-heading" class="text-2xl font-bold text-gray-900 tracking-tight">
            Top Rated Online Utilities & Converters
          </h2>
          <p class="text-sm text-gray-500">Most requested tools for everyday file conversions, exam photo preparation, and calculations.</p>
        </div>
        <a href="/tools/" class="hidden sm:inline-flex items-center gap-1 text-sm font-semibold text-emerald-600 hover:text-emerald-700 hover:underline">
          <span>View all 70+ tools</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" id="tools-container">
        {featuredTools.map((tool) => (
          <a
            href={`/${tool!.slug}/`}
            class="home-tool-card p-4 rounded-2xl border border-gray-200/80 bg-white hover:border-emerald-500 hover:shadow-sm transition group flex flex-col justify-between"
            data-category={tool!.kind}
            data-name={tool!.name.toLowerCase()}
            data-desc={tool!.description.toLowerCase()}
          >
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-2xs font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-gray-100 text-gray-700 group-hover:bg-emerald-50 group-hover:text-emerald-700 transition-colors">
                  {tool!.kind}
                </span>
                <span class="text-emerald-600 text-xs font-bold opacity-0 group-hover:opacity-100 transition-opacity">
                  Open &rarr;
                </span>
              </div>
              <h3 class="font-bold text-gray-900 group-hover:text-emerald-600 text-sm sm:text-base mb-1 transition-colors">
                {tool!.name}
              </h3>
              <p class="text-xs text-gray-500 line-clamp-2 leading-relaxed">
                {tool!.description}
              </p>
            </div>
            <div class="mt-3 pt-2.5 border-t border-gray-100 flex items-center justify-between text-2xs text-gray-400">
              <span>Client-Side</span>
              <span class="font-medium text-emerald-600 group-hover:underline">100% Free</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- PDF & Document Management Suite -->
    <section class="mb-16" aria-labelledby="pdf-suite-heading">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 id="pdf-suite-heading" class="text-2xl font-bold text-gray-900 tracking-tight">
            Free PDF Document Management Tools
          </h2>
          <p class="text-sm text-gray-500">Merge multiple PDFs, split pages, compress file sizes, and extract high-resolution JPG images.</p>
        </div>
        <a href="/tools/#pdf" class="text-sm font-semibold text-emerald-600 hover:underline">
          All PDF tools &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {pdfTools.slice(0, 6).map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="home-tool-card p-5 rounded-2xl border border-gray-200/80 bg-white hover:border-rose-500/80 hover:shadow-sm transition group flex flex-col justify-between"
            data-category="pdf"
            data-name={tool.name.toLowerCase()}
            data-desc={tool.description.toLowerCase()}
          >
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-2xs font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-rose-50 text-rose-700">PDF Suite</span>
                <span class="text-rose-600 text-xs font-bold opacity-0 group-hover:opacity-100 transition-opacity">Launch &rarr;</span>
              </div>
              <h3 class="font-bold text-gray-900 group-hover:text-rose-600 text-base mb-1 transition-colors">{tool.name}</h3>
              <p class="text-xs text-gray-500 line-clamp-2 leading-relaxed">{tool.description}</p>
            </div>
            <div class="mt-3 pt-2.5 border-t border-gray-100 flex items-center justify-between text-2xs text-gray-400">
              <span>PDF Utility</span>
              <span class="text-slate-600 font-medium">Free &amp; Private</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Image Converters & Photo Compression Suite -->
    <section class="mb-16" aria-labelledby="image-suite-heading">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 id="image-suite-heading" class="text-2xl font-bold text-gray-900 tracking-tight">
            Image Converters & Target Size Compression
          </h2>
          <p class="text-sm text-gray-500">Transcode HEIC, JPG, PNG, WebP and compress photos strictly below 20KB, 50KB, or 100KB.</p>
        </div>
        <a href="/tools/#converters" class="text-sm font-semibold text-emerald-600 hover:underline">
          View all converters &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {converters.slice(0, 6).map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="home-tool-card p-5 rounded-2xl border border-gray-200/80 bg-white hover:border-emerald-500 hover:shadow-sm transition group flex flex-col justify-between"
            data-category="converter"
            data-name={tool.name.toLowerCase()}
            data-desc={tool.description.toLowerCase()}
          >
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-2xs font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700">
                  {tool.slug.includes('compress') ? 'Compression' : 'Converter'}
                </span>
                <span class="text-emerald-600 text-xs font-bold opacity-0 group-hover:opacity-100 transition-opacity">Open &rarr;</span>
              </div>
              <h3 class="font-bold text-gray-900 group-hover:text-emerald-600 text-base mb-1 transition-colors">{tool.name}</h3>
              <p class="text-xs text-gray-500 line-clamp-2 leading-relaxed">{tool.description}</p>
            </div>
            <div class="mt-3 pt-2.5 border-t border-gray-100 flex items-center justify-between text-2xs text-gray-400">
              <span>High Quality</span>
              <span class="text-emerald-600 font-medium">Direct Download</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Financial & Loan Calculators -->
    <section class="mb-16" aria-labelledby="finance-heading">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 id="finance-heading" class="text-2xl font-bold text-gray-900 tracking-tight">
            Financial & Loan Calculators
          </h2>
          <p class="text-sm text-gray-500">Calculate home loan EMIs, SIP mutual fund returns, compound interest, and GST instantly.</p>
        </div>
        <a href="/calculators/" class="text-sm font-semibold text-emerald-600 hover:underline">
          View all calculators &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {calculators.slice(0, 6).map((calc) => (
          <a
            href={`/${calc.slug}/`}
            class="home-tool-card p-5 rounded-2xl border border-gray-200/80 bg-white hover:border-blue-500 hover:shadow-sm transition group flex flex-col justify-between"
            data-category="finance"
            data-name={calc.name.toLowerCase()}
            data-desc={calc.description.toLowerCase()}
          >
            <div>
              <span class="text-2xs font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 mb-2 inline-block">
                {calc.kind}
              </span>
              <h3 class="font-bold text-gray-900 group-hover:text-blue-600 text-base mb-1 transition-colors">{calc.name}</h3>
              <p class="text-xs text-gray-500 line-clamp-2 leading-relaxed">{calc.description}</p>
            </div>
            <div class="mt-3 pt-2.5 border-t border-gray-100 text-2xs text-gray-400 flex justify-between">
              <span>Financial Tool</span>
