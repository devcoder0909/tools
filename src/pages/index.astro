---
import Layout from '../layouts/Layout.astro';
import HomeConverterShell from '../components/HomeConverterShell';
import { siteConfig } from '../config/site';
import { getAllTools, getFormatHubs } from '../registry';

const allTools = getAllTools();
const converters = allTools.filter((t) => t.kind === 'converter');
const pdfTools = allTools.filter((t) => t.kind === 'pdf');
const calculators = allTools.filter((t) => t.kind === 'finance' || t.kind === 'calculator');
const generatorsAndMedia = allTools.filter((t) => t.kind === 'generator' || t.kind === 'media' || t.kind === 'developer' || t.kind === 'text');
const formatHubs = getFormatHubs();

// Flagship Tier 1 featured tools
const featuredSlugs = [
  'image-compressor',
  'passport-photo-resizer',
  'compress-image-to-50kb',
  'compress-image-to-20kb',
  'heic-to-jpg',
  'pdf-to-jpg',
  'merge-pdf',
  'compress-pdf',
  'jpg-compressor',
  'photo-compressor',
  'jpeg-to-jpg',
  'webp-to-png',
  'png-to-jpg',
  'emi-calculator',
  'qr-code-generator',
  'json-formatter',
];
const featuredTools = featuredSlugs
  .map((slug) => allTools.find((t) => t.slug === slug))
  .filter(Boolean);

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ZixTool',
  url: siteConfig.url,
  description: 'Fast, 100% private online file converters, PDF editors, image compressors, and calculators executed locally in your browser.',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteConfig.url}/tools/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ZixTool',
  url: siteConfig.url,
  logo: `${siteConfig.url}/images/brand/logo.png`,
  sameAs: [
    'https://github.com/devcoder0909/tools',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    email: siteConfig.contactEmail,
    contactType: 'customer support',
  },
};

const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ZixTool Online Utilities',
  url: siteConfig.url,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'All modern web browsers',
  browserRequirements: 'Requires JavaScript and modern HTML5 Canvas/WebAssembly support',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  featureList: [
    '100% Client-Side In-Browser Processing',
    'Zero File Uploads to Cloud Servers',
    'Image Compression to Exact KB Limits (20KB, 50KB, 100KB)',
    'Client-Side PDF Merging, Splitting and Compression',
    'Privacy Compliant and Safe for Biometric IDs',
    'Works Offline via Progressive Web App (PWA)',
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is ZixTool free to use with no hidden fees or limits?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Every tool on ZixTool is 100% free with no daily conversion quotas, no file size paywalls, no watermarks, and no sign-up or credit card required.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does client-side in-browser file conversion protect my privacy?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ZixTool processes your files entirely inside your device RAM using WebAssembly and HTML5 Canvas. Your documents, photos, and biometric signatures never leave your browser and are never uploaded to any remote cloud server.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I compress photos and signatures for exam portals (TNPSC, UPSC, Bank Exams)?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Use our Passport Photo Resizer or dedicated Compress to 20KB and 50KB tools. Select your target byte ceiling; our automated binary search engine clamps the output strictly within portal limits while preserving crisp facial and signature contours.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I convert Apple HEIC photos to JPG without installing software?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Our HEIC to JPG tool decodes Apple HEIC and HEIF photos locally using WebAssembly in any browser, exporting high quality JPGs without needing paid codec extensions.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I convert multi-page PDF documents into high-resolution JPG images?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Our PDF to JPG converter parses PDF vector streams and bitmaps in browser memory, allowing you to convert individual pages or extract all pages in a single ZIP download with zero server uploads.',
      },
    },
    {
      '@type': 'Question',
      name: 'What image and document formats are supported on ZixTool?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ZixTool supports all major formats including HEIC, JPG, JPEG, PNG, WebP, AVIF, GIF, SVG, BMP, TIFF, and PDF, alongside core deterministic calculators and developer formatters.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does ZixTool add watermarks or reduce image quality?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. All conversions, compressions, and generated files are 100% clean with zero watermarks, brand logos, or artificial quality degradation.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I use ZixTool offline without an active internet connection?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Once this page loads, ZixTool assets are cached by your browser via Progressive Web App (PWA) standards. You can disconnect from Wi-Fi or mobile data and continue converting and compressing photos offline.',
      },
    },
  ],
};
---

<Layout
  title="ZixTool - Free Online File Converters & Tools"
  description="Fast, 100% private online file converters, PDF editors, image compressors, and calculators. Works locally in your browser with zero file uploads."
  canonical={`${siteConfig.url}/`}
  jsonLd={[websiteJsonLd, organizationJsonLd, webAppJsonLd, faqJsonLd]}
>
  <div class="relative overflow-hidden">
    <!-- Ambient Backdrop Light Glow (Silicon Valley SaaS Polish) -->
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[720px] h-[360px] bg-gradient-to-tr from-emerald-100/40 via-teal-50/30 to-blue-50/20 blur-3xl pointer-events-none rounded-full" aria-hidden="true"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-16 relative">
      <!-- Hero Header -->
      <header class="text-center max-w-3xl mx-auto mb-8 sm:mb-12">
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-[1.15] mb-4">
          Free Online File Converters, Image Compressors & Utilities
        </h1>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto">
          Convert images, compress photos to 20KB–100KB for exam portals, edit PDFs, and calculate finances directly in device memory. No registration, no queues, and your data never leaves your device.
        </p>

        <!-- Quick-Intent Shortcuts (Bespoke SVG Iconography) -->
        <div class="flex flex-wrap items-center justify-center gap-2 mt-6" aria-label="Most Requested Tools">
          <a href="/compress-image-to-50kb/" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white hover:bg-slate-50 hover:text-emerald-700 text-slate-700 text-xs font-semibold border border-slate-200/80 hover:border-emerald-300 shadow-2xs hover:shadow-xs transition duration-200">
            <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
            <span>Compress to 50KB</span>
          </a>
          <a href="/passport-photo-resizer/" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white hover:bg-slate-50 hover:text-emerald-700 text-slate-700 text-xs font-semibold border border-slate-200/80 hover:border-emerald-300 shadow-2xs hover:shadow-xs transition duration-200">
            <svg class="w-3.5 h-3.5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2" /></svg>
            <span>Exam &amp; Passport Photo</span>
          </a>
          <a href="/heic-to-jpg/" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white hover:bg-slate-50 hover:text-emerald-700 text-slate-700 text-xs font-semibold border border-slate-200/80 hover:border-emerald-300 shadow-2xs hover:shadow-xs transition duration-200">
            <svg class="w-3.5 h-3.5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
            <span>HEIC to JPG</span>
          </a>
          <a href="/jpg-compressor/" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white hover:bg-slate-50 hover:text-emerald-700 text-slate-700 text-xs font-semibold border border-slate-200/80 hover:border-emerald-300 shadow-2xs hover:shadow-xs transition duration-200">
            <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            <span>JPG Compressor</span>
          </a>
          <a href="/pdf-to-jpg/" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white hover:bg-slate-50 hover:text-emerald-700 text-slate-700 text-xs font-semibold border border-slate-200/80 hover:border-emerald-300 shadow-2xs hover:shadow-xs transition duration-200">
            <svg class="w-3.5 h-3.5 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            <span>PDF to JPG</span>
          </a>
          <a href="/merge-pdf/" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white hover:bg-slate-50 hover:text-emerald-700 text-slate-700 text-xs font-semibold border border-slate-200/80 hover:border-emerald-300 shadow-2xs hover:shadow-xs transition duration-200">
            <svg class="w-3.5 h-3.5 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" /></svg>
            <span>Merge PDF</span>
          </a>
          <a href="/emi-calculator/" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white hover:bg-slate-50 hover:text-emerald-700 text-slate-700 text-xs font-semibold border border-slate-200/80 hover:border-emerald-300 shadow-2xs hover:shadow-xs transition duration-200">
            <svg class="w-3.5 h-3.5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
            <span>EMI Calculator</span>
          </a>
          <a href="/qr-code-generator/" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white hover:bg-slate-50 hover:text-emerald-700 text-slate-700 text-xs font-semibold border border-slate-200/80 hover:border-emerald-300 shadow-2xs hover:shadow-xs transition duration-200">
            <svg class="w-3.5 h-3.5 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" /></svg>
            <span>QR Generator</span>
          </a>
        </div>
      </header>

      <!-- Interactive Universal Dropzone Above the Fold -->
      <div class="mb-14">
        <HomeConverterShell client:load />
      </div>

    <!-- Core Engineering Architecture (SaaS Bento Showcase) -->
    <section class="mb-16" aria-labelledby="architecture-heading">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <h2 id="architecture-heading" class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
          Engineered for Client-Side Precision &amp; Speed
        </h2>
        <p class="text-sm text-slate-500 mt-1">Direct hardware execution replacing fragile cloud file pipelines.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="p-6 rounded-3xl border border-slate-200/90 bg-white shadow-xs hover:border-emerald-500/50 hover:shadow-md transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="w-11 h-11 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-4 border border-emerald-100">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 text-base mb-1.5">In-Device Hardware Engine</h3>
            <p class="text-xs text-slate-500 leading-relaxed">WebAssembly and HTML5 Canvas pipeline decoding images, vectors, and documents directly on your device CPU and GPU without network latency.</p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-2 text-2xs font-mono font-semibold text-emerald-700">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            <span>Zero Remote Network Transit</span>
          </div>
        </div>

        <div class="p-6 rounded-3xl border border-slate-200/90 bg-white shadow-xs hover:border-emerald-500/50 hover:shadow-md transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="w-11 h-11 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center mb-4 border border-blue-100">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 text-base mb-1.5">Target Size Quantization</h3>
            <p class="text-xs text-slate-500 leading-relaxed">Automated binary search quantization matches strict government exam and visa portal byte ceilings (under 20KB, 50KB, 100KB) on the first try.</p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-2 text-2xs font-mono font-semibold text-blue-700">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
            <span>Binary Search Convergence</span>
          </div>
        </div>

        <div class="p-6 rounded-3xl border border-slate-200/90 bg-white shadow-xs hover:border-emerald-500/50 hover:shadow-md transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="w-11 h-11 rounded-2xl bg-slate-100 text-slate-700 flex items-center justify-center mb-4 border border-slate-200">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 text-base mb-1.5">Session Ephemerality</h3>
            <p class="text-xs text-slate-500 leading-relaxed">Zero server databases, zero telemetry tracking, and zero disk storage. Memory buffers are garbage-collected as soon as your browser tab closes.</p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-2 text-2xs font-mono font-semibold text-slate-700">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
            <span>Ephemeral Browser RAM</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Search & Category Filter Section -->
    <section class="mb-14" aria-labelledby="explore-heading">
      <div class="bg-gradient-to-b from-slate-50/80 to-white border border-slate-200/90 rounded-3xl p-6 sm:p-8 shadow-xs">
        <div class="max-w-2xl mx-auto text-center mb-6">
          <h2 id="explore-heading" class="text-2xl font-bold text-slate-900 tracking-tight">
            Explore 70+ Smart Online Utilities
          </h2>
          <p class="text-sm text-slate-500 mt-1">Instant search or choose a category below to filter tools in real-time.</p>
        </div>

        <!-- Search Input -->
        <div class="max-w-xl mx-auto mb-6">
          <div class="relative">
            <input
              type="text"
              id="home-tool-search"
              placeholder="Search 70+ tools by name, format, or task (e.g. 50kb, heic, emi, pdf to jpg)..."
              class="w-full pl-11 pr-14 py-3 rounded-2xl border border-slate-200/90 bg-white text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 shadow-xs transition"
              aria-label="Search all tools"
            />
            <svg class="w-5 h-5 text-slate-400 absolute left-3.5 top-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span class="absolute right-3.5 top-2.5 px-2 py-1 rounded-md bg-slate-100 text-2xs font-mono font-semibold text-slate-400 border border-slate-200">/</span>
          </div>
        </div>

        <!-- Category Tabs (Bespoke SVG icons) -->
        <div class="flex flex-wrap items-center justify-center gap-2" role="tablist">
          <button type="button" class="category-tab active px-4 py-2 rounded-xl text-xs font-semibold transition-all bg-slate-900 text-white shadow-xs inline-flex items-center gap-1.5" data-category="all">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
            <span>All Tools ({allTools.length})</span>
          </button>
          <button type="button" class="category-tab px-4 py-2 rounded-xl text-xs font-medium transition-all bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 inline-flex items-center gap-1.5" data-category="converter">
            <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            <span>Image &amp; Photos ({converters.length})</span>
          </button>
          <button type="button" class="category-tab px-4 py-2 rounded-xl text-xs font-medium transition-all bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 inline-flex items-center gap-1.5" data-category="pdf">
            <svg class="w-3.5 h-3.5 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            <span>PDF &amp; Documents ({pdfTools.length})</span>
          </button>
          <button type="button" class="category-tab px-4 py-2 rounded-xl text-xs font-medium transition-all bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 inline-flex items-center gap-1.5" data-category="finance">
            <svg class="w-3.5 h-3.5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
            <span>Calculators &amp; Finance ({calculators.length})</span>
          </button>
          <button type="button" class="category-tab px-4 py-2 rounded-xl text-xs font-medium transition-all bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 inline-flex items-center gap-1.5" data-category="developer">
            <svg class="w-3.5 h-3.5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
