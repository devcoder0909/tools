---
import CollegeLayout from '../../../layouts/CollegeLayout.astro';
import SourceBox from '../../../components/colleges/SourceBox.astro';
import collegesData from '@/data/colleges.json';
import fs from 'node:fs';
import path from 'node:path';

const nitColleges = collegesData.filter((c) => c.type === 'NIT');

const cutoffsPath = path.resolve(process.cwd(), 'public/data/cutoffs/2024-all.json');
const allCutoffs: any[] = fs.existsSync(cutoffsPath) ? JSON.parse(fs.readFileSync(cutoffsPath, 'utf-8')) : [];

// Map CSE OS and HS cutoff for each NIT
const cseCutoffMap = new Map<string, { osClosing?: number; hsClosing?: number }>();
for (const row of allCutoffs) {
  const [slug, program, quota, seatType, gender, round, opening, closing] = row;
  if (program === 'cse' && seatType === 'OPEN' && gender === 'Gender-Neutral') {
    const cur = cseCutoffMap.get(slug) || {};
    if (quota === 'OS') cur.osClosing = closing;
    if (quota === 'HS') cur.hsClosing = closing;
    cseCutoffMap.set(slug, cur);
  }
}

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://convert.gudmud.site/' },
    { '@type': 'ListItem', position: 2, name: 'Colleges', item: 'https://convert.gudmud.site/colleges/' },
    { '@type': 'ListItem', position: 3, name: 'Cutoff Explorer', item: 'https://convert.gudmud.site/cutoff/' },
    { '@type': 'ListItem', position: 4, name: 'NIT Cutoff 2024', item: 'https://convert.gudmud.site/cutoff/nits/' },
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What rank is needed for Computer Science (CSE) in top NITs?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'In JoSAA Round 5 for Other State (OS) OPEN candidates, CSE at NIT Trichy closed at rank 1,506, NIT Surathkal at 2,355, NIT Warangal at 2,780, and NIT Rourkela at 3,755.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does the Home State (HS) quota affect NIT cutoffs?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'NITs reserve 50% of undergraduate seats for candidates who completed class 12 within the institute state. In states with high seat-to-candidate ratios (e.g. Tamil Nadu, Karnataka, Telangana, North-East states), Home State closing ranks can be 2x to 5x higher than Other State ranks.',
      },
    },
  ],
};
---

<CollegeLayout
  title="NIT Cutoff 2024: JoSAA Closing Ranks for 32 NITs | Gudmud"
  description="Check JoSAA 2024 opening and closing ranks for all 32 National Institutes of Technology. Compare Home State and Other State quota cutoffs by branch and category."
  canonical="https://convert.gudmud.site/cutoff/nits/"
  jsonLd={[breadcrumbJsonLd, faqJsonLd]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-gray-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <a href="/colleges/" class="hover:underline">Colleges</a>
      <span>/</span>
      <a href="/cutoff/" class="hover:underline">Cutoffs</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">NIT Cutoff 2024</span>
    </nav>

    <!-- Header Section -->
    <header class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200 mb-3">
        Official JoSAA Round 5 Data
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-3">
        NIT Cutoff 2024: JoSAA Opening and Closing Ranks
      </h1>
      <p class="text-base text-gray-600 max-w-3xl leading-relaxed">
        Explore verified closing ranks for all 32 National Institutes of Technology (NITs). Compare Other State (OS) and Home State (HS) seat allocations for JEE Main candidates.
      </p>
    </header>

    <!-- Predictor CTA -->
    <div class="mb-8 bg-indigo-50 border border-indigo-200 rounded-xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-sm font-bold text-indigo-950 mb-1">Predict Your NIT Admission Chances</h2>
        <p class="text-xs text-indigo-800">Enter your JEE Main AIR rank, category, and state quota to discover your eligible NIT branches.</p>
      </div>
      <a
        href="/jee-main-rank-college-predictor/"
        class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-indigo-600 text-white text-xs font-semibold hover:bg-indigo-700 transition shrink-0"
      >
        Open JEE Main Predictor &rarr;
      </a>
    </div>

    <!-- Table of all 32 NITs -->
    <section class="bg-white rounded-xl border border-gray-200 shadow-2xs overflow-hidden mb-12">
      <div class="p-5 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-base font-bold text-gray-900">
          All 32 National Institutes of Technology (JoSAA Cutoff Directory)
        </h2>
        <span class="text-xs text-gray-500">32 Institutes</span>
      </div>
      <div class="overflow-x-auto text-xs">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-gray-200 bg-gray-50 text-gray-700">
              <th class="py-3 px-4 font-semibold">Institute Name</th>
              <th class="py-3 px-4 font-semibold">State</th>
              <th class="py-3 px-4 font-semibold">NIRF '24</th>
              <th class="py-3 px-4 font-semibold">CSE Other State (OS)</th>
              <th class="py-3 px-4 font-semibold">CSE Home State (HS)</th>
              <th class="py-3 px-4 font-semibold text-right">Cutoff Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {nitColleges.map((nit) => {
              const nirfEng = nit.nirf?.find((n) => n.category === 'Engineering' && n.year === 2024);
              const cse = cseCutoffMap.get(nit.slug);
              return (
                <tr class="hover:bg-gray-50/80 transition">
                  <td class="py-3 px-4 font-medium text-gray-900">
                    <a href={`/colleges/${nit.slug}/`} class="hover:underline text-indigo-600 font-semibold">
                      {nit.name}
                    </a>
                  </td>
                  <td class="py-3 px-4 text-gray-600">
                    {nit.state}
                  </td>
                  <td class="py-3 px-4">
                    {nirfEng ? (
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-2xs font-semibold bg-green-50 text-green-700 border border-green-200">
                        #{nirfEng.rank}
                      </span>
                    ) : (
                      <span class="text-gray-400">&mdash;</span>
                    )}
                  </td>
                  <td class="py-3 px-4 font-semibold text-gray-900">
                    {cse?.osClosing ? cse.osClosing.toLocaleString('en-IN') : '&mdash;'}
                  </td>
                  <td class="py-3 px-4 text-gray-700">
                    {cse?.hsClosing ? cse.hsClosing.toLocaleString('en-IN') : '&mdash;'}
                  </td>
                  <td class="py-3 px-4 text-right">
                    <a
                      href={`/cutoff/${nit.slug}/`}
                      class="inline-flex items-center gap-1 font-semibold text-indigo-600 hover:text-indigo-800"
                    >
                      View All Branches &rarr;
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Editorial & Quota Guide -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
      <div class="lg:col-span-2 space-y-6">
        <section class="bg-white rounded-xl border border-gray-200 p-6 shadow-2xs">
          <h2 class="text-lg font-bold text-gray-900 mb-3">
            How Home State (HS) vs Other State (OS) Quotas Function
          </h2>
          <div class="space-y-4 text-sm text-gray-600 leading-relaxed">
            <p>
              National Institutes of Technology operate under the National Institutes of Technology, Science Education and Research (NITSER) Act. A central tenet of the admission policy is the balanced distribution of seats between local and national aspirants:
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li>
                <strong>Home State (HS) Quota (50%):</strong> Reserved for candidates whose eligibility state (state of passing 12th standard examination) matches the state where the NIT is situated. For instance, candidates from Tamil Nadu qualify for the HS quota at <a href="/colleges/nit-trichy/" class="text-indigo-600 underline">NIT Trichy</a>.
              </li>
              <li>
                <strong>Other State (OS) Quota (50%):</strong> Open to all candidates across India whose class 12 examination state differs from the institute state. OS cutoff ranks are highly competitive.
              </li>
              <li>
                <strong>Union Territories & North-East Special Quotas:</strong> NITs in Goa, Daman & Diu, Dadra & Nagar Haveli, and Puducherry have specific sub-quotas allocating proportions of their Home State pool across their respective constituent territories.
              </li>
            </ul>
            <p>
              For granular analysis across all engineering branches, use our complete <a href="/cutoff/" class="text-indigo-600 underline">JoSAA Cutoff Explorer</a> or review <a href="/cutoff/computer-science/" class="text-indigo-600 underline">Computer Science Cutoffs</a>.
            </p>
          </div>
        </section>

        <!-- Other Hubs -->
        <section class="bg-white rounded-xl border border-gray-200 p-6 shadow-2xs">
          <h2 class="text-lg font-bold text-gray-900 mb-3">
            Cutoffs for Other Institute Categories
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
            <a href="/cutoff/iits/" class="p-4 rounded-lg border border-gray-200 hover:border-indigo-400 hover:shadow-xs transition block">
              <span class="font-bold text-gray-900 block mb-1">IIT Cutoff 2024</span>
              <span class="text-gray-500">Closing ranks for all 23 IITs via JEE Advanced.</span>
            </a>
            <a href="/cutoff/iiits/" class="p-4 rounded-lg border border-gray-200 hover:border-indigo-400 hover:shadow-xs transition block">
              <span class="font-bold text-gray-900 block mb-1">IIIT Cutoff 2024</span>
              <span class="text-gray-500">Closing ranks for 26 IIITs covering CSE and IT disciplines.</span>
            </a>
            <a href="/cutoff/gftis/" class="p-4 rounded-lg border border-gray-200 hover:border-indigo-400 hover:shadow-xs transition block">
              <span class="font-bold text-gray-900 block mb-1">GFTI Cutoff 2024</span>
              <span class="text-gray-500">Closing ranks for central government technical institutes.</span>
            </a>
          </div>
        </section>
      </div>

      <!-- Provenance Sidebar -->
      <div class="space-y-6">
        <SourceBox
          sourceName="Joint Seat Allocation Authority (JoSAA)"
          sourceUrl="https://josaa.nic.in"
          sourceYear="2024 Cycle"
          verifiedAt="15 Nov 2026"
          methodologyNote="Compiled from official Round 5 seat allocation archives. Both Home State (HS) and Other State (OS) quotas apply to NITs."
        />

        <div class="bg-white rounded-xl border border-gray-200 p-5 text-xs text-gray-600 space-y-3">
          <h3 class="font-bold text-gray-900 text-sm">Counselling Help</h3>
          <ul class="space-y-2">
            <li><a href="/guides/how-josaa-counselling-works/" class="text-indigo-600 hover:underline">How JoSAA Counselling Works &rarr;</a></li>
            <li><a href="/guides/josaa-rounds-and-seat-types-explained/" class="text-indigo-600 hover:underline">Seat Types & Freeze/Float Guide &rarr;</a></li>
            <li><a href="/nirf-ranking/engineering/" class="text-indigo-600 hover:underline">NIRF Engineering Rankings 2024 &rarr;</a></li>
            <li><a href="/official-links/" class="text-indigo-600 hover:underline">Official JoSAA Portal &rarr;</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</CollegeLayout>
