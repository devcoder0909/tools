---
import CollegeLayout from '../../layouts/CollegeLayout.astro';
import SourceBox from '../../components/colleges/SourceBox.astro';
import CutoffExplorerShell from '../../components/colleges/CutoffExplorerShell';
import collegesData from '@/data/colleges.json';
import programsData from '@/data/programs.json';
import fs from 'node:fs';
import path from 'node:path';

const cutoffsPath = path.resolve(process.cwd(), 'public/data/cutoffs/2024-all.json');
const cutoffs = fs.existsSync(cutoffsPath) ? JSON.parse(fs.readFileSync(cutoffsPath, 'utf-8')) : [];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://convert.gudmud.site/' },
    { '@type': 'ListItem', position: 2, name: 'Colleges', item: 'https://convert.gudmud.site/colleges/' },
    { '@type': 'ListItem', position: 3, name: 'JoSAA Cutoff Explorer', item: 'https://convert.gudmud.site/cutoff/' },
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Which round cutoffs are displayed in the JoSAA Cutoff Explorer?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The Cutoff Explorer displays official Round 5 (final seat allocation round) closing ranks published by the Joint Seat Allocation Authority (JoSAA) for the 2024 academic cycle.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the difference between Home State (HS) and Other State (OS) quota?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'In National Institutes of Technology (NITs), 50% of seats are reserved for students whose class 12 examination state matches the institute state (Home State / HS), while the remaining 50% are open to candidates across India (Other State / OS).',
      },
    },
    {
      '@type': 'Question',
      name: 'Does JoSAA use category rank or All India Rank for IIT admissions?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For reserved categories (EWS, OBC-NCL, SC, ST), JoSAA cutoffs in category seats are published as Category Ranks in the respective category merit list, not common All India CRL ranks.',
      },
    },
  ],
};
---

<CollegeLayout
  title="JoSAA Cutoff 2024: Opening & Closing Ranks | Gudmud Colleges"
  description="Explore official JoSAA 2024 opening and closing ranks for IITs, NITs, IIITs, and GFTIs. Filter by quota, branch, and category with verified Round 5 cutoffs."
  canonical="https://convert.gudmud.site/cutoff/"
  jsonLd={[breadcrumbJsonLd, faqJsonLd]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Breadcrumb trail -->
    <nav class="flex items-center gap-2 text-xs text-gray-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <a href="/colleges/" class="hover:underline">Colleges</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">Cutoff Explorer</span>
    </nav>

    <!-- Header Section -->
    <header class="mb-6">
      <h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-3">
        JoSAA Cutoff 2024: Opening & Closing Ranks
      </h1>
      <p class="text-sm sm:text-base text-gray-600 max-w-3xl leading-relaxed">
        Explore verified Round 5 closing ranks across 116 Indian institutes including 23 IITs, 32 NITs, 26 IIITs, and 35 GFTIs. Filter by seat quota, gender pool, academic discipline, and category to analyze historical admission cutoffs.
      </p>
    </header>

    <!-- Methodology & Provenance Box -->
    <SourceBox
      sourceName="Joint Seat Allocation Authority (JoSAA)"
      sourceUrl="https://josaa.nic.in"
      sourceYear={2024}
      lastVerified="2026-11-15"
      verifiedBy="Gudmud Data Engineering Team"
    />

    <!-- Interactive Cutoff Explorer Tool -->
    <section class="my-8" aria-label="Interactive Cutoff Explorer">
      <CutoffExplorerShell client:load />
    </section>

    <!-- Contextual Explanation & Guidance -->
    <section class="mt-12 space-y-6 text-sm text-gray-700 leading-relaxed border-t border-gray-200 pt-8">
      <h2 class="text-xl font-bold text-gray-900">
        How to Interpret JoSAA Opening and Closing Ranks
      </h2>
      <p>
        The Joint Seat Allocation Authority (JoSAA) manages central seat allocation for candidates qualifying in JEE Main and JEE Advanced. Understanding the published cutoff tables is crucial for drafting your counseling choice list:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-6">
        <div class="p-4 rounded-xl border border-gray-200 bg-gray-50">
          <h3 class="font-bold text-gray-900 mb-1">Opening Rank (OR)</h3>
          <p class="text-xs text-gray-600">
            The highest rank (best score) among candidates who accepted admission into a specific program and category in that counseling round.
          </p>
        </div>
        <div class="p-4 rounded-xl border border-gray-200 bg-gray-50">
          <h3 class="font-bold text-gray-900 mb-1">Closing Rank (CR)</h3>
          <p class="text-xs text-gray-600">
            The last rank admitted into that program. Candidates with ranks worse than the closing rank were not allotted seats in that round.
          </p>
        </div>
        <div class="p-4 rounded-xl border border-gray-200 bg-gray-50">
          <h3 class="font-bold text-gray-900 mb-1">Quota Designations</h3>
          <p class="text-xs text-gray-600">
            <strong>AI</strong> denotes All India quota (applies to all IITs and central programs); <strong>OS</strong> is Other State quota; <strong>HS</strong> represents Home State reservation in NITs.
          </p>
        </div>
      </div>

      <div class="my-8 bg-indigo-50/70 border border-indigo-200 rounded-2xl p-6">
        <h2 class="text-base font-bold text-gray-900 mb-2">
          Category & Branch Specific Cutoff Hubs
        </h2>
        <p class="text-xs text-gray-600 mb-4">
          Compare closing ranks by institutional framework or target engineering discipline:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-xs">
          <a href="/cutoff/iits/" class="p-3 rounded-xl border border-indigo-100 bg-white hover:border-indigo-500 hover:shadow-xs transition block">
            <span class="font-bold text-indigo-950 block mb-1">IIT Cutoff 2024 (23 IITs) &rarr;</span>
            <span class="text-gray-500">JoSAA Round 5 closing ranks for JEE Advanced qualified candidates.</span>
          </a>
          <a href="/cutoff/nits/" class="p-3 rounded-xl border border-indigo-100 bg-white hover:border-indigo-500 hover:shadow-xs transition block">
            <span class="font-bold text-indigo-950 block mb-1">NIT Cutoff 2024 (32 NITs) &rarr;</span>
            <span class="text-gray-500">Compare Home State (HS) and Other State (OS) closing ranks.</span>
          </a>
          <a href="/cutoff/iiits/" class="p-3 rounded-xl border border-indigo-100 bg-white hover:border-indigo-500 hover:shadow-xs transition block">
            <span class="font-bold text-indigo-950 block mb-1">IIIT Cutoff 2024 (26 IIITs) &rarr;</span>
            <span class="text-gray-500">Explore closing ranks for CSE, IT, and AI specializations.</span>
          </a>
          <a href="/cutoff/gftis/" class="p-3 rounded-xl border border-indigo-100 bg-white hover:border-indigo-500 hover:shadow-xs transition block">
            <span class="font-bold text-indigo-950 block mb-1">GFTI Cutoff 2024 &rarr;</span>
            <span class="text-gray-500">Closing ranks for PEC Chandigarh, BIT Mesra, JNU, and more.</span>
          </a>
          <a href="/cutoff/computer-science/" class="p-3 rounded-xl border border-indigo-100 bg-white hover:border-indigo-500 hover:shadow-xs transition block">
            <span class="font-bold text-indigo-950 block mb-1">Computer Science (CSE) Cutoffs &rarr;</span>
            <span class="text-gray-500">Nationwide comparison of CSE opening and closing ranks.</span>
          </a>
          <a href="/jee-advanced-rank-college-predictor/" class="p-3 rounded-xl border border-indigo-100 bg-white hover:border-indigo-500 hover:shadow-xs transition block">
            <span class="font-bold text-indigo-950 block mb-1">JEE Advanced IIT Predictor &rarr;</span>
            <span class="text-gray-500">Predict safe and reach IIT programs based on your rank.</span>
          </a>
        </div>
      </div>

      <h2 class="text-xl font-bold text-gray-900 pt-4">
        Browse Institute-Specific Cutoff Pages
      </h2>
      <p class="text-xs text-gray-600 mb-4">
        Direct links to branch-wise opening and closing ranks for all participating institutes:
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2 text-xs">
        {collegesData.map((c) => (
          <a
            href={`/cutoff/${c.slug}/`}
            class="p-2 rounded border border-gray-200 bg-white hover:border-indigo-400 hover:text-indigo-600 truncate transition-colors"
            title={`${c.short_name || c.name} Cutoff 2024`}
          >
            {c.short_name || c.name} Cutoffs →
          </a>
        ))}
      </div>

      <h2 class="text-xl font-bold text-gray-900 pt-4">
        Frequently Asked Questions
      </h2>
      <div class="space-y-4">
        <details class="p-4 rounded-xl border border-gray-200 bg-white" open>
          <summary class="font-bold text-gray-900 cursor-pointer">
            Which round cutoffs are displayed in the JoSAA Cutoff Explorer?
          </summary>
          <p class="mt-2 text-xs text-gray-600 leading-relaxed">
            The Cutoff Explorer displays official Round 5 (final seat allocation round) closing ranks published by the Joint Seat Allocation Authority (JoSAA) for the 2024 academic cycle.
          </p>
        </details>
        <details class="p-4 rounded-xl border border-gray-200 bg-white">
          <summary class="font-bold text-gray-900 cursor-pointer">
            What is the difference between Home State (HS) and Other State (OS) quota?
          </summary>
          <p class="mt-2 text-xs text-gray-600 leading-relaxed">
            In National Institutes of Technology (NITs), 50% of seats are reserved for students whose class 12 examination state matches the institute state (Home State / HS), while the remaining 50% are open to candidates across India (Other State / OS).
          </p>
        </details>
        <details class="p-4 rounded-xl border border-gray-200 bg-white">
          <summary class="font-bold text-gray-900 cursor-pointer">
            Does JoSAA use category rank or All India Rank for IIT admissions?
          </summary>
          <p class="mt-2 text-xs text-gray-600 leading-relaxed">
            For reserved categories (EWS, OBC-NCL, SC, ST), JoSAA cutoffs in category seats are published as Category Ranks in the respective category merit list, not common All India CRL ranks.
          </p>
        </details>
      </div>
    </section>
  </div>
</CollegeLayout>
