---
import CollegeLayout from '../../../layouts/CollegeLayout.astro';
import SourceBox from '../../../components/colleges/SourceBox.astro';
import collegesData from '@/data/colleges.json';
import fs from 'node:fs';
import path from 'node:path';

const iitColleges = collegesData.filter((c) => c.type === 'IIT');

const cutoffsPath = path.resolve(process.cwd(), 'public/data/cutoffs/2024-all.json');
const allCutoffs: any[] = fs.existsSync(cutoffsPath) ? JSON.parse(fs.readFileSync(cutoffsPath, 'utf-8')) : [];

// Map CSE cutoff for each IIT
const cseCutoffMap = new Map<string, { opening: number; closing: number }>();
for (const row of allCutoffs) {
  const [slug, program, quota, seatType, gender, round, opening, closing] = row;
  if (program === 'cse' && seatType === 'OPEN' && gender === 'Gender-Neutral') {
    cseCutoffMap.set(slug, { opening, closing });
  }
}

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://convert.gudmud.site/' },
    { '@type': 'ListItem', position: 2, name: 'Colleges', item: 'https://convert.gudmud.site/colleges/' },
    { '@type': 'ListItem', position: 3, name: 'Cutoff Explorer', item: 'https://convert.gudmud.site/cutoff/' },
    { '@type': 'ListItem', position: 4, name: 'IIT Cutoff 2024', item: 'https://convert.gudmud.site/cutoff/iits/' },
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What rank is needed for Computer Science (CSE) in top IITs?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'In JoSAA Round 5 for the OPEN Gender-Neutral category, CSE at IIT Bombay closed at rank 68, IIT Delhi at 116, IIT Madras at 159, and IIT Kanpur at 252. Candidates generally require an All India Rank (AIR) within the top 300 in JEE Advanced for old IIT CSE.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which IIT has the highest closing rank for B.Tech programs?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Newer third-generation IITs such as IIT Bhilai, IIT Jammu, and IIT Dharwad offer admission opportunities in core and interdisciplinary engineering branches up to ranks 12,000–16,000 in the OPEN category.',
      },
    },
  ],
};
---

<CollegeLayout
  title="IIT Cutoff 2024: JoSAA Closing Ranks for 23 IITs | Gudmud"
  description="Explore official JoSAA 2024 Round 5 cutoffs across all 23 IITs. Compare Computer Science, Electrical, and Mechanical closing ranks for General, OBC, SC, and ST."
  canonical="https://convert.gudmud.site/cutoff/iits/"
  jsonLd={[breadcrumbJsonLd, faqJsonLd]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-gray-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <a href="/colleges/" class="hover:underline">Colleges</a>
      <span>/</span>
      <a href="/cutoff/" class="hover:underline">Cutoffs</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">IIT Cutoff 2024</span>
    </nav>

    <!-- Header Section -->
    <header class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200 mb-3">
        Official JoSAA Round 5 Data
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-3">
        IIT Cutoff 2024: JoSAA Opening and Closing Ranks
      </h1>
      <p class="text-base text-gray-600 max-w-3xl leading-relaxed">
        Complete verified closing ranks across all 23 Indian Institutes of Technology (IITs). Based on official Joint Seat Allocation Authority (JoSAA) seat allocation results for JEE Advanced qualified candidates.
      </p>
    </header>

    <!-- CTA to IIT Rank Predictor -->
    <div class="mb-8 bg-indigo-50 border border-indigo-200 rounded-xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-sm font-bold text-indigo-950 mb-1">Check Your IIT Admission Chances by Rank</h2>
        <p class="text-xs text-indigo-800">Enter your JEE Advanced All India Rank or Category Rank to see safe, moderate, and reach IIT programs.</p>
      </div>
      <a
        href="/jee-advanced-rank-college-predictor/"
        class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-indigo-600 text-white text-xs font-semibold hover:bg-indigo-700 transition shrink-0"
      >
        Open IIT Rank Predictor &rarr;
      </a>
    </div>

    <!-- Table of all 23 IITs -->
    <section class="bg-white rounded-xl border border-gray-200 shadow-2xs overflow-hidden mb-12">
      <div class="p-5 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-base font-bold text-gray-900">
          All 23 Indian Institutes of Technology (JoSAA Cutoff Directory)
        </h2>
        <span class="text-xs text-gray-500">23 Institutes</span>
      </div>
      <div class="overflow-x-auto text-xs">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-gray-200 bg-gray-50 text-gray-700">
              <th class="py-3 px-4 font-semibold">Institute Name</th>
              <th class="py-3 px-4 font-semibold">Location</th>
              <th class="py-3 px-4 font-semibold">NIRF '24</th>
              <th class="py-3 px-4 font-semibold">CSE Opening Rank</th>
              <th class="py-3 px-4 font-semibold">CSE Closing Rank</th>
              <th class="py-3 px-4 font-semibold text-right">Cutoff Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {iitColleges.map((iit) => {
              const nirfEng = iit.nirf?.find((n) => n.category === 'Engineering' && n.year === 2024);
              const cse = cseCutoffMap.get(iit.slug);
              return (
                <tr class="hover:bg-gray-50/80 transition">
                  <td class="py-3 px-4 font-medium text-gray-900">
                    <a href={`/colleges/${iit.slug}/`} class="hover:underline text-indigo-600 font-semibold">
                      {iit.name}
                    </a>
                  </td>
                  <td class="py-3 px-4 text-gray-600">
                    {iit.city}, {iit.state}
                  </td>
                  <td class="py-3 px-4">
                    {nirfEng ? (
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-2xs font-semibold bg-green-50 text-green-700 border border-green-200">
                        #{nirfEng.rank}
                      </span>
                    ) : (
                      <span class="text-gray-400">&mdash;</span>
                    )}
                  </td>
                  <td class="py-3 px-4 text-gray-700">
                    {cse?.opening ? cse.opening.toLocaleString('en-IN') : '&mdash;'}
                  </td>
                  <td class="py-3 px-4 font-semibold text-gray-900">
                    {cse?.closing ? cse.closing.toLocaleString('en-IN') : '&mdash;'}
                  </td>
                  <td class="py-3 px-4 text-right">
                    <a
                      href={`/cutoff/${iit.slug}/`}
                      class="inline-flex items-center gap-1 font-semibold text-indigo-600 hover:text-indigo-800"
                    >
                      View All Branches &rarr;
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Editorial & Analysis Guide -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
      <div class="lg:col-span-2 space-y-6">
        <section class="bg-white rounded-xl border border-gray-200 p-6 shadow-2xs">
          <h2 class="text-lg font-bold text-gray-900 mb-3">
            Understanding IIT Cutoff Trends Across Generations
          </h2>
          <div class="space-y-4 text-sm text-gray-600 leading-relaxed">
            <p>
              Admission cutoffs in Indian Institutes of Technology are characterized by generational tiers determined by institutional age, research funding, alumni networks, and campus placements:
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li>
                <strong>First-Generation IITs (Old 7):</strong> Founded between 1951 and 2001 (IIT Kharagpur, Bombay, Madras, Kanpur, Delhi, Guwahati, Roorkee). These institutes command the highest opening and closing ranks nationwide, with Computer Science closing within rank 450.
              </li>
              <li>
                <strong>Second-Generation IITs (2008–2009):</strong> Institutes like <a href="/colleges/iit-hyderabad/" class="text-indigo-600 underline">IIT Hyderabad</a>, <a href="/colleges/iit-indore/" class="text-indigo-600 underline">IIT Indore</a>, <a href="/colleges/iit-bhanas-bhu-varanasi/" class="text-indigo-600 underline">IIT (BHU) Varanasi</a>, and <a href="/colleges/iit-gandhinagar/" class="text-indigo-600 underline">IIT Gandhinagar</a> have established world-class research infrastructure and top-20 NIRF rankings, with CSE closing between ranks 600 and 1,600.
              </li>
              <li>
                <strong>Third-Generation IITs (2015–2016):</strong> Established in Goa, Dharwad, Bhilai, Jammu, Tirupati, and Palakkad. These colleges offer premier IIT faculty and degree credentials with accessible closing ranks ranging from 4,000 to 15,000+.
              </li>
            </ul>
            <p>
              Compare full cutoff rankings with our interactive <a href="/cutoff/" class="text-indigo-600 underline">JoSAA Cutoff Explorer</a> or explore <a href="/cutoff/computer-science/" class="text-indigo-600 underline">Computer Science Cutoffs nationwide</a>.
            </p>
          </div>
        </section>

        <!-- Other Category Cutoff Hubs -->
        <section class="bg-white rounded-xl border border-gray-200 p-6 shadow-2xs">
          <h2 class="text-lg font-bold text-gray-900 mb-3">
            Explore Cutoffs for Other JoSAA Institutes
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
            <a href="/cutoff/nits/" class="p-4 rounded-lg border border-gray-200 hover:border-indigo-400 hover:shadow-xs transition block">
              <span class="font-bold text-gray-900 block mb-1">NIT Cutoff 2024</span>
              <span class="text-gray-500">Closing ranks for all 32 NITs with HS & OS quota rules.</span>
            </a>
            <a href="/cutoff/iiits/" class="p-4 rounded-lg border border-gray-200 hover:border-indigo-400 hover:shadow-xs transition block">
              <span class="font-bold text-gray-900 block mb-1">IIIT Cutoff 2024</span>
              <span class="text-gray-500">Closing ranks for 26 IIITs covering CSE and IT disciplines.</span>
            </a>
            <a href="/cutoff/gftis/" class="p-4 rounded-lg border border-gray-200 hover:border-indigo-400 hover:shadow-xs transition block">
              <span class="font-bold text-gray-900 block mb-1">GFTI Cutoff 2024</span>
              <span class="text-gray-500">Closing ranks for central government technical institutes.</span>
            </a>
          </div>
        </section>
      </div>

      <!-- Provenance Sidebar -->
      <div class="space-y-6">
        <SourceBox
          sourceName="Joint Seat Allocation Authority (JoSAA)"
          sourceUrl="https://josaa.nic.in"
          sourceYear="2024 Cycle"
          verifiedAt="15 Nov 2026"
          methodologyNote="Compiled from official Round 5 seat allocation archives. Only All India (AI) quota applies to IITs."
        />

        <div class="bg-white rounded-xl border border-gray-200 p-5 text-xs text-gray-600 space-y-3">
          <h3 class="font-bold text-gray-900 text-sm">Essential Counselling Resources</h3>
          <ul class="space-y-2">
            <li><a href="/guides/how-josaa-counselling-works/" class="text-indigo-600 hover:underline">How JoSAA Counselling Works &rarr;</a></li>
            <li><a href="/guides/josaa-rounds-and-seat-types-explained/" class="text-indigo-600 hover:underline">Seat Types & Freeze/Float Guide &rarr;</a></li>
            <li><a href="/nirf-ranking/engineering/" class="text-indigo-600 hover:underline">NIRF Engineering Rankings 2024 &rarr;</a></li>
            <li><a href="/official-links/" class="text-indigo-600 hover:underline">Official JoSAA & NTA Portals &rarr;</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</CollegeLayout>
