---
import CollegeLayout from '../../../layouts/CollegeLayout.astro';
import SourceBox from '../../../components/colleges/SourceBox.astro';
import collegesData from '@/data/colleges.json';
import fs from 'node:fs';
import path from 'node:path';

const cutoffsPath = path.resolve(process.cwd(), 'public/data/cutoffs/2024-all.json');
const allCutoffs: any[] = fs.existsSync(cutoffsPath) ? JSON.parse(fs.readFileSync(cutoffsPath, 'utf-8')) : [];

const collegeMap = new Map<string, any>();
for (const c of collegesData) {
  collegeMap.set(c.slug, c);
}

// Filter all CSE rows (Round 5, OPEN, Gender-Neutral)
const cseRows: {
  college: any;
  quota: string;
  opening: number;
  closing: number;
}[] = [];

for (const row of allCutoffs) {
  const [slug, program, quota, seatType, gender, round, opening, closing] = row;
  if (program === 'cse' && seatType === 'OPEN' && gender === 'Gender-Neutral') {
    const college = collegeMap.get(slug);
    if (college) {
      cseRows.push({ college, quota, opening, closing });
    }
  }
}

// Sort by closing rank
cseRows.sort((a, b) => a.closing - b.closing);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://convert.gudmud.site/' },
    { '@type': 'ListItem', position: 2, name: 'Colleges', item: 'https://convert.gudmud.site/colleges/' },
    { '@type': 'ListItem', position: 3, name: 'Cutoff Explorer', item: 'https://convert.gudmud.site/cutoff/' },
    { '@type': 'ListItem', position: 4, name: 'Computer Science Cutoffs', item: 'https://convert.gudmud.site/cutoff/computer-science/' },
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What was the closing rank for Computer Science at IIT Bombay in 2024?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'In JoSAA 2024 Round 5, Computer Science and Engineering (4 Years B.Tech) at IIT Bombay closed at All India Rank (AIR) 68 for OPEN Gender-Neutral candidates.',
      },
    },
    {
      '@type': 'Question',
      name: 'What rank in JEE Main is required for CSE in top NITs?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For Other State (OS) candidates in the OPEN category, CSE at NIT Trichy closed at 1,506, NIT Surathkal at 2,355, and NIT Warangal at 2,780. An AIR within the top 3,000 is generally necessary.',
      },
    },
  ],
};
---

<CollegeLayout
  title="CSE Cutoff 2024: IITs, NITs & IIITs Closing Ranks | Gudmud"
  description="Compare JoSAA 2024 Computer Science Engineering (CSE) opening and closing ranks across IITs, NITs, and IIITs. Official Round 5 B.Tech cutoffs with rank bands."
  canonical="https://convert.gudmud.site/cutoff/computer-science/"
  jsonLd={[breadcrumbJsonLd, faqJsonLd]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-gray-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <a href="/colleges/" class="hover:underline">Colleges</a>
      <span>/</span>
      <a href="/cutoff/" class="hover:underline">Cutoffs</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">CSE Cutoffs 2024</span>
    </nav>

    <!-- Header Section -->
    <header class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200 mb-3">
        Official JoSAA Round 5 Cutoffs
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-3">
        Computer Science (CSE) Cutoff 2024: IITs, NITs & IIITs
      </h1>
      <p class="text-base text-gray-600 max-w-3xl leading-relaxed">
        Comparative analysis of Computer Science and Engineering opening and closing ranks across India's premier government technical institutes. Sourced from official JoSAA Round 5 allocations for OPEN category candidates.
      </p>
    </header>

    <!-- Predictor CTA -->
    <div class="mb-8 bg-indigo-50 border border-indigo-200 rounded-xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-sm font-bold text-indigo-950 mb-1">Check Your Admission Likelihood for CSE</h2>
        <p class="text-xs text-indigo-800">Enter your rank into our deterministic predictor to calculate your safe, moderate, and reach CSE institutes.</p>
      </div>
      <div class="flex gap-2 shrink-0">
        <a
          href="/jee-main-rank-college-predictor/"
          class="inline-flex items-center justify-center px-3 py-2 rounded-lg bg-indigo-600 text-white text-xs font-semibold hover:bg-indigo-700 transition"
        >
          JEE Main Predictor &rarr;
        </a>
        <a
          href="/jee-advanced-rank-college-predictor/"
          class="inline-flex items-center justify-center px-3 py-2 rounded-lg bg-indigo-950 text-white text-xs font-semibold hover:bg-black transition"
        >
          IIT Predictor &rarr;
        </a>
      </div>
    </div>

    <!-- Master CSE Comparison Table -->
    <section class="bg-white rounded-xl border border-gray-200 shadow-2xs overflow-hidden mb-12">
      <div class="p-5 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-base font-bold text-gray-900">
          Computer Science & Engineering Closing Rank Hierarchy
        </h2>
        <span class="text-xs text-gray-500">{cseRows.length} Programs Listed</span>
      </div>
      <div class="overflow-x-auto text-xs">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-gray-200 bg-gray-50 text-gray-700">
              <th class="py-2.5 px-3 font-semibold">Institute</th>
              <th class="py-2.5 px-2 font-semibold">Type</th>
              <th class="py-2.5 px-2 font-semibold">Quota</th>
              <th class="py-2.5 px-3 font-semibold">Opening</th>
              <th class="py-2.5 px-3 font-semibold">Closing</th>
              <th class="py-2.5 px-3 font-semibold text-right">Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {cseRows.map((row) => (
              <tr class="hover:bg-gray-50 transition">
                <td class="py-2 px-3 font-medium text-gray-900">
                  <a href={`/colleges/${row.college.slug}/`} class="hover:underline text-indigo-600 font-semibold">
                    {row.college.short_name || row.college.name}
                  </a>
                </td>
                <td class="py-2 px-2">
                  <span class="px-1.5 py-0.5 rounded text-2xs font-semibold bg-gray-100 text-gray-700">
                    {row.college.type}
                  </span>
                </td>
                <td class="py-2 px-2 font-mono text-gray-600">
                  {row.quota}
                </td>
                <td class="py-2 px-3 text-gray-700">
                  {row.opening.toLocaleString('en-IN')}
                </td>
                <td class="py-2 px-3 font-bold text-gray-900">
                  {row.closing.toLocaleString('en-IN')}
                </td>
                <td class="py-2 px-3 text-right">
                  <a
                    href={`/cutoff/${row.college.slug}/`}
                    class="font-semibold text-indigo-600 hover:text-indigo-800"
                  >
                    Cutoffs &rarr;
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Editorial & Analysis Guide -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
      <div class="lg:col-span-2 space-y-6">
        <section class="bg-white rounded-xl border border-gray-200 p-6 shadow-2xs">
          <h2 class="text-lg font-bold text-gray-900 mb-3">
            Computer Science Cutoff Tiers: What Ranks Are Required?
          </h2>
          <div class="space-y-4 text-sm text-gray-600 leading-relaxed">
            <p>
              Computer Science and Engineering (CSE) remains the most sought-after undergraduate program in India, accounting for the sharpest cutoffs across all counseling rounds:
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li>
                <strong>Premier IIT Tier (Ranks 1–300 in JEE Advanced):</strong> Led by <a href="/colleges/iit-bombay/" class="text-indigo-600 underline">IIT Bombay</a> (closing rank 68), <a href="/colleges/iit-delhi/" class="text-indigo-600 underline">IIT Delhi</a> (116), <a href="/colleges/iit-madras/" class="text-indigo-600 underline">IIT Madras</a> (159), and <a href="/colleges/iit-kanpur/" class="text-indigo-600 underline">IIT Kanpur</a> (252).
              </li>
              <li>
                <strong>Mid & Gen-2 IITs (Ranks 300–2,500 in JEE Advanced):</strong> Includes <a href="/colleges/iit-kharagpur/" class="text-indigo-600 underline">IIT Kharagpur</a>, IIT Roorkee, IIT Guwahati, IIT Hyderabad, and IIT Indore.
              </li>
              <li>
                <strong>Top NIT Tier (Ranks 1,000–4,000 in JEE Main):</strong> Spearheaded by <a href="/colleges/nit-trichy/" class="text-indigo-600 underline">NIT Trichy</a> (closing rank 1,506), <a href="/colleges/nit-surathkal/" class="text-indigo-600 underline">NIT Surathkal</a> (2,355), <a href="/colleges/nit-warangal/" class="text-indigo-600 underline">NIT Warangal</a> (2,780), and <a href="/colleges/nit-rourkela/" class="text-indigo-600 underline">NIT Rourkela</a> (3,755).
              </li>
              <li>
                <strong>Premier IIITs (Ranks 3,000–12,000 in JEE Main):</strong> Includes <a href="/colleges/iiit-allahabad/" class="text-indigo-600 underline">IIIT Allahabad</a>, IIITM Gwalior, and IIIT Lucknow.
              </li>
            </ul>
            <p>
              Explore cutoffs by specific institute categories: <a href="/cutoff/iits/" class="text-indigo-600 underline">IIT Cutoffs</a>, <a href="/cutoff/nits/" class="text-indigo-600 underline">NIT Cutoffs</a>, <a href="/cutoff/iiits/" class="text-indigo-600 underline">IIIT Cutoffs</a>, or explore the <a href="/nirf-ranking/engineering/" class="text-indigo-600 underline">NIRF Engineering Rankings</a>.
            </p>
          </div>
        </section>
      </div>

      <!-- Provenance Sidebar -->
      <div class="space-y-6">
        <SourceBox
          sourceName="Joint Seat Allocation Authority (JoSAA)"
          sourceUrl="https://josaa.nic.in"
          sourceYear="2024 Cycle"
          verifiedAt="15 Nov 2026"
          methodologyNote="Compiled from official Round 5 seat allocation archives. Only OPEN category Gender-Neutral seats are shown in the primary comparison table."
        />

        <div class="bg-white rounded-xl border border-gray-200 p-5 text-xs text-gray-600 space-y-3">
          <h3 class="font-bold text-gray-900 text-sm">Counselling Help</h3>
          <ul class="space-y-2">
            <li><a href="/guides/how-josaa-counselling-works/" class="text-indigo-600 hover:underline">How JoSAA Counselling Works &rarr;</a></li>
            <li><a href="/guides/josaa-rounds-and-seat-types-explained/" class="text-indigo-600 hover:underline">Seat Types & Freeze/Float Guide &rarr;</a></li>
            <li><a href="/cutoff/" class="text-indigo-600 hover:underline">Full JoSAA Cutoff Explorer &rarr;</a></li>
            <li><a href="/official-links/" class="text-indigo-600 hover:underline">Official JoSAA Portal &rarr;</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</CollegeLayout>
