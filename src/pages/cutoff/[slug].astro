---
import CollegeLayout from '../../layouts/CollegeLayout.astro';
import SourceBox from '../../components/colleges/SourceBox.astro';
import collegesData from '@/data/colleges.json';
import programsData from '@/data/programs.json';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  return collegesData.map((college) => ({
    params: { slug: college.slug },
    props: { college },
  }));
}

const { college } = Astro.props;

// Load cutoffs
const cutoffsPath = path.resolve(process.cwd(), 'public/data/cutoffs/2024-all.json');
let allCutoffs: any[] = [];
if (fs.existsSync(cutoffsPath)) {
  try {
    allCutoffs = JSON.parse(fs.readFileSync(cutoffsPath, 'utf-8'));
  } catch (e) {
    allCutoffs = [];
  }
}

// Filter cutoffs for this college: [slug, program_code, quota, seat_type, gender, round, opening_rank, closing_rank]
const collegeCutoffs = allCutoffs.filter((row) => row[0] === college.slug);

// Program name lookup
const programMap = new Map<string, string>();
for (const p of programsData) {
  programMap.set(p.code, p.name);
}

const displayName = college.short_name || college.name;

// Title & Meta formatting strictly <= 60 chars and 120-158 chars
let title = `${displayName} Cutoff 2024: Opening & Closing Ranks`;
if (title.length > 60) {
  title = `${displayName}: JoSAA Cutoffs 2024`;
}
if (title.length > 60) {
  title = `${displayName.slice(0, 30)} Cutoff 2024`;
}

let description = `Official JoSAA 2024 opening and closing ranks for ${displayName} (${college.city}, ${college.state}). View branch-wise cutoffs for General, OBC, SC, ST, and EWS.`;
if (description.length > 158) {
  description = description.slice(0, 155) + '...';
} else if (description.length < 120) {
  description = `${description} Verified from Joint Seat Allocation Authority.`;
}

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://convert.gudmud.site/' },
    { '@type': 'ListItem', position: 2, name: 'Cutoffs', item: 'https://convert.gudmud.site/cutoff/' },
    { '@type': 'ListItem', position: 3, name: `${displayName} Cutoff`, item: `https://convert.gudmud.site/cutoff/${college.slug}/` },
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `What is the closing rank for Computer Science at ${displayName}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `In JoSAA 2024 Round 5, the closing rank for Computer Science at ${displayName} was determined by seat pool and quota categories as listed in the verified official table below.`,
      },
    },
    {
      '@type': 'Question',
      name: `Which exam is required for admission to ${displayName}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: college.type === 'IIT'
          ? `Admission to ${displayName} requires qualifying JEE Advanced followed by JoSAA online counselling.`
          : `Admission to ${displayName} requires qualifying JEE Main with seat allocation through JoSAA / CSAB counselling.`,
      },
    },
  ],
};
---

<CollegeLayout
  title={title}
  description={description}
  canonical={`https://convert.gudmud.site/cutoff/${college.slug}/`}
  jsonLd={[breadcrumbJsonLd, faqJsonLd]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-gray-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <a href="/cutoff/" class="hover:underline">Cutoffs</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">{displayName} Cutoff</span>
    </nav>

    <!-- Header Section -->
    <header class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200 mb-3">
        <span>Official JoSAA 2024 Round 5</span>
        <span>•</span>
        <span>{college.type} Admissions</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-3">
        {displayName} Cutoff 2024: JoSAA Opening & Closing Ranks
      </h1>
      <p class="text-sm sm:text-base text-gray-600 max-w-3xl leading-relaxed">
        Review verified Round 5 cutoffs for {college.name} located in {college.city}, {college.state}. Cutoffs are published directly from the Joint Seat Allocation Authority (JoSAA) official seat allocation data.
      </p>
    </header>

    <!-- Navigation Hub Banner -->
    <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs">
      <div class="flex items-center gap-2 text-gray-700">
        <span class="font-bold">Institute Status:</span>
        <span>{college.type}</span>
        <span class="text-gray-300">•</span>
        <span class="font-bold">City:</span>
        <span>{college.city}, {college.state}</span>
      </div>
      <div class="flex items-center gap-3">
        <a href={`/colleges/${college.slug}/`} class="text-indigo-600 hover:underline font-semibold">
          View College Profile →
        </a>
        <a href={college.official_url} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:underline">
          Official Site ↗
        </a>
      </div>
    </div>

    <!-- Cutoffs Table -->
    <section class="mb-10 bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
        <div>
          <h2 class="text-base font-bold text-gray-900">Branch-Wise Opening and Closing Ranks (Round 5)</h2>
          <p class="text-xs text-gray-500">Official data verified from josaa.nic.in</p>
        </div>
        <div class="text-xs font-semibold text-gray-600">
          Showing {collegeCutoffs.length} Course Allocations
        </div>
      </div>

      {collegeCutoffs.length > 0 ? (
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-gray-100 border-b border-gray-200 text-xs font-semibold text-gray-600 uppercase tracking-wider">
                <th class="px-4 py-3">Academic Program</th>
                <th class="px-4 py-3 text-center">Quota</th>
                <th class="px-4 py-3 text-center">Seat Category</th>
                <th class="px-4 py-3 text-center">Gender Pool</th>
                <th class="px-4 py-3 text-right">Opening Rank</th>
                <th class="px-4 py-3 text-right">Closing Rank</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              {collegeCutoffs.map((row) => (
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3.5 font-medium text-gray-900">
                    {programMap.get(row[1]) || row[1]}
                  </td>
                  <td class="px-4 py-3.5 text-center">
                    <span class="px-2 py-0.5 rounded text-xs font-semibold bg-gray-100 text-gray-700">
                      {row[2]}
                    </span>
                  </td>
                  <td class="px-4 py-3.5 text-center text-xs font-semibold text-gray-700">
                    {row[3]}
                  </td>
                  <td class="px-4 py-3.5 text-center text-xs text-gray-600">
                    {row[4]}
                  </td>
                  <td class="px-4 py-3.5 text-right font-mono text-gray-700">
                    {row[6]}
                  </td>
                  <td class="px-4 py-3.5 text-right font-mono font-bold text-indigo-700">
                    {row[7]}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="p-8 text-center text-gray-500 text-sm">
          No cutoff rows recorded in the initial seed dataset for this institute.
          <div class="mt-3">
            <a href="/cutoff/" class="text-indigo-600 hover:underline font-semibold">
              Browse the JoSAA Cutoff Explorer across all 116 institutes →
            </a>
          </div>
        </div>
      )}
    </section>

    <!-- Understanding Cutoff Dynamics for this Institute -->
    <section class="mb-10 bg-gray-50 border border-gray-200 rounded-xl p-6 space-y-4 text-xs sm:text-sm text-gray-700 leading-relaxed">
      <h2 class="text-base sm:text-lg font-bold text-gray-900">
        How to Analyze {displayName} Admission Cutoffs
      </h2>
      <p>
        Admission to undergraduate B.Tech programs at {college.name} is governed strictly by competitive merit ranks through the Joint Seat Allocation Authority (JoSAA). Key parameters affecting cutoff movements include:
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-4">
        <div class="p-4 bg-white border border-gray-200 rounded-lg">
          <h3 class="font-bold text-gray-900 mb-1">Quota Categorization</h3>
          <p class="text-xs text-gray-600">
            {college.type === 'IIT'
              ? 'All seats in IITs belong to the All India (AI) pool, open equally to candidates across all states without regional quotas.'
              : 'NITs allocate 50% of seats under Home State (HS) reservation and 50% under Other State (OS) quota, leading to substantial cutoff divergence.'}
          </p>
        </div>
        <div class="p-4 bg-white border border-gray-200 rounded-lg">
          <h3 class="font-bold text-gray-900 mb-1">Category Ranks vs CRL</h3>
          <p class="text-xs text-gray-600">
            Published cutoffs for GEN-EWS, OBC-NCL, SC, and ST represent candidate category ranks, whereas OPEN category seats reflect All India CRL ranks.
          </p>
        </div>
        <div class="p-4 bg-white border border-gray-200 rounded-lg">
          <h3 class="font-bold text-gray-900 mb-1">Seat Pool Allocation</h3>
          <p class="text-xs text-gray-600">
            Female candidates compete concurrently in gender-neutral pools and dedicated female supernumerary pools configured to maintain institutional gender diversity.
          </p>
        </div>
      </div>
      <p>
        If your rank is close to the past closing rank, consider using the <em>Float</em> or <em>Slide</em> option during earlier rounds, or participate in the post-JoSAA <a href="/official-links/" class="text-indigo-600 underline font-semibold">CSAB special rounds</a>.
      </p>
    </section>

    <!-- Predictor CTA -->
    <section class="bg-gradient-to-r from-indigo-50 via-purple-50 to-blue-50 border border-indigo-200 rounded-xl p-6 mb-10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h3 class="text-base font-bold text-gray-900 mb-1">Looking to predict your admission chances?</h3>
        <p class="text-xs text-gray-600">
          Enter your JEE Main rank, reservation category, and state quota to see Safe, Moderate, and Reach college options.
        </p>
      </div>
      <a
        href="/jee-main-rank-college-predictor/"
        class="whitespace-nowrap px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-bold shadow-sm"
      >
        Try College Predictor →
      </a>
    </section>

    <!-- Source Box -->
    <SourceBox
      sourceName="Joint Seat Allocation Authority (JoSAA)"
      sourceUrl="https://josaa.nic.in"
      sourceYear={2024}
      verifiedAt="2026-11-15"
      methodologyNote="Cutoffs represent Round 5 final seat allocation closing ranks published by JoSAA for the 2024 counselling session. All category seats report category-specific merit ranks, while OPEN seats report Common Rank List (CRL) All India Ranks."
    />
  </div>
</CollegeLayout>
