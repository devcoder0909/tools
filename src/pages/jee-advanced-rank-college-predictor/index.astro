---
import CollegeLayout from '../../layouts/CollegeLayout.astro';
import SourceBox from '../../components/colleges/SourceBox.astro';
import RankPredictorShell from '../../components/colleges/RankPredictorShell';

const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'JEE Advanced Rank College Predictor',
  url: 'https://convert.gudmud.site/jee-advanced-rank-college-predictor/',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires JavaScript',
  description: 'Predict IIT admission chances across all 23 Indian Institutes of Technology based on official JoSAA Round 5 closing ranks.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://convert.gudmud.site/' },
    { '@type': 'ListItem', position: 2, name: 'Colleges', item: 'https://convert.gudmud.site/colleges/' },
    { '@type': 'ListItem', position: 3, name: 'IIT Predictor', item: 'https://convert.gudmud.site/jee-advanced-rank-college-predictor/' },
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How does the JEE Advanced College Predictor estimate IIT admissions?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The tool compares your entered All India Rank (AIR) or Category Rank against the verified Round 5 closing ranks published by JoSAA for all 23 IITs, categorizing allocations into Safe (+15% cushion), Moderate (within ±15%), and Reach (-15% stretch).',
      },
    },
    {
      '@type': 'Question',
      name: 'Should I enter Common Rank List (CRL) or Category Rank for reserved seats?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For General / OPEN category seats, enter your CRL rank. If selecting OBC-NCL, EWS, SC, or ST categories in the predictor, enter your specific Category Rank, as JoSAA publishes category seat cutoffs in category rank units.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is there a Home State quota in IITs?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Unlike NITs which reserve 50% seats under Home State quota, 100% of seats in Indian Institutes of Technology (IITs) are allocated under the All India (AI) quota strictly on merit.',
      },
    },
  ],
};
---

<CollegeLayout
  title="JEE Advanced College Predictor 2024: IITs | Gudmud"
  description="Predict your IIT admission chances using your JEE Advanced rank and official JoSAA closing ranks. View safe, moderate, and reach branch allocations across IITs."
  canonical="https://convert.gudmud.site/jee-advanced-rank-college-predictor/"
  jsonLd={[webAppJsonLd, breadcrumbJsonLd, faqJsonLd]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Breadcrumb trail -->
    <nav class="flex items-center gap-2 text-xs text-gray-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <a href="/colleges/" class="hover:underline">Colleges</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">JEE Advanced Predictor</span>
    </nav>

    <!-- Header Section (Keywords H1) -->
    <header class="mb-6">
      <h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-3">
        JEE Advanced Rank College Predictor
      </h1>
      <p class="text-base text-gray-600 max-w-3xl leading-relaxed">
        Estimate your admission likelihood across all 23 Indian Institutes of Technology (IITs). Evaluates verified JoSAA Round 5 closing ranks with transparent Safe, Moderate, and Reach probability bands.
      </p>
    </header>

    <!-- Interactive Predictor Island -->
    <div class="mb-12">
      <RankPredictorShell
        client:load
        defaultExam="JEE Advanced"
        defaultRank="2500"
        defaultQuota="AI"
      />
    </div>

    <!-- Related Predictor Links -->
    <div class="mb-12 bg-indigo-50 border border-indigo-200 rounded-xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h3 class="text-sm font-bold text-indigo-950 mb-1">Looking for NITs, IIITs & GFTIs instead?</h3>
        <p class="text-xs text-indigo-800">Use your JEE Main All India Rank (AIR) with Home State and Other State quota rules on our dedicated JEE Main predictor.</p>
      </div>
      <a
        href="/jee-main-rank-college-predictor/"
        class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-indigo-600 text-white text-xs font-semibold hover:bg-indigo-700 transition shrink-0"
      >
        Open JEE Main Predictor &rarr;
      </a>
    </div>

    <!-- Sourced Methodology and Guide Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
      <div class="lg:col-span-2 space-y-6">
        <section class="bg-white rounded-xl border border-gray-200 p-6 shadow-2xs">
          <h2 class="text-lg font-bold text-gray-900 mb-3">
            How IIT Seat Allocation Works in JoSAA
          </h2>
          <div class="space-y-4 text-sm text-gray-600 leading-relaxed">
            <p>
              Admissions to undergraduate engineering (B.Tech, B.S., and Dual Degree programs) across all 23 Indian Institutes of Technology are administered solely through the Joint Seat Allocation Authority (<a href="https://josaa.nic.in" target="_blank" rel="noopener noreferrer" class="text-indigo-600 underline">JoSAA</a>) based strictly on JEE Advanced ranks. Unlike state universities and National Institutes of Technology, IITs operate exclusively on an <strong>All India (AI) quota</strong> with zero domicile-based reservation.
            </p>
            <p>
              Key admission rules verified for the 2024–2025 academic session:
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li>
                <strong>Common Rank List (CRL) vs Category Ranks:</strong> Candidates in reserved categories (EWS, OBC-NCL, SC, ST, PwD) are allocated OPEN category seats first if their CRL qualifies. Otherwise, they are allocated within their dedicated category quota using their specific Category Rank.
              </li>
              <li>
                <strong>Female Supernumerary Quota:</strong> To achieve at least 20% female representation, supernumerary seats are created. Female candidates are automatically evaluated for both Gender-Neutral and Female-Only seat pools.
              </li>
              <li>
                <strong>Architecture Programs (AAT):</strong> Admission to B.Arch at <a href="/colleges/iit-kharagpur/" class="text-indigo-600 underline">IIT Kharagpur</a>, <a href="/colleges/iit-roorkee/" class="text-indigo-600 underline">IIT Roorkee</a>, and <a href="/colleges/iit-bhanas-bhu-varanasi/" class="text-indigo-600 underline">IIT BHU</a> requires qualifying the Architecture Aptitude Test (AAT) post-JEE Advanced.
              </li>
            </ul>
          </div>
        </section>

        <section class="bg-white rounded-xl border border-gray-200 p-6 shadow-2xs">
          <h2 class="text-lg font-bold text-gray-900 mb-3">
            Top IIT Computer Science & Core Branch Benchmarks
          </h2>
          <p class="text-sm text-gray-600 mb-4">
            Recent Round 5 OPEN Gender-Neutral closing rank benchmarks for reference across top tier IITs:
          </p>
          <div class="overflow-x-auto text-xs">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b border-gray-200 bg-gray-50 text-gray-700">
                  <th class="py-2.5 px-3 font-semibold">Institute</th>
                  <th class="py-2.5 px-3 font-semibold">Computer Science (CSE)</th>
                  <th class="py-2.5 px-3 font-semibold">Electrical (EE)</th>
                  <th class="py-2.5 px-3 font-semibold">Mechanical (ME)</th>
                  <th class="py-2.5 px-3 font-semibold text-right">Cutoff Profile</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <tr>
                  <td class="py-2 px-3 font-medium text-gray-900"><a href="/colleges/iit-bombay/" class="hover:underline text-indigo-600">IIT Bombay</a></td>
                  <td class="py-2 px-3">68</td>
                  <td class="py-2 px-3">450</td>
                  <td class="py-2 px-3">1,680</td>
                  <td class="py-2 px-3 text-right"><a href="/cutoff/iit-bombay/" class="text-indigo-600 underline">View Cutoff &rarr;</a></td>
                </tr>
                <tr>
                  <td class="py-2 px-3 font-medium text-gray-900"><a href="/colleges/iit-delhi/" class="hover:underline text-indigo-600">IIT Delhi</a></td>
                  <td class="py-2 px-3">116</td>
                  <td class="py-2 px-3">580</td>
                  <td class="py-2 px-3">1,750</td>
                  <td class="py-2 px-3 text-right"><a href="/cutoff/iit-delhi/" class="text-indigo-600 underline">View Cutoff &rarr;</a></td>
                </tr>
                <tr>
                  <td class="py-2 px-3 font-medium text-gray-900"><a href="/colleges/iit-madras/" class="hover:underline text-indigo-600">IIT Madras</a></td>
                  <td class="py-2 px-3">159</td>
                  <td class="py-2 px-3">850</td>
                  <td class="py-2 px-3">2,450</td>
                  <td class="py-2 px-3 text-right"><a href="/cutoff/iit-madras/" class="text-indigo-600 underline">View Cutoff &rarr;</a></td>
                </tr>
                <tr>
                  <td class="py-2 px-3 font-medium text-gray-900"><a href="/colleges/iit-kanpur/" class="hover:underline text-indigo-600">IIT Kanpur</a></td>
                  <td class="py-2 px-3">252</td>
                  <td class="py-2 px-3">1,280</td>
                  <td class="py-2 px-3">3,100</td>
                  <td class="py-2 px-3 text-right"><a href="/cutoff/iit-kanpur/" class="text-indigo-600 underline">View Cutoff &rarr;</a></td>
                </tr>
                <tr>
                  <td class="py-2 px-3 font-medium text-gray-900"><a href="/colleges/iit-kharagpur/" class="hover:underline text-indigo-600">IIT Kharagpur</a></td>
                  <td class="py-2 px-3">414</td>
                  <td class="py-2 px-3">1,780</td>
                  <td class="py-2 px-3">3,850</td>
                  <td class="py-2 px-3 text-right"><a href="/cutoff/iit-kharagpur/" class="text-indigo-600 underline">View Cutoff &rarr;</a></td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="text-xs text-gray-500 mt-4">
            For complete closing ranks across all 23 IITs and multiple branches, see our comprehensive <a href="/cutoff/iits/" class="text-indigo-600 underline">IIT Cutoff 2024 Guide</a>.
          </p>
        </section>

        <!-- FAQs Section -->
        <section class="bg-white rounded-xl border border-gray-200 p-6 shadow-2xs">
          <h2 class="text-lg font-bold text-gray-900 mb-4">Frequently Asked Questions (IIT Predictor)</h2>
          <div class="space-y-4 text-sm">
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">What rank margin defines Safe, Moderate, and Reach bands?</h3>
              <p class="text-gray-600 text-xs leading-relaxed">
                A program is considered <strong>Safe</strong> if the historical closing rank is at least 15% higher than your rank (e.g. for rank 2,000, programs closing at 2,300+). It is <strong>Moderate</strong> if closing rank is within ±15% of your rank. It is a <strong>Reach</strong> program if the past closing rank was up to 15% stricter than your rank.
              </p>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Can I get an IIT with a 10,000 rank in JEE Advanced?</h3>
              <p class="text-gray-600 text-xs leading-relaxed">
                Yes. While top tier IIT CSE closes under 300, core branches (Civil, Chemical, Metallurgical, Mining, Biological Engineering) at newer IITs such as IIT Jammu, IIT Dharwad, IIT Palakkad, and IIT Bhilai routinely close between 9,000 and 15,000 for OPEN category.
              </p>
            </div>
          </div>
        </section>
      </div>

      <!-- Sidebar Metadata & Official Provenance -->
      <div class="space-y-6">
        <SourceBox
          sourceName="Joint Seat Allocation Authority (JoSAA)"
          sourceUrl="https://josaa.nic.in"
          sourceYear="2024 Cycle"
          verifiedAt="15 Nov 2026"
          methodologyNote="Predictions are calculated client-side using deterministic ±15% rank intervals against verified JoSAA Round 5 closing ranks. Past year trends are indicators, not guarantees."
        />

        <div class="bg-white rounded-xl border border-gray-200 p-5 text-xs text-gray-600 space-y-3">
          <h3 class="font-bold text-gray-900 text-sm">Counselling Next Steps</h3>
          <p>Read our step-by-step guides before locking choices on the JoSAA portal:</p>
          <ul class="space-y-2">
            <li><a href="/guides/how-josaa-counselling-works/" class="text-indigo-600 hover:underline">How JoSAA Counselling Works &rarr;</a></li>
            <li><a href="/guides/josaa-rounds-and-seat-types-explained/" class="text-indigo-600 hover:underline">Freeze, Float & Slide Options Explained &rarr;</a></li>
            <li><a href="/cutoff/" class="text-indigo-600 hover:underline">Official Cutoff Explorer &rarr;</a></li>
            <li><a href="/nirf-ranking/engineering/" class="text-indigo-600 hover:underline">NIRF Engineering Rankings 2024 &rarr;</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</CollegeLayout>
