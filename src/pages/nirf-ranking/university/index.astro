---
import CollegeLayout from '../../../layouts/CollegeLayout.astro';
import SourceBox from '../../../components/colleges/SourceBox.astro';
import nirfData from '@/data/nirf.json';
import collegesData from '@/data/colleges.json';

const year = 2024;
const category = 'University';

// Filter 2024 University rankings
const currentRankings = nirfData.filter((r) => r.category === category && r.year === year);

// Map college info
const collegeMap = new Map<string, any>();
for (const c of collegesData) {
  collegeMap.set(c.slug, c);
}

const enrichedRankings = currentRankings.map((item) => ({
  ...item,
  college: collegeMap.get(item.slug),
}));

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Best Universities in India: NIRF University ${year}`,
  description: `Official Ministry of Education NIRF University Rankings ${year} for research and central universities.`,
  numberOfItems: enrichedRankings.length,
  itemListElement: enrichedRankings.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    url: `https://convert.gudmud.site/colleges/${item.slug}/`,
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://convert.gudmud.site/' },
    { '@type': 'ListItem', position: 2, name: 'Colleges', item: 'https://convert.gudmud.site/colleges/' },
    { '@type': 'ListItem', position: 3, name: 'NIRF Rankings', item: 'https://convert.gudmud.site/nirf-ranking/' },
    { '@type': 'ListItem', position: 4, name: 'University 2024', item: 'https://convert.gudmud.site/nirf-ranking/university/' },
  ],
};
---

<CollegeLayout
  title="NIRF University Ranking 2024: Top Universities | Gudmud"
  description="Official NIRF 2024 University rankings from the Ministry of Education. Compare top research universities and central universities across India."
  canonical="https://convert.gudmud.site/nirf-ranking/university/"
  jsonLd={[itemListJsonLd, breadcrumbJsonLd]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-gray-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <a href="/colleges/" class="hover:underline">Colleges</a>
      <span>/</span>
      <a href="/nirf-ranking/" class="hover:underline">NIRF Rankings</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">University {year}</span>
    </nav>

    <!-- Header Section -->
    <header class="mb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200 mb-3">
        <span>Ministry of Education Official Report</span>
        <span>•</span>
        <span>Research & Multi-Discipline Universities</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-3">
        NIRF University Ranking 2024: Top Indian Universities
      </h1>
      <p class="text-sm sm:text-base text-gray-600 max-w-3xl leading-relaxed">
        Discover top central, state, and deemed research universities in India based on official NIRF 2024 parameters including research publications, intellectual property, graduation rate, and academic peer perception.
      </p>
    </header>

    <!-- Category Switcher Pill Bar -->
    <div class="flex items-center gap-2 mb-8 overflow-x-auto pb-2 text-xs">
      <span class="text-gray-400 font-medium whitespace-nowrap">Categories:</span>
      <a
        href="/nirf-ranking/engineering/"
        class="px-3 py-1.5 rounded-full font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 whitespace-nowrap"
      >
        Engineering
      </a>
      <a
        href="/nirf-ranking/overall/"
        class="px-3 py-1.5 rounded-full font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 whitespace-nowrap"
      >
        Overall
      </a>
      <a
        href="/nirf-ranking/university/"
        class="px-3 py-1.5 rounded-full font-semibold bg-amber-600 text-white shadow-sm whitespace-nowrap"
      >
        University
      </a>
    </div>

    <!-- Rankings Table -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden mb-12">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
          <h2 class="text-base font-bold text-gray-900">National Institutional Ranking Framework (NIRF) 2024</h2>
          <p class="text-xs text-gray-500">Official data verified from nirfindia.org • Ministry of Education</p>
        </div>
        <div class="text-xs font-semibold text-gray-600">
          Showing {enrichedRankings.length} Universities
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-gray-100 border-b border-gray-200 text-xs font-semibold text-gray-600 uppercase tracking-wider">
              <th class="px-4 py-3 text-center w-16">NIRF Rank</th>
              <th class="px-4 py-3">University Name</th>
              <th class="px-4 py-3">Location</th>
              <th class="px-4 py-3 text-right">NIRF Score</th>
              <th class="px-4 py-3 text-center">Profile & Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            {enrichedRankings.map((item) => (
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-4 py-3.5 text-center font-bold text-gray-900">
                  <span class={`inline-flex items-center justify-center w-8 h-8 rounded-full text-xs font-extrabold ${item.rank <= 3 ? 'bg-amber-100 text-amber-900 border border-amber-300' : 'bg-gray-100 text-gray-700'}`}>
                    #{item.rank}
                  </span>
                </td>
                <td class="px-4 py-3.5">
                  <div class="font-bold text-gray-900">
                    <a href={`/colleges/${item.slug}/`} class="hover:text-amber-700 hover:underline">
                      {item.name}
                    </a>
                  </div>
                  <div class="text-xs text-gray-500 mt-0.5 flex items-center gap-2">
                    <span class="inline-block px-1.5 py-0.5 rounded bg-gray-100 text-gray-600 font-medium">
                      University
                    </span>
                    <a
                      href={item.official_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-amber-600 hover:underline"
                    >
                      Official Portal ↗
                    </a>
                  </div>
                </td>
                <td class="px-4 py-3.5 text-xs text-gray-600">
                  {item.city}, {item.state}
                </td>
                <td class="px-4 py-3.5 text-right font-mono font-semibold text-gray-900">
                  {item.score.toFixed(2)}
                </td>
                <td class="px-4 py-3.5 text-center">
                  <a
                    href={`/colleges/${item.slug}/`}
                    class="inline-block px-3 py-1 bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 rounded text-xs font-semibold"
                  >
                    View Profile →
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- University Evaluation Parameters Context -->
    <section class="my-10 bg-gray-50 border border-gray-200 rounded-xl p-6 space-y-4 text-xs sm:text-sm text-gray-700 leading-relaxed">
      <h2 class="text-base sm:text-lg font-bold text-gray-900">
        How Indian Universities Are Benchmarked in NIRF
      </h2>
      <p>
        The University category in NIRF specifically evaluates multi-faculty institutions offering comprehensive undergraduate, postgraduate, and doctoral degrees. Unlike standalone engineering or medical colleges, universities are assessed on interdisciplinary breadth and scholarly impact:
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-4">
        <div class="p-4 bg-white border border-gray-200 rounded-lg">
          <h3 class="font-bold text-gray-900 mb-1">Doctoral & Research Output</h3>
          <p class="text-xs text-gray-600">
            Measures the number of full-time PhD scholars graduated annually and indexed publications across Web of Science and Scopus databases.
          </p>
        </div>
        <div class="p-4 bg-white border border-gray-200 rounded-lg">
          <h3 class="font-bold text-gray-900 mb-1">Faculty Academic Credentials</h3>
          <p class="text-xs text-gray-600">
            Evaluates the proportion of permanent faculty holding doctoral qualifications, patent filings, and sponsored consultancy earnings.
          </p>
        </div>
        <div class="p-4 bg-white border border-gray-200 rounded-lg">
          <h3 class="font-bold text-gray-900 mb-1">Gender & Regional Diversity</h3>
          <p class="text-xs text-gray-600">
            Accounts for student enrollment from other states and countries, female student representation, and campus accessibility facilities.
          </p>
        </div>
      </div>
      <p>
        To verify whether an institution holds statutory degree-granting status, refer to our comprehensive guide on <a href="/guides/how-to-check-if-university-is-ugc-recognised/" class="text-amber-700 underline font-semibold">how to check UGC recognition</a>.
      </p>
    </section>

    <!-- Official Provenance Box -->
    <SourceBox
      sourceName="National Institutional Ranking Framework (NIRF) Universities"
      sourceUrl="https://www.nirfindia.org"
      sourceYear={year}
      verifiedAt="2026-11-15"
      methodologyNote="NIRF University rankings evaluate institutions on research citations per faculty member, doctoral student graduation rate, gender diversity, and peer survey ratings."
    />
  </div>
</CollegeLayout>
