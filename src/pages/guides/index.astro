---
import CollegeLayout from '../../layouts/CollegeLayout.astro';
import SourceBox from '../../components/colleges/SourceBox.astro';

const guides = [
  {
    slug: 'how-to-read-nirf-rankings',
    title: 'How to Read NIRF Rankings: Complete Guide',
    description: 'Learn how to read and interpret NIRF rankings. Understand the 5 weighted parameters—TLR, RPC, GO, OI, and PR—and spot misleading ranking traps.',
    category: 'Rankings & Analysis',
    readingTime: '6 min read',
  },
  {
    slug: 'how-josaa-counselling-works',
    title: 'How JoSAA Counselling Works: Step-by-Step Guide',
    description: 'Complete step-by-step guide to JoSAA counselling. Learn about online registration, choice filling strategies, seat acceptance fees, and verification.',
    category: 'Admissions & Counselling',
    readingTime: '8 min read',
  },
  {
    slug: 'josaa-rounds-and-seat-types-explained',
    title: 'JoSAA Seat Types & Freeze, Float, Slide Explained',
    description: 'Understand Freeze, Float, and Slide options in JoSAA. Detailed breakdown of HS vs OS quota, category ranks vs CRL, and reporting rules.',
    category: 'Admissions & Counselling',
    readingTime: '7 min read',
  },
  {
    slug: 'nirf-vs-naac-vs-nba',
    title: 'NIRF vs NAAC vs NBA: Key Differences Explained',
    description: 'Compare NIRF rankings, NAAC institutional accreditation, and NBA program accreditation. Learn what each score measures before choosing a college.',
    category: 'Accreditation',
    readingTime: '5 min read',
  },
  {
    slug: 'how-to-check-if-university-is-ugc-recognised',
    title: 'How to Check UGC Recognition of Universities',
    description: 'Learn how to verify if a university is recognized by the UGC. Step-by-step guide to checking official recognition lists, Section 2(f), and 12(B) status.',
    category: 'Regulatory Verification',
    readingTime: '5 min read',
  },
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://convert.gudmud.site/' },
    { '@type': 'ListItem', position: 2, name: 'Colleges', item: 'https://convert.gudmud.site/colleges/' },
    { '@type': 'ListItem', position: 3, name: 'Guides', item: 'https://convert.gudmud.site/guides/' },
  ],
};
---

<CollegeLayout
  title="Engineering Counselling Guides: JoSAA & NIRF | Gudmud"
  description="Comprehensive, original guides on JoSAA counselling, NIRF ranking methodology, seat allocation rounds, and UGC recognition for engineering aspirants."
  canonical="https://convert.gudmud.site/guides/"
  jsonLd={[breadcrumbJsonLd]}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-gray-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <a href="/colleges/" class="hover:underline">Colleges</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">Guides</span>
    </nav>

    <!-- Header Section -->
    <header class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200 mb-3">
        <span>Original Educational Resources</span>
        <span>•</span>
        <span>Zero Sponsored Placements</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-3">
        Engineering Admission & Counselling Guides
      </h1>
      <p class="text-sm sm:text-base text-gray-600 max-w-3xl leading-relaxed">
        Objective, data-backed guides designed to help engineering aspirants and parents navigate JoSAA choice filling, understand ranking methodologies, and avoid fraudulent educational institutes.
      </p>
    </header>

    <!-- Guides List -->
    <div class="space-y-4 mb-12">
      {guides.map((g, idx) => (
        <a
          href={`/guides/${g.slug}/`}
          class="block bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:border-indigo-400 hover:shadow-md transition-all group"
        >
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="px-2.5 py-0.5 rounded text-[11px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-100">
              {g.category}
            </span>
            <span class="text-xs text-gray-400">{g.readingTime}</span>
          </div>
          <h2 class="text-lg sm:text-xl font-bold text-gray-900 group-hover:text-indigo-600 transition-colors mb-2">
            {g.title}
          </h2>
          <p class="text-sm text-gray-600 mb-3 leading-relaxed">
            {g.description}
          </p>
          <span class="inline-flex items-center text-xs font-bold text-indigo-600 group-hover:translate-x-1 transition-transform">
            Read Full Guide →
          </span>
        </a>
      ))}
    </div>

    <!-- Official SourceBox -->
    <SourceBox
      sourceName="Official MoE, JoSAA & UGC Regulations"
      sourceUrl="https://www.education.gov.in"
      sourceYear={2024}
      verifiedAt="2026-11-15"
      methodologyNote="All guides are researched and authored strictly against gazette notifications, published NIRF metrics, and official JoSAA Business Rules. No private commercial interests or coaching endorsements."
    />
  </div>
</CollegeLayout>
