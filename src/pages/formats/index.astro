---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getAllFormats } from '../../registry';
import { siteConfig } from '../../config/site';

const formats = getAllFormats();

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Formats', href: '/formats/' },
];
---

<Layout
  title={`File Formats Guide & Technical Specs | ${siteConfig.brand}`}
  description="Comprehensive directory of image and document file formats: JPG, PNG, WebP, HEIC, AVIF, and PDF with technical specs, compression benchmarks, and tools."
  canonical={`${siteConfig.url}/formats/`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-2">
        Image & Document File Formats Guide
      </h1>
      <p class="text-gray-600">
        In-depth technical specifications, compression comparisons, and browser compatibility facts for modern image and document file formats.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {formats.map((fmt) => (
        <a
          href={`/formats/${fmt.id}/`}
          class="p-6 rounded-2xl border border-slate-200 bg-white hover:border-emerald-500 hover:shadow-xs transition duration-200 group flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="font-mono font-bold text-xl text-emerald-700">
                {fmt.extension.toUpperCase()}
              </span>
              <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 uppercase">
                {fmt.category}
              </span>
            </div>
            <h2 class="font-bold text-gray-900 group-hover:text-emerald-600 text-lg mb-2 transition-colors">
              {fmt.name}
            </h2>
            <p class="text-xs text-gray-500 leading-relaxed mb-4">
              {fmt.description}
            </p>
          </div>
          <div class="text-xs text-gray-400 space-x-2 pt-3 border-t border-gray-100">
            <span>{fmt.lossy ? 'Lossy' : 'Lossless'}</span>
            <span>•</span>
            <span>{fmt.transparency ? 'Alpha Transparency' : 'No Transparency'}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
