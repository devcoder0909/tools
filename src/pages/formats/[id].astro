---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import { getAllFormats, getToolsForFormat, formatDisplayDate, formatIsoDate, type FormatDefinition } from '../../registry';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const formats = getAllFormats();
  return formats.map((format) => ({
    params: { id: format.id },
    props: { format },
  }));
}

export interface Props {
  format: FormatDefinition;
}

const { format } = Astro.props;
const tools = getToolsForFormat(format.id);
const isIndexable = !!format.indexable;

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Formats', href: '/formats/' },
  { name: format.name, href: `/formats/${format.id}/` },
];

const formatJsonLd: any[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: `${format.name} File Format Guide`,
    description: format.description,
    url: `${siteConfig.url}/formats/${format.id}/`,
    inLanguage: 'en-US',
    datePublished: formatIsoDate(format.last_reviewed),
    dateModified: formatIsoDate(format.last_reviewed),
    publisher: {
      '@type': 'Organization',
      name: siteConfig.brand,
      url: siteConfig.url,
      logo: `${siteConfig.url}/images/brand/logo.png`,
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `${siteConfig.url}/formats/${format.id}/`,
    },
  },
];

if (format.faq && format.faq.length > 0) {
  formatJsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: format.faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  });
}
---

<Layout
  title={format.title}
  description={format.description}
  canonical={`${siteConfig.url}/formats/${format.id}/`}
  jsonLd={formatJsonLd}
  noindex={!isIndexable}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <article class="format-guide">
      <div class="mb-8">
        <div class="flex items-center space-x-3 mb-2">
          <span class="font-mono text-2xl font-extrabold text-emerald-700">
            {format.extension.toUpperCase()}
          </span>
          <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 uppercase">
            {format.category}
          </span>
        </div>
        <h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 mb-3">
          {format.name} ({format.id.toUpperCase()} File) Format Guide
        </h1>
        <p class="text-base text-gray-600 leading-relaxed">
          {format.description} Learn how the {format.id.toUpperCase()} file format operates, its technical compression parameters, and how to convert {format.id.toUpperCase()} files in your browser.
        </p>
      </div>

      <!-- Format Architectural Diagram -->
      <figure class="my-6 p-5 rounded-2xl bg-white border border-slate-200 shadow-2xs text-center">
        <img
          src="/images/tools/png-vs-jpg-comparison.svg"
          alt={`${format.id.toUpperCase()} File Format Structure & Specification Diagram`}
          width="720"
          height="360"
          class="max-w-full h-auto mx-auto rounded-xl"
          loading="lazy"
        />
        <figcaption class="mt-2.5 text-xs text-slate-500 font-medium">
          <strong>Architecture Diagram:</strong> {format.name} ({format.id.toUpperCase()} File) structural encoding matrix and browser compatibility standards.
        </figcaption>
      </figure>

      <!-- Technical Specs Table -->
      <div class="my-8 bg-white border border-slate-200 rounded-2xl p-6 shadow-2xs">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Technical Characteristics</h2>
        <dl class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm">
          <div>
            <dt class="text-xs text-gray-500 uppercase">MIME Type</dt>
            <dd class="font-mono font-semibold text-gray-800 mt-1">{format.mime}</dd>
          </div>
          <div>
            <dt class="text-xs text-gray-500 uppercase">Compression</dt>
            <dd class="font-semibold text-gray-800 mt-1">{format.lossy ? 'Lossy' : 'Lossless'}</dd>
          </div>
          <div>
            <dt class="text-xs text-gray-500 uppercase">Transparency</dt>
            <dd class="font-semibold text-gray-800 mt-1">{format.transparency ? 'Supported' : 'No'}</dd>
          </div>
          <div>
            <dt class="text-xs text-gray-500 uppercase">Animation</dt>
            <dd class="font-semibold text-gray-800 mt-1">{format.animation ? 'Supported' : 'No'}</dd>
          </div>
        </dl>
      </div>

      <!-- Deep Guide Content -->
      {format.content && (
        <div class="prose prose-gray max-w-none my-8 leading-relaxed space-y-6 text-gray-700 [&>h2]:text-2xl [&>h2]:font-bold [&>h2]:text-gray-900 [&>h2]:mt-8 [&>h2]:mb-4 [&>h3]:text-lg [&>h3]:font-semibold [&>h3]:text-gray-900 [&>h3]:mt-6 [&>h3]:mb-2 [&>ul]:list-disc [&>ul]:pl-5 [&>ol]:list-decimal [&>ol]:pl-5 [&>p]:mb-4"
          set:html={format.content
            .replace(/### (.*)/g, '<h3>$1</h3>')
            .replace(/## (.*)/g, '<h2>$1</h2>')
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .replace(/`([^`]+)`/g, '<code>$1</code>')
            .replace(/\n\n/g, '<p></p>')}
        />
      )}

      <!-- Converters Involving this Format -->
      <section class="my-10 border-t border-gray-200 pt-8" aria-labelledby="tools-heading">
        <h2 id="tools-heading" class="text-2xl font-bold text-gray-900 mb-6">
          Online Converters for {format.name}
        </h2>
        {tools.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {tools.map((t) => (
              <a
                href={`/${t.slug}/`}
                class="p-4 sm:p-5 rounded-2xl border border-slate-200 bg-white hover:border-emerald-500 hover:shadow-xs transition duration-200 group"
              >
                <h3 class="font-semibold text-gray-900 group-hover:text-emerald-600 mb-1 transition-colors">
                  {t.name}
                </h3>
                <p class="text-xs text-gray-500 line-clamp-2 leading-relaxed">
                  {t.description}
                </p>
              </a>
            ))}
          </div>
        ) : (
          <p class="text-sm text-gray-500">
            More converters for {format.name} are added regularly.
          </p>
        )}
      </section>

      <!-- FAQ Section -->
      {format.faq && format.faq.length > 0 && (
        <FAQ items={format.faq} title={`${format.name} Frequently Asked Questions`} />
      )}
    </article>

    <!-- Privacy Callout -->
    <div class="my-8 p-4 bg-white border border-slate-200 rounded-2xl text-xs text-slate-600 flex flex-col sm:flex-row sm:items-center justify-between gap-2 shadow-2xs">
      <div>
        <span class="font-bold text-slate-800">Zero-Upload Privacy:</span> Format conversions run 100% locally in your web browser.
      </div>
      <a href="/privacy-explained/" class="text-emerald-700 font-semibold underline hover:text-emerald-800">
        How our zero-upload privacy works &rarr;
      </a>
    </div>

    <!-- Reviewer & Date -->
    <div class="mt-12 pt-6 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between text-xs text-gray-500 gap-2">
      <span>
        Last reviewed: <time datetime={formatIsoDate(format.last_reviewed)}>{formatDisplayDate(format.last_reviewed)}</time>
      </span>
      {format.reviewer && !format.reviewer.toLowerCase().includes('team') && !format.reviewer.toLowerCase().includes('converter') && (
        <span>
          Reviewed by: <strong class="text-gray-700">{format.reviewer}</strong>
        </span>
      )}
    </div>
  </div>
</Layout>
