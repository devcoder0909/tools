---
import BaseHead from '../components/BaseHead.astro';
import CollegeHeader from '../components/colleges/CollegeHeader.astro';
import CollegeFooter from '../components/colleges/CollegeFooter.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
  keywords?: string;
}

const {
  title,
  description,
  canonical,
  jsonLd,
  keywords,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full antialiased scroll-smooth">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonical={canonical}
      jsonLd={jsonLd}
      keywords={keywords}
    />
  </head>
  <body class="flex min-h-full flex-col bg-white text-gray-900 font-sans">
    <a href="#college-content" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-indigo-600 focus:text-white focus:rounded-md focus:shadow-md focus:font-semibold">
      Skip to main content
    </a>
    <CollegeHeader />
    <main id="college-content" class="flex-1" role="main">
      <slot />
    </main>
    <CollegeFooter />
  </body>
</html>
