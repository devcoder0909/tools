---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { PageSeoInput } from '../utils/seo';

export interface Props extends PageSeoInput {}

const props = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full antialiased scroll-smooth">
  <head>
    <BaseHead {...props} />
  </head>
  <body class="flex min-h-full flex-col bg-slate-50/40 text-slate-900 font-sans antialiased overflow-x-hidden selection:bg-emerald-600 selection:text-white">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-green-600 focus:text-white focus:rounded-md focus:shadow-md focus:font-semibold">
      Skip to main content
    </a>
    <Header />
    <main id="main-content" class="flex-1" role="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
