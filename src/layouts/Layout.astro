---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, any> | Record<string, any>[];
  noindex?: boolean;
  ogImage?: string;
}

const {
  title,
  description,
  canonical,
  type = 'website',
  jsonLd,
  noindex = false,
  ogImage,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full antialiased scroll-smooth">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonical={canonical}
      type={type}
      jsonLd={jsonLd}
      noindex={noindex}
      ogImage={ogImage}
    />
  </head>
  <body class="flex min-h-full flex-col bg-white text-gray-900 font-sans">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-green-600 focus:text-white focus:rounded-md focus:shadow-md focus:font-semibold">
      Skip to main content
    </a>
    <Header />
    <main id="main-content" class="flex-1" role="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
